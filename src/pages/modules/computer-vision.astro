---
import ModuleLayout from '../../layouts/ModuleLayout.astro';
import ModuleTabs from '../../components/ModuleTabs.astro';
---

<ModuleLayout
  title="Computer Vision — AI Atlas"
  pageId="cv"
  crumb="Computer Vision"
  eyebrow="Computer Vision"
  heading="Teaching machines to see"
>
  <Fragment slot="head">
<style is:global>
.cv-canvaswrap{ display:flex; gap:22px; align-items:center; flex-wrap:wrap; justify-content:center; }
  .cv-stack{ display:flex; flex-direction:column; align-items:center; gap:8px; }
  .cv-stack canvas{ border-radius:12px; border:1px solid var(--stroke); background:#0c0c16; image-rendering:pixelated; max-width:100%; }
  .cv-caplabel{ font-family:var(--mono); font-size:11px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-mute); }
  .cv-arrow{ font-family:var(--mono); font-size:26px; color:var(--indigo-lt); }
  .cv-kbtns{ display:grid; grid-template-columns:1fr 1fr; gap:8px; }
  .cv-kbtns .btn{ justify-content:center; }
  .cv-kbtns .btn.active{ background:linear-gradient(180deg,var(--indigo-lt),var(--indigo-dk)); border-color:transparent; color:#fff; }
  .cv-mat{ display:grid; grid-template-columns:repeat(3,1fr); gap:6px; max-width:220px; }
  .cv-mat span{ text-align:center; padding:8px 4px; border-radius:8px; background:var(--glass-2); border:1px solid var(--stroke); font-family:var(--mono); font-size:13px; color:var(--cyan); }
  .cv-cards{ display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:14px; margin-top:18px; }
  .cv-card{ padding:18px; border-radius:var(--r); border:1px solid var(--stroke); background:var(--glass); }
  .cv-card h4{ font-size:14px; margin-bottom:8px; }
  .cv-card p{ font-size:13px; color:var(--ink-soft); line-height:1.6; }
  .cv-tag{ display:inline-flex; align-items:center; gap:6px; font-family:var(--mono); font-size:11.5px; padding:5px 10px; border-radius:999px; background:var(--glass-2); border:1px solid var(--stroke); color:var(--ink-soft); margin:4px 4px 0 0; }
  .cv-detseg{ display:flex; gap:10px; flex-wrap:wrap; }
  .cv-detseg > div{ flex:1; min-width:160px; }
  .cv-legend{ display:flex; gap:16px; flex-wrap:wrap; margin-top:12px; font-size:12.5px; color:var(--ink-soft); }
  .cv-legend i{ display:inline-block; width:12px; height:12px; border-radius:3px; margin-right:6px; vertical-align:middle; }
  .cv-canv{ border-radius:12px; border:1px solid var(--stroke); background:#0c0c16; max-width:100%; }
  .cv-num{ font-family:var(--mono); font-size:12px; white-space:pre; color:var(--cyan); background:#0c0c16; border:1px solid var(--stroke); border-radius:10px; padding:12px 14px; overflow-x:auto; line-height:1.75; }
  .cv-two{ display:flex; gap:18px; align-items:center; justify-content:center; flex-wrap:wrap; }
  .cv-two .cv-arrow{ font-family:var(--mono); font-size:24px; color:var(--indigo-lt); }
  .arch-diagram{ display:flex; align-items:flex-end; gap:2px; flex-wrap:nowrap; overflow-x:auto; padding:22px 4px 8px; }
  .arch-col{ display:flex; flex-direction:column; align-items:center; gap:8px; flex:0 0 auto; }
  .arch-block{ background:linear-gradient(180deg,var(--cyan),#0e7490); border-radius:4px; box-shadow:0 6px 16px -8px var(--cyan); }
  .arch-meta{ display:flex; flex-direction:column; align-items:center; gap:2px; }
  .arch-name{ font-family:var(--mono); font-size:10px; color:var(--ink-soft); white-space:nowrap; }
  .arch-dim{ font-family:var(--mono); font-size:9.5px; color:var(--ink-mute); white-space:nowrap; }
  .arch-arrow{ color:var(--ink-mute); font-size:14px; flex:0 0 auto; align-self:center; padding-bottom:26px; }
</style>
  </Fragment>
  <Fragment slot="status"><span class="pill"><span class="dot cyan"></span>vision</span></Fragment>
  <Fragment slot="description">A vision model turns a grid of pixels into meaning — an edge, an object, a boundary. Slide a kernel across an image and watch a feature map appear, drag a detection box until its IoU snaps into place, then threshold an image into segmentation masks. Three lessons, each a live sandbox.</Fragment>

<ModuleTabs moduleId="cv" scrollable />

      <!-- ===================== IMAGE AS NUMBERS ===================== -->
      <div id="panel-repr">
        <p class="note" style="margin-bottom:16px;max-width:820px">Before any model touches it, an image is just a <b style="color:var(--ink)">grid of numbers</b>. A colour image is three stacked grids — one each for <b style="color:var(--rose)">red</b>, <b style="color:var(--emerald)">green</b>, <b style="color:var(--cyan)">blue</b> — every value from 0 to 255. Toggle a channel and read the raw pixel values inside the white box.</p>
        <div class="pg">
          <div class="glass" style="padding:24px;border-radius:var(--r-lg);display:flex;flex-direction:column;align-items:center;gap:14px">
            <canvas id="repr-canvas" class="cv-canv" width="300" height="300"></canvas>
            <div class="cv-num" id="repr-vals" style="align-self:stretch"></div>
          </div>
          <div class="pg-panel">
            <div class="ctrl"><h4>Channel view</h4>
              <div class="seg" id="repr-view"><button class="active" data-v="rgb">RGB</button><button data-v="r">R</button><button data-v="g">G</button><button data-v="b">B</button><button data-v="gray">Gray</button></div>
              <p class="note" style="margin-top:12px">Showing <b style="color:var(--ink)" id="repr-view-lbl">all channels</b>. The white box marks the 5×5 patch printed below — the actual numbers a network reads.</p>
            </div>
            <div class="metrics">
              <div class="metric"><div class="l">TENSOR SHAPE</div><div class="v mono" id="repr-dim" style="font-size:16px">24×24×3</div></div>
              <div class="metric"><div class="l">VALUE RANGE</div><div class="v mono" style="font-size:16px">0–255</div></div>
            </div>
          </div>
        </div>
        <div class="cv-cards">
          <div class="cv-card"><h4>Height × Width × Channels</h4><p>A 224×224 RGB image is a tensor of <b style="color:var(--ink)">224×224×3 = 150,528</b> numbers. Grayscale drops the channel axis to 1. Video adds a time axis; a batch adds one more.</p></div>
          <div class="cv-card"><h4>Normalization</h4><p>Networks train best on small, centred inputs, so pixels are usually scaled to <b style="color:var(--ink)">[0,1]</b> or standardized to mean 0, std 1 per channel before the first layer.</p></div>
          <div class="cv-card"><h4>Colour spaces</h4><p>RGB is the default, but <b style="color:var(--ink)">HSV</b>, <b style="color:var(--ink)">grayscale</b> and <b style="color:var(--ink)">LAB</b> matter too — some tasks (e.g. segmentation) are easier when brightness is separated from colour.</p></div>
        </div>
      </div>

<!-- ===================== CONVOLUTION ===================== -->
      <div id="panel-conv" style="display:none">
        <p class="note" style="margin-bottom:16px;max-width:820px">A <b style="color:var(--ink)">convolution</b> slides a small weight matrix — the <b style="color:var(--ink)">kernel</b> — across every pixel, multiplying and summing its 3×3 neighbourhood to produce one output pixel. Different kernels detect different structure: brightness, edges, texture. Pick a kernel and watch the <b style="color:var(--ink)">feature map</b> on the right change. Click any input pixel to paint it.</p>
        <div class="pg">
          <div class="glass" style="padding:24px;border-radius:var(--r-lg)">
            <div class="cv-canvaswrap">
              <div class="cv-stack">
                <canvas id="cv-in" width="270" height="270"></canvas>
                <span class="cv-caplabel">input · 9×9</span>
              </div>
              <div class="cv-arrow">→</div>
              <div class="cv-stack">
                <canvas id="cv-out" width="270" height="270"></canvas>
                <span class="cv-caplabel">feature map</span>
              </div>
            </div>
            <div class="row between center" style="margin-top:22px;flex-wrap:wrap;gap:10px">
              <h4 style="font-size:14px">Kernel matrix</h4>
              <button class="btn btn-ghost btn-sm" id="cv-math-btn">Show math</button>
            </div>
            <div class="cv-mat" id="cv-mat" style="margin-top:12px"></div>
            <div class="eqn" id="cv-math" style="margin-top:14px;display:none"></div>
          </div>
          <div class="pg-panel">
            <div class="ctrl"><h4>Choose a kernel</h4>
              <div class="cv-kbtns" id="cv-kbtns">
                <button class="btn btn-ghost btn-sm active" data-k="identity">Identity</button>
                <button class="btn btn-ghost btn-sm" data-k="edge">Edge detect</button>
                <button class="btn btn-ghost btn-sm" data-k="sharpen">Sharpen</button>
                <button class="btn btn-ghost btn-sm" data-k="blur">Blur</button>
                <button class="btn btn-ghost btn-sm" data-k="emboss">Emboss</button>
                <button class="btn btn-ghost btn-sm" data-k="sobelx">Sobel-X</button>
              </div>
              <div style="margin-top:12px"><button class="btn btn-ghost btn-sm" id="cv-reset" style="width:100%;justify-content:center">Reset image</button></div>
            </div>
            <div class="metrics">
              <div class="metric"><div class="l">KERNEL SUM</div><div class="v mono" id="cv-ksum">1</div></div>
              <div class="metric"><div class="l">BIAS</div><div class="v mono" id="cv-kbias">0</div></div>
            </div>
            <div class="ctrl"><h4>What just happened</h4>
              <p class="note" id="cv-explain">The identity kernel copies the image straight through — its centre weight is 1 and everything else is 0.</p>
            </div>
          </div>
        </div>

        <div class="cv-cards">
          <div class="cv-card"><h4>Kernels &amp; feature maps</h4><p>One kernel produces one <b style="color:var(--ink)">feature map</b>. A conv layer learns dozens of kernels in parallel, each firing on a different pattern — early layers find edges and colour blobs, deeper layers compose them into textures, parts, then whole objects.</p></div>
          <div class="cv-card"><h4>Stride &amp; padding</h4><p><b style="color:var(--ink)">Stride</b> is how far the kernel jumps each step; stride 2 halves the output size. <b style="color:var(--ink)">Padding</b> rings the input with zeros (or edge values) so output can keep the input's size — this demo uses edge padding at the borders.</p></div>
          <div class="cv-card"><h4>Pooling &amp; receptive field</h4><p><b style="color:var(--ink)">Max/avg pooling</b> downsamples, adding translation tolerance. Stacking convs grows the <b style="color:var(--ink)">receptive field</b> — a deep neuron "sees" a large patch of the original image even though each kernel is tiny.</p></div>
          <div class="cv-card"><h4>Weight sharing</h4><p>The same kernel weights are reused at every position. That's <b style="color:var(--ink)">translation equivariance</b> — an edge is an edge anywhere — and it slashes parameters versus a dense layer, the key idea that makes CNNs trainable on images.</p></div>
          <div class="cv-card"><h4>CNN architectures</h4><p><b style="color:var(--ink)">LeNet-5</b> (1998) read digits; <b style="color:var(--ink)">AlexNet</b> (2012) won ImageNet and lit the deep-learning era; <b style="color:var(--ink)">VGG</b> stacked 3×3 convs; <b style="color:var(--ink)">ResNet</b> added skip connections to train 100+ layers; <b style="color:var(--ink)">EfficientNet</b> scaled depth/width/resolution together.</p></div>
          <div class="cv-card"><h4>Transfer learning</h4><p>A network pretrained on millions of ImageNet images already knows generic edges and textures. <b style="color:var(--ink)">Freeze</b> those layers, swap the final head, and <b style="color:var(--ink)">fine-tune</b> on your small dataset — state-of-the-art results with a fraction of the data and compute.</p></div>
        </div>
      </div>

      <!-- ===================== DETECTION ===================== -->
      <div id="panel-detect" style="display:none">
        <p class="note" style="margin-bottom:16px;max-width:820px"><b style="color:var(--ink)">Object detection</b> predicts a box around each object and scores how well it matches the truth. The metric is <b style="color:var(--ink)">IoU</b> — Intersection over Union — the overlap area divided by the combined area. Drag the sliders to move and resize the <span style="color:var(--cyan)">prediction</span> until it locks onto the <span style="color:var(--emerald)">ground-truth</span> box.</p>
        <div class="pg">
          <div class="glass" style="padding:24px;border-radius:var(--r-lg);display:flex;flex-direction:column;align-items:center;justify-content:center">
            <canvas id="det" width="440" height="320" style="border-radius:12px;border:1px solid var(--stroke);background:#0c0c16;max-width:100%"></canvas>
            <div class="cv-legend">
              <span><i style="background:var(--emerald)"></i>ground truth</span>
              <span><i style="background:var(--cyan)"></i>prediction</span>
              <span><i style="background:var(--amber)"></i>intersection</span>
            </div>
          </div>
          <div class="pg-panel">
            <div class="ctrl"><h4>Prediction box</h4>
              <div class="field"><label>X <span class="val" id="det-x-v">120</span></label><input type="range" id="det-x" min="0" max="380" step="1" value="120"></div>
              <div class="field"><label>Y <span class="val" id="det-y-v">90</span></label><input type="range" id="det-y" min="0" max="260" step="1" value="90"></div>
              <div class="field"><label>Width <span class="val" id="det-w-v">150</span></label><input type="range" id="det-w" min="30" max="260" step="1" value="150"></div>
              <div class="field" style="margin-bottom:0"><label>Height <span class="val" id="det-h-v">120</span></label><input type="range" id="det-h" min="30" max="220" step="1" value="120"></div>
            </div>
            <div class="metrics">
              <div class="metric" style="text-align:center"><div class="l">IoU</div><div class="v mono" id="det-iou" style="font-size:28px;color:var(--cyan)">—</div></div>
              <div class="metric" style="text-align:center"><div class="l">MATCH @0.5</div><div class="v mono" id="det-match" style="font-size:18px">—</div></div>
            </div>
            <div class="metrics">
              <div class="metric"><div class="l">∩ AREA</div><div class="v mono" id="det-inter">—</div></div>
              <div class="metric"><div class="l">∪ AREA</div><div class="v mono" id="det-union">—</div></div>
            </div>
            <div class="ctrl"><h4>Scoring a detector</h4>
              <p class="note">A prediction counts as a <b style="color:var(--ink)">true positive</b> when IoU ≥ a threshold (often 0.5). From there: <b style="color:var(--ink)">precision</b> = TP / (TP+FP), <b style="color:var(--ink)">recall</b> = TP / (TP+FN). Sweep the confidence threshold to trace a precision–recall curve; its area is <b style="color:var(--ink)">Average Precision</b>. Mean AP over all classes is <b style="color:var(--ink)">mAP</b> — the headline COCO metric, reported as mAP@[.5:.95].</p>
            </div>
          </div>
        </div>

        <div class="cv-cards">
          <div class="cv-card"><h4>Sliding window → R-CNN</h4><p>The brute-force start: slide a classifier over every window and scale. <b style="color:var(--ink)">R-CNN</b> made it tractable by classifying ~2000 <b style="color:var(--ink)">region proposals</b> instead of every window — accurate but slow.</p></div>
          <div class="cv-card"><h4>Fast / Faster R-CNN</h4><p><b style="color:var(--ink)">Fast R-CNN</b> ran the CNN once and pooled features per region. <b style="color:var(--ink)">Faster R-CNN</b> replaced external proposals with a learned <b style="color:var(--ink)">Region Proposal Network</b>, making the whole pipeline end-to-end.</p></div>
          <div class="cv-card"><h4>One-stage: YOLO &amp; SSD</h4><p><b style="color:var(--ink)">YOLO</b> and <b style="color:var(--ink)">SSD</b> skip the proposal stage — one forward pass predicts boxes and classes on a grid. <b style="color:var(--ink)">Two-stage</b> detectors trade speed for precision; <b style="color:var(--ink)">one-stage</b> trade the reverse and run in real time.</p></div>
          <div class="cv-card"><h4>Anchors &amp; NMS</h4><p><b style="color:var(--ink)">Anchor boxes</b> are preset shapes at each grid cell; the net predicts offsets from them. Many overlapping boxes survive, so <b style="color:var(--ink)">Non-Max Suppression</b> keeps the highest-confidence box and discards its high-IoU neighbours.</p></div>
        </div>
      </div>

      <!-- ===================== SEGMENTATION ===================== -->
      <div id="panel-segment" style="display:none">
        <p class="note" style="margin-bottom:16px;max-width:820px">Detection draws boxes; <b style="color:var(--ink)">segmentation</b> labels every single pixel. The simplest version is <b style="color:var(--ink)">thresholding</b>: split an image into classes by brightness. Drag the two thresholds to carve this image into background, mid-tones and highlights — a toy stand-in for what a segmentation head learns to do per pixel.</p>
        <div class="pg">
          <div class="glass" style="padding:24px;border-radius:var(--r-lg);display:flex;flex-direction:column;align-items:center;justify-content:center">
            <canvas id="seg" width="320" height="240" style="border-radius:12px;border:1px solid var(--stroke);background:#0c0c16;max-width:100%"></canvas>
            <div class="cv-legend" id="seg-legend"></div>
          </div>
          <div class="pg-panel">
            <div class="ctrl"><h4>View</h4>
              <div class="seg" id="seg-view"><button class="active" data-v="mask">Mask</button><button data-v="orig">Original</button></div>
            </div>
            <div class="ctrl"><h4>Thresholds</h4>
              <div class="field"><label>Low → mid <span class="val" id="seg-t1-v">90</span></label><input type="range" id="seg-t1" min="10" max="240" step="1" value="90"></div>
              <div class="field" style="margin-bottom:0"><label>Mid → high <span class="val" id="seg-t2-v">170</span></label><input type="range" id="seg-t2" min="10" max="245" step="1" value="170"></div>
            </div>
            <div class="metrics">
              <div class="metric"><div class="l">BACKGROUND</div><div class="v mono" id="seg-c0" style="font-size:16px">—</div></div>
              <div class="metric"><div class="l">MID</div><div class="v mono" id="seg-c1" style="font-size:16px;color:var(--emerald)">—</div></div>
              <div class="metric"><div class="l">HIGHLIGHT</div><div class="v mono" id="seg-c2" style="font-size:16px;color:var(--amber)">—</div></div>
            </div>
            <p class="note">Real models replace this crude threshold with a learned per-pixel classifier — but the output shape is the same: a class label for every pixel.</p>
          </div>
        </div>

        <div class="cv-cards">
          <div class="cv-card"><h4>Semantic</h4><p>Every pixel gets a <b style="color:var(--ink)">class</b> — "road", "car", "sky" — but two cars of the same class merge into one blob. It answers <i>what</i>, not <i>which</i>.</p></div>
          <div class="cv-card"><h4>Instance</h4><p>Separates individual <b style="color:var(--ink)">objects</b> — car #1 vs car #2 — but usually ignores amorphous "stuff" like sky or grass. It answers <i>which</i>.</p></div>
          <div class="cv-card"><h4>Panoptic</h4><p>The unification: every pixel gets a class <em>and</em> countable "things" get instance IDs. Semantic + instance in one coherent output.</p></div>
        </div>

        <div class="glass" style="padding:24px;border-radius:var(--r-lg);margin-top:16px">
          <h3 style="font-size:16px;margin-bottom:10px">Segmentation architectures</h3>
          <p class="note" style="max-width:860px"><b style="color:var(--ink)">FCN</b> made classification networks fully convolutional to output dense maps. <b style="color:var(--ink)">U-Net</b> added an encoder–decoder with <b style="color:var(--ink)">skip connections</b> that carry fine detail across the bottleneck — dominant in medical imaging. <b style="color:var(--ink)">DeepLab</b> uses <b style="color:var(--ink)">atrous (dilated)</b> convolutions to widen the receptive field without losing resolution. <b style="color:var(--ink)">Mask R-CNN</b> extends Faster R-CNN with a mask branch for instance segmentation.</p>
          <div style="margin-top:14px">
            <span class="cv-tag">FCN</span><span class="cv-tag">U-Net</span><span class="cv-tag">DeepLab</span><span class="cv-tag">Mask R-CNN</span>
          </div>
        </div>

        <div class="glass" style="padding:24px;border-radius:var(--r-lg);margin-top:16px">
          <h3 style="font-size:16px;margin-bottom:10px">Vision Transformers &amp; beyond</h3>
          <p class="note" style="max-width:860px">The <b style="color:var(--ink)">Vision Transformer (ViT)</b> drops convolution entirely. It cuts the image into fixed <b style="color:var(--ink)">patches</b> (e.g. 16×16), flattens each into a <b style="color:var(--ink)">token</b>, adds a positional embedding, and feeds the sequence to a standard Transformer. <b style="color:var(--ink)">Self-attention</b> lets every patch attend to every other patch, giving a global receptive field from layer one — where a CNN needs depth to see globally.</p>
          <div class="eqn" style="margin-top:14px">image <span class="c">→</span> <span class="k">patchify</span> <span class="c">(16×16)</span> <span class="c">→</span> flatten <span class="c">→</span> <span class="k">+ position</span> <span class="c">→</span> tokens <span class="c">→</span> <span class="n">self-attention × L</span> <span class="c">→</span> <span class="g">class / dense head</span></div>
          <p class="note" style="max-width:860px;margin-top:14px"><b style="color:var(--ink)">DETR</b> reframes detection as set prediction: a Transformer decoder emits a fixed set of boxes with <b style="color:var(--ink)">bipartite matching</b>, removing anchors and NMS. <b style="color:var(--ink)">SAM</b> (Segment Anything) is a promptable foundation model that segments any object from a point or box click, zero-shot.</p>
          <div style="margin-top:14px">
            <span class="cv-tag">ViT</span><span class="cv-tag">DETR</span><span class="cv-tag">SAM</span><span class="cv-tag">Swin</span>
          </div>
        </div>
      </div>
      <!-- ===================== POOLING ===================== -->
      <div id="panel-pool" style="display:none">
        <p class="note" style="margin-bottom:16px;max-width:820px"><b style="color:var(--ink)">Pooling</b> shrinks a feature map by summarising each little window into one number — <b style="color:var(--ink)">max</b> keeps the strongest response, <b style="color:var(--ink)">average</b> keeps the mean. It cuts computation and adds a little <b style="color:var(--ink)">translation tolerance</b>: shift the input a pixel and the pooled output barely changes.</p>
        <div class="pg">
          <div class="glass" style="padding:24px;border-radius:var(--r-lg)">
            <div class="cv-two">
              <div style="display:flex;flex-direction:column;align-items:center;gap:8px"><canvas id="pool-in" class="cv-canv" width="256" height="256"></canvas><span class="cv-caplabel">input · 8×8</span></div>
              <div class="cv-arrow">→</div>
              <div style="display:flex;flex-direction:column;align-items:center;gap:8px"><canvas id="pool-out" class="cv-canv" width="200" height="200"></canvas><span class="cv-caplabel">pooled</span></div>
            </div>
          </div>
          <div class="pg-panel">
            <div class="ctrl"><h4>Pooling</h4>
              <div class="seg" id="pool-mode"><button class="active" data-v="max">Max</button><button data-v="avg">Average</button></div>
              <div class="field" style="margin-top:14px"><label>Window <span class="val" id="pool-size-v">2×2</span></label><input type="range" id="pool-size" min="2" max="4" step="1" value="2"></div>
              <div class="field" style="margin-bottom:0"><label>Stride <span class="val" id="pool-stride-v">2</span></label><input type="range" id="pool-stride" min="1" max="4" step="1" value="2"></div>
            </div>
            <div class="metrics">
              <div class="metric"><div class="l">OUTPUT SIZE</div><div class="v mono" id="pool-outdim" style="font-size:18px">4×4</div></div>
              <div class="metric"><div class="l">DATA CUT</div><div class="v mono" id="pool-reduce" style="font-size:18px">75%</div></div>
            </div>
            <p class="note">Output size = ⌊(N − window) / stride⌋ + 1. Stride is the bigger lever on how much the map shrinks.</p>
          </div>
        </div>
        <div class="cv-cards">
          <div class="cv-card"><h4>Why max pooling</h4><p><b style="color:var(--ink)">Max</b> pooling keeps the most salient activation in each region — "was this feature present anywhere here?" — which is exactly what a detector cares about.</p></div>
          <div class="cv-card"><h4>Strided convs</h4><p>Modern nets often replace pooling with <b style="color:var(--ink)">stride-2 convolutions</b> that downsample <i>and</i> learn — but the effect on spatial size is the same.</p></div>
          <div class="cv-card"><h4>Global pooling</h4><p><b style="color:var(--ink)">Global average pooling</b> collapses a whole map to one number per channel, replacing bulky fully-connected heads in ResNet-style networks.</p></div>
        </div>
      </div>
      <!-- ===================== AUGMENTATION ===================== -->
      <div id="panel-augment" style="display:none">
        <p class="note" style="margin-bottom:16px;max-width:820px"><b style="color:var(--ink)">Data augmentation</b> multiplies your training set for free by transforming each image — flips, rotations, brightness, crops — so the model learns that a cat is a cat whatever its pose or lighting. It is the cheapest, most reliable defence against <b style="color:var(--ink)">overfitting</b> in vision.</p>
        <div class="pg">
          <div class="glass" style="padding:24px;border-radius:var(--r-lg);display:flex;align-items:center;justify-content:center">
            <canvas id="aug-canvas" class="cv-canv" width="300" height="300"></canvas>
          </div>
          <div class="pg-panel">
            <div class="ctrl"><h4>Transforms</h4>
              <div class="row" style="gap:8px;margin-bottom:14px"><button class="btn btn-ghost btn-sm" id="aug-fliph">Flip H</button><button class="btn btn-ghost btn-sm" id="aug-flipv">Flip V</button></div>
              <div class="field"><label>Rotation <span class="val" id="aug-rot-v">0°</span></label><input type="range" id="aug-rot" min="-45" max="45" step="1" value="0"></div>
              <div class="field"><label>Brightness <span class="val" id="aug-bright-v">1.00×</span></label><input type="range" id="aug-bright" min="0.3" max="1.8" step="0.02" value="1"></div>
              <div class="field"><label>Zoom <span class="val" id="aug-zoom-v">1.00×</span></label><input type="range" id="aug-zoom" min="0.6" max="1.8" step="0.02" value="1"></div>
              <button class="btn btn-ghost btn-sm" id="aug-reset" style="width:100%;justify-content:center">Reset</button>
            </div>
            <p class="note">Each epoch, the loader applies a fresh random combination — the network almost never sees the exact same pixels twice.</p>
          </div>
        </div>
        <div class="cv-cards">
          <div class="cv-card"><h4>Label-safe only</h4><p>Augment only in ways that keep the label true. Flipping a cat is fine; flipping a <b style="color:var(--ink)">"6"</b> into a "9", or mirroring text, corrupts the label.</p></div>
          <div class="cv-card"><h4>Strong augmentation</h4><p><b style="color:var(--ink)">Cutout, Mixup, CutMix</b> and <b style="color:var(--ink)">RandAugment</b> go further — erasing patches or blending images — and underpin modern self-supervised methods.</p></div>
          <div class="cv-card"><h4>Test-time</h4><p>Averaging predictions over several augmented views of a test image (<b style="color:var(--ink)">TTA</b>) often squeezes out a little extra accuracy.</p></div>
        </div>
      </div>
      <!-- ===================== VISION TRANSFORMERS ===================== -->
      <div id="panel-vit" style="display:none">
        <p class="note" style="margin-bottom:16px;max-width:820px">The <b style="color:var(--ink)">Vision Transformer</b> drops convolution entirely. It cuts the image into fixed <b style="color:var(--ink)">patches</b>, flattens each into a vector — a <b style="color:var(--ink)">token</b> — adds a position embedding, and feeds the sequence to a plain Transformer. Change the patch size and watch the token sequence grow or shrink.</p>
        <div class="pg">
          <div class="glass" style="padding:24px;border-radius:var(--r-lg);display:flex;flex-direction:column;align-items:center;gap:16px">
            <canvas id="vit-canvas" class="cv-canv" width="260" height="260"></canvas>
            <div style="align-self:stretch"><span class="cv-caplabel">token sequence (patch → vector)</span>
              <canvas id="vit-tokens" width="360" height="64" style="width:100%;margin-top:6px"></canvas></div>
          </div>
          <div class="pg-panel">
            <div class="ctrl"><h4>Patch size</h4>
              <div class="field" style="margin-bottom:0"><label>Patch <span class="val" id="vit-patch-v">16 px</span></label><input type="range" id="vit-patch" min="8" max="32" step="8" value="16"></div>
              <p class="note" style="margin-top:12px">Smaller patches → more tokens → finer detail but quadratically more attention compute.</p>
            </div>
            <div class="metrics">
              <div class="metric"><div class="l">PATCH GRID</div><div class="v mono" id="vit-npatch" style="font-size:16px">6×6</div></div>
              <div class="metric"><div class="l">SEQUENCE</div><div class="v mono" id="vit-seqlen" style="font-size:16px">37 (+CLS)</div></div>
            </div>
            <div class="metric"><div class="l">TOKEN DIM (flattened)</div><div class="v mono" id="vit-dim" style="font-size:15px">16×16×3 = 768</div></div>
          </div>
        </div>
        <div class="cv-cards">
          <div class="cv-card"><h4>Global from layer one</h4><p>Self-attention lets every patch see every other patch immediately — a <b style="color:var(--ink)">global receptive field</b>, where a CNN needs depth to see the whole image.</p></div>
          <div class="cv-card"><h4>The CLS token</h4><p>A learned <b style="color:var(--ink)">[CLS]</b> token is prepended; its final embedding aggregates the image and feeds the classification head.</p></div>
          <div class="cv-card"><h4>Data-hungry</h4><p>ViTs lack the built-in locality bias of CNNs, so they need <b style="color:var(--ink)">huge datasets</b> or hybrids (Swin, ConvNeXt) to win on smaller ones.</p></div>
        </div>
      </div>
      <!-- ===================== CNN ARCHITECTURES ===================== -->
      <div id="panel-arch" style="display:none">
        <p class="note" style="margin-bottom:16px;max-width:820px">A CNN trades <b style="color:var(--ink)">space for depth</b>: each stage shrinks the spatial size and grows the channel count, so early layers hold many pixels of few features and late layers hold few pixels of many features. Switch architectures and watch the volume march from wide-and-shallow to narrow-and-deep.</p>
        <div class="glass" style="padding:20px 24px;border-radius:var(--r-lg)">
          <div class="row between center" style="flex-wrap:wrap;gap:10px;margin-bottom:6px">
            <h4 style="font-size:15px" id="arch-title">LeNet-5 (1998)</h4>
            <div class="seg" id="arch-model"><button class="active" data-v="lenet">LeNet</button><button data-v="alexnet">AlexNet</button><button data-v="vgg">VGG-16</button><button data-v="resnet">ResNet-50</button></div>
          </div>
          <div class="arch-diagram" id="arch-diagram"></div>
          <div class="cv-legend" style="margin-top:6px"><span>block <b style="color:var(--ink-soft)">height</b> = spatial size · block <b style="color:var(--ink-soft)">width</b> = channels (depth)</span></div>
        </div>
        <div class="metrics" style="margin-top:16px;max-width:420px">
          <div class="metric"><div class="l">STAGES</div><div class="v mono" id="arch-depth" style="font-size:16px">7 stages</div></div>
          <div class="metric"><div class="l">OUTPUTS</div><div class="v mono" id="arch-final" style="font-size:16px">10 classes</div></div>
        </div>
        <div class="cv-cards">
          <div class="cv-card"><h4>Deeper, with a trick</h4><p>Naively stacking layers stops working — gradients vanish. <b style="color:var(--ink)">ResNet</b>'s skip connections let signal bypass layers, unlocking 50, 100, 1000+ layers.</p></div>
          <div class="cv-card"><h4>Efficiency</h4><p><b style="color:var(--ink)">MobileNet</b> and <b style="color:var(--ink)">EfficientNet</b> chase accuracy-per-FLOP with depthwise-separable convs and balanced compound scaling — the backbones on your phone.</p></div>
          <div class="cv-card"><h4>The head</h4><p>After the conv stack, global pooling plus a small classifier turns the final feature volume into class scores. Swap the head to <b style="color:var(--ink)">transfer</b> to a new task.</p></div>
        </div>
      </div>

  <Fragment slot="scripts">
<script is:inline>
(function(){
  /* ================= CONVOLUTION ================= */
  const N = 9;                       // grid dimension
  const CELL = 30;                   // px per cell
  const inCv = document.getElementById('cv-in');
  const outCv = document.getElementById('cv-out');
  const ictx = inCv.getContext('2d');
  const octx = outCv.getContext('2d');

  const KERNELS = {
    identity: { m:[0,0,0, 0,1,0, 0,0,0], bias:0, label:'Identity',
      note:'The identity kernel copies the image straight through — its centre weight is 1 and everything else is 0.' },
    edge:     { m:[-1,-1,-1, -1,8,-1, -1,-1,-1], bias:0, label:'Edge detect',
      note:'This kernel sums to 0, so flat regions vanish to black; only where neighbours differ — the edges — does a strong response survive.' },
    sharpen:  { m:[0,-1,0, -1,5,-1, 0,-1,0], bias:0, label:'Sharpen',
      note:'Amplifies the centre pixel and subtracts its neighbours, exaggerating local contrast so edges pop.' },
    blur:     { m:[1/9,1/9,1/9, 1/9,1/9,1/9, 1/9,1/9,1/9], bias:0, label:'Box blur',
      note:'Averages the 3×3 neighbourhood (weights sum to 1), smoothing noise and softening detail.' },
    emboss:   { m:[-2,-1,0, -1,1,1, 0,1,2], bias:128, label:'Emboss',
      note:'A directional kernel with a +128 bias — it lights one side of each edge and shadows the other, giving a 3-D relief look.' },
    sobelx:   { m:[-1,0,1, -2,0,2, -1,0,1], bias:128, label:'Sobel-X',
      note:'The Sobel-X operator estimates the horizontal gradient — vertical edges light up, horizontal ones stay grey (bias 128).' }
  };
  let curK = 'identity';
  let img = new Float32Array(N*N);

  function seedImage(){
    for(let y=0;y<N;y++) for(let x=0;x<N;x++){
      let v = 24 + Math.round(210 * (x/(N-1)));   // horizontal gradient → vertical edges
      if(x>=3 && x<=5 && y>=3 && y<=5) v = 245;     // bright centre block
      img[y*N+x] = v;
    }
  }

  function convolve(src, kernel, bias){
    const out = new Float32Array(N*N);
    for(let y=0;y<N;y++) for(let x=0;x<N;x++){
      let sum = 0;
      for(let ky=-1;ky<=1;ky++) for(let kx=-1;kx<=1;kx++){
        const sy = Math.min(N-1, Math.max(0, y+ky));   // edge padding
        const sx = Math.min(N-1, Math.max(0, x+kx));
        sum += src[sy*N+sx] * kernel[(ky+1)*3 + (kx+1)];
      }
      out[y*N+x] = Math.min(255, Math.max(0, Math.round(sum + bias)));
    }
    return out;
  }

  function drawGrid(ctx, data){
    for(let y=0;y<N;y++) for(let x=0;x<N;x++){
      const v = Math.round(data[y*N+x]);
      ctx.fillStyle = `rgb(${v},${v},${v})`;
      ctx.fillRect(x*CELL, y*CELL, CELL, CELL);
    }
    ctx.strokeStyle = 'rgba(255,255,255,0.06)';
    ctx.lineWidth = 1;
    for(let i=0;i<=N;i++){
      ctx.beginPath(); ctx.moveTo(i*CELL,0); ctx.lineTo(i*CELL,N*CELL); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(0,i*CELL); ctx.lineTo(N*CELL,i*CELL); ctx.stroke();
    }
  }

  function fmt(n){ return Number.isInteger(n) ? String(n) : (Math.abs(n-1/9)<1e-6 ? '1/9' : n.toFixed(2)); }

  function renderMatrix(){
    const k = KERNELS[curK];
    document.getElementById('cv-mat').innerHTML = k.m.map(v=>`<span>${fmt(v)}</span>`).join('');
    const sum = k.m.reduce((a,b)=>a+b,0);
    document.getElementById('cv-ksum').textContent = Math.abs(sum)<1e-6 ? '0' : fmt(sum);
    document.getElementById('cv-kbias').textContent = k.bias;
    document.getElementById('cv-explain').textContent = k.note;
  }

  function renderMath(){
    // arithmetic for the centre output pixel (4,4)
    const k = KERNELS[curK], cx=4, cy=4;
    let terms=[], sum=0;
    for(let ky=-1;ky<=1;ky++) for(let kx=-1;kx<=1;kx++){
      const p = img[(cy+ky)*N + (cx+kx)];
      const w = k.m[(ky+1)*3+(kx+1)];
      sum += p*w;
      if(Math.abs(w) > 1e-6) terms.push(`${p}·${fmt(w)}`);
    }
    const total = Math.min(255, Math.max(0, Math.round(sum + k.bias)));
    document.getElementById('cv-math').innerHTML =
      `<span class="c">// output[4][4] = Σ input·kernel${k.bias?` + ${k.bias}`:''}, clamped 0..255</span><br>` +
      `out[4][4] = ${terms.join(' <span class="k">+</span> ')}${k.bias?` <span class="k">+</span> ${k.bias}`:''} = <span class="g">${total}</span>`;
  }

  function renderConv(){
    drawGrid(ictx, img);
    drawGrid(octx, convolve(img, KERNELS[curK].m, KERNELS[curK].bias));
    renderMatrix();
    if(document.getElementById('cv-math').style.display !== 'none') renderMath();
  }

  const kbtns = document.getElementById('cv-kbtns');
  kbtns.onclick = e => {
    const b = e.target.closest('[data-k]'); if(!b) return;
    [...kbtns.children].forEach(c=>c.classList.remove('active'));
    b.classList.add('active'); curK = b.dataset.k; renderConv();
  };
  document.getElementById('cv-reset').onclick = ()=>{ seedImage(); renderConv(); };
  document.getElementById('cv-math-btn').onclick = ()=>{
    const el = document.getElementById('cv-math');
    const show = el.style.display === 'none';
    el.style.display = show ? '' : 'none';
    document.getElementById('cv-math-btn').textContent = show ? 'Hide math' : 'Show math';
    if(show) renderMath();
  };
  inCv.onclick = e => {
    const r = inCv.getBoundingClientRect();
    const x = Math.floor((e.clientX-r.left) / (r.width/N));
    const y = Math.floor((e.clientY-r.top)  / (r.height/N));
    if(x<0||x>=N||y<0||y>=N) return;
    img[y*N+x] = img[y*N+x] < 128 ? 245 : 20;   // toggle bright/dark
    renderConv();
  };
  seedImage();
  renderConv();

  /* ================= DETECTION / IoU ================= */
  const det = document.getElementById('det');
  const dctx = det.getContext('2d');
  const GT = { x:70, y:60, w:170, h:150 };   // ground-truth box
  const dv = { x:document.getElementById('det-x'), y:document.getElementById('det-y'),
               w:document.getElementById('det-w'), h:document.getElementById('det-h') };

  function drawBox(b, color, dash, label){
    dctx.save();
    dctx.strokeStyle = color; dctx.lineWidth = 2.5;
    dctx.setLineDash(dash||[]);
    dctx.strokeRect(b.x, b.y, b.w, b.h);
    dctx.setLineDash([]);
    dctx.fillStyle = color; dctx.font = '12px monospace';
    dctx.fillText(label, b.x+4, b.y+14);
    dctx.restore();
  }

  function renderDet(){
    const P = { x:+dv.x.value, y:+dv.y.value, w:+dv.w.value, h:+dv.h.value };
    document.getElementById('det-x-v').textContent = P.x;
    document.getElementById('det-y-v').textContent = P.y;
    document.getElementById('det-w-v').textContent = P.w;
    document.getElementById('det-h-v').textContent = P.h;

    dctx.clearRect(0,0,det.width,det.height);
    dctx.fillStyle = '#0c0c16'; dctx.fillRect(0,0,det.width,det.height);

    // intersection rectangle
    const ix = Math.max(GT.x, P.x), iy = Math.max(GT.y, P.y);
    const ix2 = Math.min(GT.x+GT.w, P.x+P.w), iy2 = Math.min(GT.y+GT.h, P.y+P.h);
    const iw = Math.max(0, ix2-ix), ih = Math.max(0, iy2-iy);
    const interA = iw*ih;
    const unionA = GT.w*GT.h + P.w*P.h - interA;
    const iou = unionA>0 ? interA/unionA : 0;

    if(interA>0){
      dctx.fillStyle = 'rgba(245,158,11,0.38)';
      dctx.fillRect(ix, iy, iw, ih);
    }
    drawBox(GT, '#34D399', [], 'truth');
    drawBox({x:P.x,y:P.y,w:P.w,h:P.h}, '#22D3EE', [6,4], 'pred');

    document.getElementById('det-iou').textContent = iou.toFixed(3);
    document.getElementById('det-inter').textContent = Math.round(interA);
    document.getElementById('det-union').textContent = Math.round(unionA);
    const m = document.getElementById('det-match');
    if(iou>=0.5){ m.textContent = '✓ TP'; m.style.color = 'var(--emerald)'; }
    else { m.textContent = '✗ miss'; m.style.color = 'var(--rose)'; }
    const iouEl = document.getElementById('det-iou');
    iouEl.style.color = iou>=0.5 ? 'var(--emerald)' : (iou>0 ? 'var(--amber)' : 'var(--rose)');
  }
  Object.values(dv).forEach(s=> s.oninput = renderDet);
  renderDet();

  /* ================= SEGMENTATION ================= */
  const seg = document.getElementById('seg');
  const sctx = seg.getContext('2d');
  const SW = seg.width, SH = seg.height;
  const base = new Float32Array(SW*SH);   // brightness 0..255
  let segView = 'mask';

  (function buildBase(){
    // sum of gaussian blobs + soft gradient → a smooth synthetic "image"
    const blobs = [
      {x:0.32,y:0.42,r:0.20,a:200},
      {x:0.68,y:0.58,r:0.26,a:230},
      {x:0.52,y:0.30,r:0.12,a:255},
      {x:0.78,y:0.28,r:0.10,a:180}
    ];
    for(let j=0;j<SH;j++) for(let i=0;i<SW;i++){
      const nx=i/SW, ny=j/SH;
      let v = 18 + 40*nx;                       // gentle background gradient
      for(const b of blobs){
        const dx=nx-b.x, dy=ny-b.y;
        v += b.a * Math.exp(-(dx*dx+dy*dy)/(2*b.r*b.r));
      }
      base[j*SW+i] = Math.min(255, v);
    }
  })();

  const PAL = [ [24,26,42], [52,211,153], [245,158,11] ];  // bg, mid, high
  function renderSeg(){
    let t1 = +document.getElementById('seg-t1').value;
    let t2 = +document.getElementById('seg-t2').value;
    if(t2 < t1+5){ t2 = t1+5; document.getElementById('seg-t2').value = t2; }
    document.getElementById('seg-t1-v').textContent = t1;
    document.getElementById('seg-t2-v').textContent = t2;

    const imgData = sctx.createImageData(SW, SH);
    const d = imgData.data;
    const counts = [0,0,0];
    for(let p=0;p<SW*SH;p++){
      const b = base[p];
      let r,g,bl;
      if(segView === 'orig'){
        const v = Math.round(b); r=g=bl=v;
      } else {
        const cls = b<t1 ? 0 : (b<t2 ? 1 : 2);
        counts[cls]++;
        r=PAL[cls][0]; g=PAL[cls][1]; bl=PAL[cls][2];
      }
      const o=p*4; d[o]=r; d[o+1]=g; d[o+2]=bl; d[o+3]=255;
    }
    sctx.putImageData(imgData, 0, 0);

    const tot = SW*SH;
    document.getElementById('seg-c0').textContent = (100*counts[0]/tot).toFixed(0)+'%';
    document.getElementById('seg-c1').textContent = (100*counts[1]/tot).toFixed(0)+'%';
    document.getElementById('seg-c2').textContent = (100*counts[2]/tot).toFixed(0)+'%';
  }
  document.getElementById('seg-legend').innerHTML =
    `<span><i style="background:rgb(24,26,42)"></i>background</span>`+
    `<span><i style="background:var(--emerald)"></i>mid-tone</span>`+
    `<span><i style="background:var(--amber)"></i>highlight</span>`;
  document.getElementById('seg-t1').oninput = renderSeg;
  document.getElementById('seg-t2').oninput = renderSeg;
  const segViewSeg = document.getElementById('seg-view');
  segViewSeg.onclick = e => {
    const b = e.target.closest('button'); if(!b) return;
    [...segViewSeg.children].forEach(c=>c.classList.remove('active'));
    b.classList.add('active'); segView = b.dataset.v; renderSeg();
  };
  renderSeg();

  /* ================= TABS ================= */
  const tabs = document.getElementById('tabs');
  tabs.onclick = e => {
    const t = e.target.closest('.tab'); if(!t) return;
    [...tabs.children].forEach(c=>c.classList.remove('active'));
    t.classList.add('active');
    ['repr','conv','pool','augment','detect','segment','vit','arch'].forEach(id=>{
      document.getElementById('panel-'+id).style.display = id===t.dataset.tab ? '' : 'none';
    });
    if(t.dataset.tab==='conv') renderConv();
    if(t.dataset.tab==='detect') renderDet();
    if(t.dataset.tab==='segment') renderSeg();
  };
})();
</script>
<script is:inline src="/js/playgrounds/cv-extra.js"></script>
  </Fragment>
</ModuleLayout>
