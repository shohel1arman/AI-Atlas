---
import ModuleLayout from '../../layouts/ModuleLayout.astro';
import ModuleTabs from '../../components/ModuleTabs.astro';
---

<ModuleLayout
  title="Statistics &amp; Data Analysis — AI Atlas"
  pageId="data-analysis"
  crumb="Statistics &amp; Data Analysis"
  eyebrow="Data Analysis"
  heading="Query, visualize, and reason about data"
>
  <Fragment slot="head">
<style is:global>
  .sql-editor{ width:100%; min-height:96px; resize:vertical; background:#0b0b14; border:1px solid var(--stroke); border-radius:12px; padding:14px 16px; color:#dfe1ff; font-family:var(--mono); font-size:13.5px; line-height:1.6; outline:none; transition:border-color .2s; }
  .sql-editor:focus{ border-color:var(--stroke-acc); }
  .res-table{ width:100%; border-collapse:collapse; font-size:13px; }
  .res-table th{ text-align:left; font-family:var(--mono); font-size:11px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-mute); padding:9px 12px; border-bottom:1px solid var(--stroke-hi); position:sticky; top:0; background:#0c0c16; }
  .res-table td{ padding:9px 12px; border-bottom:1px solid var(--stroke); font-family:var(--mono); color:var(--ink-soft); }
  .res-table tr:hover td{ background:rgba(255,255,255,.02); }
  .res-table td.num{ color:var(--cyan); text-align:right; }
  .res-wrap{ max-height:300px; overflow:auto; border:1px solid var(--stroke); border-radius:12px; }
  .q-chip{ font-family:var(--mono); font-size:11.5px; padding:6px 11px; border-radius:8px; background:var(--glass-2); border:1px solid var(--stroke); color:var(--ink-soft); cursor:pointer; transition:.18s; white-space:nowrap; }
  .q-chip:hover{ border-color:var(--stroke-acc); color:var(--ink); }
  .kpi{ padding:18px; border-radius:16px; border:1px solid var(--stroke); background:var(--glass); }
  .kpi .l{ font-size:12px; color:var(--ink-mute); font-family:var(--mono); letter-spacing:.04em; }
  .kpi .v{ font-family:var(--display); font-size:28px; font-weight:600; margin-top:6px; }
  .kpi .d{ font-size:12px; margin-top:4px; }
  .data-table{ width:100%; border-collapse:collapse; font-size:12px; }
  .data-table th,.data-table td{ padding:9px 10px; border-bottom:1px solid var(--stroke); text-align:left; font-family:var(--mono); }
  .data-table th{ color:var(--ink-mute); font-size:10px; text-transform:uppercase; }
  .data-table td{ color:var(--ink-soft); }
  .data-table tr.flag td{ background:color-mix(in srgb,var(--rose) 6%,transparent); }
  .data-table .bad{ color:var(--rose); }
  .data-table .fixed{ color:var(--emerald); }
  .tabs-scroll{ flex-wrap:nowrap; overflow-x:auto; scrollbar-width:none; }
  .tabs-scroll::-webkit-scrollbar{ display:none; }
  .tabs-scroll .tab{ flex:0 0 auto; white-space:nowrap; }
</style>
  </Fragment>
  <Fragment slot="status"><span class="pill"><span class="dot cyan"></span>real SQL · live charts</span></Fragment>
  <Fragment slot="description">Run real SQL against a live sample dataset and build a dashboard that cross-filters in real time. (Looking for distributions &amp; significance tests? Those live in <a href="/modules/mathematics/" style="color:var(--indigo-lt)">Mathematics → Statistics</a>.)</Fragment>

<ModuleTabs moduleId="data-analysis" scrollable />

      <!-- SQL -->
      <div id="panel-sql">
        <div class="glass" style="padding:20px;border-radius:var(--r-lg);margin-bottom:18px">
          <div class="row between center" style="margin-bottom:12px"><h3 style="font-size:15px">Query the <span class="mono" style="color:var(--cyan)">orders</span> table</h3><span class="pill mono" style="font-size:11px">90 rows · 7 columns</span></div>
          <textarea class="sql-editor" id="sql" spellcheck="false">SELECT region, SUM(revenue) AS revenue, COUNT(*) AS orders
FROM orders
GROUP BY region
ORDER BY revenue DESC</textarea>
          <div class="row between center" style="margin-top:12px;flex-wrap:wrap;gap:10px">
            <div class="row gap-s" style="overflow-x:auto;flex-wrap:nowrap" id="q-chips">
              <button class="q-chip" data-q="SELECT * FROM orders LIMIT 8">SELECT *</button>
              <button class="q-chip" data-q="SELECT category, AVG(revenue) AS avg_rev FROM orders GROUP BY category ORDER BY avg_rev DESC">AVG by category</button>
              <button class="q-chip" data-q="SELECT month, SUM(units) AS units FROM orders GROUP BY month">units by month</button>
              <button class="q-chip" data-q="SELECT channel, SUM(revenue) AS revenue FROM orders WHERE category = 'Electronics' GROUP BY channel">Electronics by channel</button>
            </div>
            <button class="btn btn-primary btn-sm" id="run-sql" style="flex:0 0 auto">▶ Run query</button>
          </div>
        </div>
        <div class="pg" style="grid-template-columns:1fr 1fr;align-items:start">
          <div class="glass" style="padding:16px;border-radius:var(--r-lg)">
            <div class="row between center" style="margin-bottom:12px"><h4 style="font-size:12px;font-family:var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mute)">Result</h4><span class="mono" id="row-count" style="font-size:11px;color:var(--ink-mute)">—</span></div>
            <div class="res-wrap" id="res"></div>
          </div>
          <div class="glass" style="padding:20px;border-radius:var(--r-lg)">
            <h4 style="font-size:12px;font-family:var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mute);margin-bottom:12px">Auto-chart</h4>
            <canvas id="sql-chart" style="width:100%;height:280px;display:block"></canvas>
          </div>
        </div>
      </div>

      <!-- Data Cleaning -->
      <div id="panel-clean" style="display:none">
        <div class="pg" style="grid-template-columns:1fr 360px;align-items:start">
          <div class="glass" style="padding:18px;border-radius:var(--r-lg)">
            <div class="row between center" style="margin-bottom:12px"><h3 style="font-size:15px">Customer sample</h3><span class="pill mono" id="clean-status">raw data</span></div>
            <div class="res-wrap" style="max-height:none"><table class="data-table"><thead><tr><th>ID</th><th>Age</th><th>Region</th><th>Spend</th><th>Issue</th></tr></thead><tbody id="clean-rows"></tbody></table></div>
          </div>
          <div class="pg-panel">
            <div class="ctrl"><h4>Missing values</h4><div class="seg" id="clean-missing"><button class="active" data-v="median">Fill median</button><button data-v="drop">Drop row</button></div></div>
            <div class="ctrl"><h4>Outliers</h4><div class="seg" id="clean-outlier"><button class="active" data-v="cap">Cap IQR</button><button data-v="keep">Keep</button></div></div>
            <div class="row gap"><button class="btn btn-primary" id="clean-run" type="button">Clean dataset</button><button class="btn btn-ghost" id="clean-reset" type="button">Reset</button></div>
            <div class="metrics"><div class="metric"><div class="l">ROWS</div><div class="v mono" id="clean-count">8</div></div><div class="metric"><div class="l">ISSUES</div><div class="v mono" id="clean-issues">4</div></div><div class="metric"><div class="l">MISSING</div><div class="v mono" id="clean-missing-m">2</div></div><div class="metric"><div class="l">DUPLICATES</div><div class="v mono" id="clean-dupes">1</div></div></div>
            <p class="note">Cleaning makes rules explicit: deduplicate first, then handle missing values and outliers without silently changing valid observations.</p>
          </div>
        </div>
      </div>

      <!-- Exploratory Analysis -->
      <div id="panel-eda" style="display:none">
        <div class="pg">
          <div class="pg-stage" style="aspect-ratio:1/1;min-height:0"><div class="stage-bar"><span class="pill"><span class="dot cyan"></span>distribution explorer</span></div><canvas id="eda-canvas"></canvas></div>
          <div class="pg-panel">
            <div class="ctrl"><h4>Measure</h4><div class="seg" id="eda-metric"><button class="active" data-v="revenue">Revenue</button><button data-v="units">Units</button></div></div>
            <div class="ctrl"><h4>Category</h4><div class="field" style="margin-bottom:0"><label for="eda-category">Filter rows</label><select id="eda-category" class="text-input"><option value="all">All categories</option><option>Electronics</option><option>Apparel</option><option>Home</option><option>Toys</option></select></div></div>
            <div class="metrics"><div class="metric"><div class="l">MEAN</div><div class="v mono" id="eda-mean">—</div></div><div class="metric"><div class="l">MEDIAN</div><div class="v mono" id="eda-median">—</div></div><div class="metric"><div class="l">RANGE</div><div class="v mono" id="eda-range">—</div></div><div class="metric"><div class="l">OUTLIERS</div><div class="v mono" id="eda-outliers">—</div></div></div>
            <p class="note">Switch measures and categories to see how a distribution’s center, spread, skew, and outliers change before choosing a model.</p>
          </div>
        </div>
      </div>

      <!-- Dashboard -->
      <div id="panel-dash" style="display:none">
        <div class="row between center" style="margin-bottom:18px;flex-wrap:wrap;gap:12px">
          <h3 style="font-size:18px">Sales overview</h3>
          <div class="seg" id="dash-filter"><button class="active" data-v="all">All regions</button><button data-v="North">North</button><button data-v="South">South</button><button data-v="East">East</button><button data-v="West">West</button></div>
        </div>
        <div class="grid" style="grid-template-columns:repeat(4,1fr);margin-bottom:20px" id="kpis"></div>
        <div class="grid" style="grid-template-columns:1.4fr 1fr;gap:20px;margin-bottom:20px">
          <div class="glass" style="padding:22px;border-radius:var(--r-lg)"><h4 style="font-size:14px;margin-bottom:14px">Revenue by month</h4><canvas id="ch-line" style="width:100%;height:220px;display:block"></canvas></div>
          <div class="glass" style="padding:22px;border-radius:var(--r-lg)"><h4 style="font-size:14px;margin-bottom:14px">Revenue by channel</h4><canvas id="ch-donut" style="width:100%;height:220px;display:block"></canvas></div>
        </div>
        <div class="glass" style="padding:22px;border-radius:var(--r-lg)"><h4 style="font-size:14px;margin-bottom:14px">Revenue by category</h4><canvas id="ch-bar" style="width:100%;height:180px;display:block"></canvas></div>
      </div>

      <!-- Correlation -->
      <div id="panel-corr" style="display:none">
        <div class="pg">
          <div class="pg-stage" style="aspect-ratio:1/1;min-height:0"><div class="stage-bar"><span class="pill"><span class="dot emerald"></span>correlation is not causation</span></div><canvas id="corr-canvas"></canvas></div>
          <div class="pg-panel">
            <div class="ctrl"><h4>Relationship</h4><div class="field"><label for="corr-slope">Direction & strength <span class="val" id="corr-slope-v">0.70</span></label><input id="corr-slope" type="range" min="-1" max="1" value="0.7" step="0.05"></div><div class="field" style="margin-bottom:0"><label for="corr-noise">Noise <span class="val" id="corr-noise-v">0.30</span></label><input id="corr-noise" type="range" min="0.05" max="1" value="0.3" step="0.05"></div></div>
            <button class="btn btn-ghost" id="corr-regenerate" type="button">Regenerate sample</button>
            <div class="metrics"><div class="metric"><div class="l">PEARSON r</div><div class="v mono" id="corr-r">—</div></div><div class="metric"><div class="l">R²</div><div class="v mono" id="corr-r2">—</div></div><div class="metric"><div class="l">DIRECTION</div><div class="v mono" id="corr-dir">—</div></div><div class="metric"><div class="l">SAMPLE</div><div class="v mono">60</div></div></div>
            <p class="note">Add noise to weaken the linear relationship. Pearson r measures association, but it cannot prove that one variable causes the other.</p>
          </div>
        </div>
      </div>

      <!-- Distributions -->
      <div id="panel-dist" style="display:none">
        <div class="pg" style="grid-template-columns:1fr 340px">
          <div class="pg-stage" style="aspect-ratio:16/10;min-height:0"><div class="stage-bar"><span class="pill" style="background:rgba(12,12,20,.7)">normal distribution · 68–95–99.7</span></div><canvas id="bell"></canvas></div>
          <div class="pg-panel">
            <div class="ctrl"><h4>Parameters</h4>
              <div class="field"><label for="mu">Mean μ <span class="val" id="mu-v">0.0</span></label><input type="range" id="mu" min="-3" max="3" step="0.1" value="0"></div>
              <div class="field" style="margin-bottom:0"><label for="sd">Std dev σ <span class="val" id="sd-v">1.0</span></label><input type="range" id="sd" min="0.4" max="2.5" step="0.1" value="1"></div>
            </div>
            <div class="metrics">
              <div class="metric"><div class="l">±1σ</div><div class="v mono" style="font-size:18px;color:var(--indigo-lt)">68%</div></div>
              <div class="metric"><div class="l">±2σ</div><div class="v mono" style="font-size:18px;color:var(--cyan)">95%</div></div>
              <div class="metric"><div class="l">±3σ</div><div class="v mono" style="font-size:18px;color:var(--emerald)">99.7%</div></div>
              <div class="metric"><div class="l">VARIANCE</div><div class="v mono" style="font-size:18px" id="var-v">1.00</div></div>
            </div>
            <p class="note">The <b style="color:var(--ink)">empirical rule</b>: in a normal distribution ~68% of data falls within one standard deviation of the mean, ~95% within two, ~99.7% within three.</p>
          </div>
        </div>
      </div>

      <!-- Time Series -->
      <div id="panel-time" style="display:none">
        <div class="pg">
          <div class="pg-stage" style="aspect-ratio:1/1;min-height:0"><div class="stage-bar"><span class="pill"><span class="dot"></span>history</span><span class="pill"><span class="dot cyan"></span>forecast</span></div><canvas id="time-canvas"></canvas></div>
          <div class="pg-panel">
            <div class="ctrl"><h4>Signal</h4><div class="field"><label for="time-trend">Trend <span class="val" id="time-trend-v">0.60</span></label><input id="time-trend" type="range" min="-1" max="1.5" value="0.6" step="0.1"></div><div class="field"><label for="time-season">Seasonality <span class="val" id="time-season-v">0.50</span></label><input id="time-season" type="range" min="0" max="1" value="0.5" step="0.1"></div><div class="field" style="margin-bottom:0"><label for="time-horizon">Forecast horizon <span class="val" id="time-horizon-v">6</span></label><input id="time-horizon" type="range" min="2" max="12" value="6" step="1"></div></div>
            <div class="metrics"><div class="metric"><div class="l">LAST VALUE</div><div class="v mono" id="time-last">—</div></div><div class="metric"><div class="l">FORECAST</div><div class="v mono" id="time-next">—</div></div><div class="metric"><div class="l">TREND / STEP</div><div class="v mono" id="time-step">—</div></div><div class="metric"><div class="l">HORIZON</div><div class="v mono" id="time-horizon-m">6</div></div></div>
            <p class="note">Separate trend from repeating seasonal structure, then extend both into the forecast window. Real forecasting also estimates uncertainty bands.</p>
          </div>
        </div>
      </div>

      <!-- A/B -->
      <div id="panel-ab" style="display:none">
        <div class="pg" style="grid-template-columns:1fr 340px">
          <div class="glass" style="padding:28px;border-radius:var(--r-lg)">
            <div class="row between center" style="margin-bottom:8px"><h3 style="font-size:17px">Is the lift real?</h3><span class="pill" id="sig-pill"><span class="dot emerald"></span>significant</span></div>
            <p class="note" style="margin-bottom:24px">A two-proportion z-test on conversion rates. If the p-value is below 0.05, the difference is unlikely to be chance.</p>
            <div class="grid" style="grid-template-columns:1fr 1fr;gap:18px;margin-bottom:22px">
              <div class="kpi" style="border-color:rgba(139,140,246,.3)"><div class="l">VARIANT A · control</div><div class="v" id="ra">—</div><div class="d mono" id="ca" style="color:var(--ink-mute)"></div></div>
              <div class="kpi" style="border-color:rgba(34,211,238,.3)"><div class="l">VARIANT B · test</div><div class="v" id="rb" style="color:var(--cyan)">—</div><div class="d mono" id="cb" style="color:var(--ink-mute)"></div></div>
            </div>
            <canvas id="ab-chart" style="width:100%;height:150px;display:block"></canvas>
          </div>
          <div class="pg-panel">
            <div class="ctrl"><h4>Variant A (control)</h4>
              <div class="field"><label for="va">Visitors <span class="val mono" id="va-v">2000</span></label><input type="range" id="va" min="200" max="10000" step="100" value="2000"></div>
              <div class="field" style="margin-bottom:0"><label for="cva">Conversions <span class="val mono" id="cva-v">200</span></label><input type="range" id="cva" min="10" max="2000" step="5" value="200"></div>
            </div>
            <div class="ctrl"><h4>Variant B (test)</h4>
              <div class="field"><label for="vb">Visitors <span class="val mono" id="vb-v">2000</span></label><input type="range" id="vb" min="200" max="10000" step="100" value="2000"></div>
              <div class="field" style="margin-bottom:0"><label for="cvb">Conversions <span class="val mono" id="cvb-v">240</span></label><input type="range" id="cvb" min="10" max="2000" step="5" value="240"></div>
            </div>
            <div class="metrics">
              <div class="metric"><div class="l">UPLIFT</div><div class="v mono" id="m-uplift" style="color:var(--emerald)">—</div></div>
              <div class="metric"><div class="l">P-VALUE</div><div class="v mono" id="m-pval">—</div></div>
            </div>
          </div>
        </div>
      </div>

  <Fragment slot="scripts">
<script is:inline src="/js/playgrounds/sql.js"></script>
<script is:inline src="/js/playgrounds/data-analysis-extra.js"></script>
<script is:inline>
(function(){
  function crisp(cv){ const ctx=cv.getContext('2d'); const DPR=Math.min(devicePixelRatio||1,2); const r=cv.getBoundingClientRect(); cv.width=r.width*DPR; cv.height=r.height*DPR; ctx.setTransform(DPR,0,0,DPR,0,0); return {ctx,W:r.width,H:r.height}; }
  const PAL=['#8B8CF6','#22D3EE','#34D399','#F59E0B','#FB7185','#A855F7'];

  /* ===== SQL ===== */
  const chart=document.getElementById('sql-chart');
  function renderResult(res){
    const wrap=document.getElementById('res'), rc=document.getElementById('row-count');
    if(res.error){ wrap.innerHTML=`<div style="padding:18px;color:var(--rose);font-family:var(--mono);font-size:13px">⚠ ${res.error}</div>`; rc.textContent='error'; drawSQLChart(null); return; }
    rc.textContent=res.count+' row'+(res.count===1?'':'s');
    let html='<table class="res-table"><thead><tr>'+res.cols.map(c=>`<th>${c}</th>`).join('')+'</tr></thead><tbody>';
    res.rows.forEach(row=>{ html+='<tr>'+row.map(v=>`<td class="${typeof v==='number'?'num':''}">${typeof v==='number'?v.toLocaleString():v}</td>`).join('')+'</tr>'; });
    html+='</tbody></table>'; wrap.innerHTML=html;
    drawSQLChart(res);
  }
  function drawSQLChart(res){
    const {ctx,W,H}=crisp(chart); ctx.clearRect(0,0,W,H);
    if(!res||!res.rows.length){ ctx.fillStyle='var(--ink-mute)'; return; }
    // find first text col + first numeric col
    const numIdx=res.cols.findIndex((_,i)=>res.rows.every(r=>typeof r[i]==='number'));
    const labIdx=res.cols.findIndex((_,i)=>typeof res.rows[0][i]==='string');
    if(numIdx<0){ ctx.fillStyle='#7C7C92'; ctx.font='12px JetBrains Mono'; ctx.fillText('no numeric column to chart',10,24); return; }
    const labels=res.rows.map((r,i)=> labIdx>=0? r[labIdx] : '#'+(i+1));
    const vals=res.rows.map(r=>r[numIdx]);
    const max=Math.max(...vals), n=Math.min(vals.length,12);
    const pad=30, bw=(W-pad*2)/n*0.62, gap=(W-pad*2)/n;
    for(let i=0;i<n;i++){ const h=(vals[i]/max)*(H-50); const x=pad+i*gap+(gap-bw)/2, y=H-30-h;
      const g=ctx.createLinearGradient(0,y,0,y+h); g.addColorStop(0,PAL[i%PAL.length]); g.addColorStop(1,PAL[i%PAL.length]+'55');
      ctx.fillStyle=g; ctx.beginPath(); ctx.roundRect(x,y,bw,h,5); ctx.fill();
      ctx.fillStyle='#9a9aae'; ctx.font='10px JetBrains Mono'; ctx.textAlign='center'; ctx.fillText((''+labels[i]).slice(0,6),x+bw/2,H-14);
    }
  }
  function run(){ renderResult(runSQL(document.getElementById('sql').value)); }
  document.getElementById('run-sql').onclick=run;
  document.getElementById('q-chips').onclick=e=>{ const b=e.target.closest('[data-q]'); if(!b)return; document.getElementById('sql').value=b.dataset.q; run(); };
  document.getElementById('sql').addEventListener('keydown',e=>{ if((e.metaKey||e.ctrlKey)&&e.key==='Enter') run(); });
  run();

  /* ===== Dashboard ===== */
  let region='all';
  function dashData(){ return region==='all'?SAMPLE_DATA:SAMPLE_DATA.filter(r=>r.region===region); }
  function groupSum(data,key,val){ const o={}; data.forEach(r=>o[r[key]]=(o[r[key]]||0)+r[val]); return o; }
  function drawBar(cv,obj){ const {ctx,W,H}=crisp(cv); ctx.clearRect(0,0,W,H); const keys=Object.keys(obj), vals=keys.map(k=>obj[k]); const max=Math.max(...vals,1);
    const pad=10, gap=(W-pad*2)/keys.length, bw=gap*0.6;
    keys.forEach((k,i)=>{ const h=(vals[i]/max)*(H-44); const x=pad+i*gap+(gap-bw)/2, y=H-26-h; const g=ctx.createLinearGradient(0,y,0,y+h); g.addColorStop(0,PAL[i%PAL.length]); g.addColorStop(1,PAL[i%PAL.length]+'44'); ctx.fillStyle=g; ctx.beginPath(); ctx.roundRect(x,y,bw,h,5); ctx.fill(); ctx.fillStyle='#9a9aae'; ctx.font='10px JetBrains Mono'; ctx.textAlign='center'; ctx.fillText(k.slice(0,8),x+bw/2,H-10); });
  }
  function drawLine(cv,obj){ const {ctx,W,H}=crisp(cv); ctx.clearRect(0,0,W,H); const order=['Jan','Feb','Mar','Apr','May','Jun']; const vals=order.map(k=>obj[k]||0); const max=Math.max(...vals,1); const pad=14; const step=(W-pad*2)/(order.length-1);
    ctx.beginPath(); order.forEach((_,i)=>{ const x=pad+i*step, y=H-26-(vals[i]/max)*(H-44); i?ctx.lineTo(x,y):ctx.moveTo(x,y); }); ctx.strokeStyle='#8B8CF6'; ctx.lineWidth=2.5; ctx.stroke();
    ctx.lineTo(W-pad,H-26); ctx.lineTo(pad,H-26); ctx.closePath(); ctx.fillStyle='rgba(139,140,246,.12)'; ctx.fill();
    order.forEach((k,i)=>{ const x=pad+i*step, y=H-26-(vals[i]/max)*(H-44); ctx.fillStyle='#8B8CF6'; ctx.beginPath(); ctx.arc(x,y,3.5,0,6.28); ctx.fill(); ctx.fillStyle='#9a9aae'; ctx.font='10px JetBrains Mono'; ctx.textAlign='center'; ctx.fillText(k,x,H-10); });
  }
  function drawDonut(cv,obj){ const {ctx,W,H}=crisp(cv); ctx.clearRect(0,0,W,H); const keys=Object.keys(obj), vals=keys.map(k=>obj[k]); const total=vals.reduce((a,b)=>a+b,0)||1; const cx=W/2,cy=H/2,r=Math.min(W,H)/2-16; let a=-Math.PI/2;
    keys.forEach((_,i)=>{ const ang=vals[i]/total*6.283; ctx.beginPath(); ctx.moveTo(cx,cy); ctx.arc(cx,cy,r,a,a+ang); ctx.closePath(); ctx.fillStyle=PAL[i%PAL.length]; ctx.fill(); a+=ang; });
    ctx.beginPath(); ctx.arc(cx,cy,r*0.6,0,6.283); ctx.fillStyle='#0c0c16'; ctx.fill();
    ctx.fillStyle='#ECECF6'; ctx.font='600 15px Space Grotesk'; ctx.textAlign='center'; ctx.textBaseline='middle'; ctx.fillText('$'+(total/1000).toFixed(0)+'k',cx,cy-6); ctx.fillStyle='#7C7C92'; ctx.font='10px JetBrains Mono'; ctx.fillText('total',cx,cy+12);
    // legend
    ctx.textAlign='left'; ctx.textBaseline='alphabetic';
    keys.forEach((k,i)=>{ ctx.fillStyle=PAL[i%PAL.length]; ctx.fillRect(8,14+i*16,9,9); ctx.fillStyle='#9a9aae'; ctx.font='11px JetBrains Mono'; ctx.fillText(k,22,22+i*16); });
  }
  function renderDash(){
    const d=dashData();
    const rev=d.reduce((a,r)=>a+r.revenue,0), units=d.reduce((a,r)=>a+r.units,0), orders=d.length, aov=Math.round(rev/orders);
    document.getElementById('kpis').innerHTML=[
      ['TOTAL REVENUE','$'+(rev/1000).toFixed(1)+'k','+12.4% vs prev','var(--emerald)'],
      ['ORDERS',orders.toLocaleString(),'+'+(orders*2)+' this period','var(--cyan)'],
      ['UNITS SOLD',units.toLocaleString(),'across 4 categories','var(--ink-mute)'],
      ['AVG ORDER','$'+aov.toLocaleString(),'AOV','var(--ink-mute)'],
    ].map(([l,v,dd,c])=>`<div class="kpi"><div class="l">${l}</div><div class="v">${v}</div><div class="d" style="color:${c}">${dd}</div></div>`).join('');
    drawBar(document.getElementById('ch-bar'), groupSum(d,'category','revenue'));
    drawLine(document.getElementById('ch-line'), groupSum(d,'month','revenue'));
    drawDonut(document.getElementById('ch-donut'), groupSum(d,'channel','revenue'));
  }
  const df=document.getElementById('dash-filter'); [...df.children].forEach(b=>b.setAttribute('aria-pressed',String(b.classList.contains('active')))); df.onclick=e=>{const b=e.target.closest('button');if(!b)return;[...df.children].forEach(c=>{const active=c===b;c.classList.toggle('active',active);c.setAttribute('aria-pressed',String(active));});region=b.dataset.v;renderDash();};

  /* ===== Distributions ===== */
  let mu=0,sd=1;
  function drawBell(){ const cv=document.getElementById('bell'); const {ctx,W,H}=crisp(cv); ctx.clearRect(0,0,W,H); const pad=20, oy=H-34, span=W-pad*2;
    const X=x=>pad+((x+5)/10)*span; const peak=1/(sd*Math.sqrt(2*Math.PI)); const Y=y=>oy-(y/peak)*(H-70);
    const g=(x)=>1/(sd*Math.sqrt(2*Math.PI))*Math.exp(-0.5*((x-mu)/sd)**2);
    // shaded sigma bands
    const bands=[[3,'rgba(52,211,153,0.10)'],[2,'rgba(34,211,238,0.12)'],[1,'rgba(139,140,246,0.18)']];
    bands.forEach(([k,col])=>{ ctx.beginPath(); ctx.moveTo(X(mu-k*sd),oy); for(let x=mu-k*sd;x<=mu+k*sd;x+=0.04){ ctx.lineTo(X(x),Y(g(x))); } ctx.lineTo(X(mu+k*sd),oy); ctx.closePath(); ctx.fillStyle=col; ctx.fill(); });
    // curve
    ctx.beginPath(); for(let x=-5;x<=5;x+=0.03){ const px=X(x),py=Y(g(x)); x===-5?ctx.moveTo(px,py):ctx.lineTo(px,py);} ctx.strokeStyle='#8B8CF6'; ctx.lineWidth=2.5; ctx.stroke();
    // axis + mean line
    ctx.strokeStyle='rgba(255,255,255,.12)'; ctx.beginPath(); ctx.moveTo(pad,oy); ctx.lineTo(W-pad,oy); ctx.stroke();
    ctx.setLineDash([4,3]); ctx.strokeStyle='rgba(255,255,255,.35)'; ctx.beginPath(); ctx.moveTo(X(mu),oy); ctx.lineTo(X(mu),Y(peak)); ctx.stroke(); ctx.setLineDash([]);
    ctx.fillStyle='#9a9aae'; ctx.font='11px JetBrains Mono'; ctx.textAlign='center'; ctx.fillText('μ',X(mu),oy+18);
    document.getElementById('var-v').textContent=(sd*sd).toFixed(2);
  }
  document.getElementById('mu').oninput=e=>{mu=+e.target.value;document.getElementById('mu-v').textContent=mu.toFixed(1);drawBell();};
  document.getElementById('sd').oninput=e=>{sd=+e.target.value;document.getElementById('sd-v').textContent=sd.toFixed(1);drawBell();};

  /* ===== A/B ===== */
  function erf(x){ const t=1/(1+0.3275911*Math.abs(x)); const y=1-(((((1.061405429*t-1.453152027)*t)+1.421413741)*t-0.284496736)*t+0.254829592)*t*Math.exp(-x*x); return x>=0?y:-y; }
  function renderAB(){
    const va=+document.getElementById('va').value, cva=Math.min(+document.getElementById('cva').value,va);
    const vb=+document.getElementById('vb').value, cvb=Math.min(+document.getElementById('cvb').value,vb);
    const pa=cva/va, pb=cvb/vb;
    document.getElementById('ra').textContent=(pa*100).toFixed(2)+'%'; document.getElementById('ca').textContent=cva+' / '+va;
    document.getElementById('rb').textContent=(pb*100).toFixed(2)+'%'; document.getElementById('cb').textContent=cvb+' / '+vb;
    const uplift=(pb-pa)/pa*100; document.getElementById('m-uplift').textContent=(uplift>=0?'+':'')+uplift.toFixed(1)+'%';
    document.getElementById('m-uplift').style.color=uplift>=0?'var(--emerald)':'var(--rose)';
    const pPool=(cva+cvb)/(va+vb); const se=Math.sqrt(pPool*(1-pPool)*(1/va+1/vb)); const z=se?(pb-pa)/se:0;
    const pval=2*(1-0.5*(1+erf(Math.abs(z)/Math.SQRT2)));
    document.getElementById('m-pval').textContent=pval<0.001?'<0.001':pval.toFixed(3);
    const sig=pval<0.05; document.getElementById('m-pval').style.color=sig?'var(--emerald)':'var(--amber)';
    const pill=document.getElementById('sig-pill'); pill.innerHTML=sig?`<span class="dot emerald"></span>significant (p&lt;0.05)`:`<span class="dot amber"></span>not significant`;
    // bar
    const cv=document.getElementById('ab-chart'); const {ctx,W,H}=crisp(cv); ctx.clearRect(0,0,W,H); const max=Math.max(pa,pb)*1.25||1; const bars=[['A',pa,'#8B8CF6'],['B',pb,'#22D3EE']];
    bars.forEach(([l,p,c],i)=>{ const bw=W*0.3, x=W*(0.18+i*0.42), h=(p/max)*(H-40), y=H-26-h; ctx.fillStyle=c; ctx.beginPath(); ctx.roundRect(x,y,bw,h,6); ctx.fill(); ctx.fillStyle='#ECECF6'; ctx.font='600 13px Space Grotesk'; ctx.textAlign='center'; ctx.fillText((p*100).toFixed(1)+'%',x+bw/2,y-8); ctx.fillStyle='#9a9aae'; ctx.font='11px JetBrains Mono'; ctx.fillText('Variant '+l,x+bw/2,H-8); });
  }
  ['va','cva','vb','cvb'].forEach(id=>{ const el=document.getElementById(id); el.oninput=()=>{ document.getElementById(id+'-v').textContent=el.value; renderAB(); }; });

  /* tabs */
  const tabs=document.getElementById('tabs');
  const dataTabs=['sql','clean','eda','dash','dist','corr','ab','time'];
  [...tabs.children].forEach(t=>{const id=t.dataset.tab,panel=document.getElementById('panel-'+id);t.id='tab-'+id;t.setAttribute('aria-controls','panel-'+id);panel.setAttribute('role','tabpanel');panel.setAttribute('aria-labelledby','tab-'+id);});
  function activateDataTab(t,focus=false){
    [...tabs.children].forEach(c=>{const active=c===t;c.classList.toggle('active',active);c.setAttribute('aria-selected',String(active));c.tabIndex=active?0:-1;});
    dataTabs.forEach(id=>document.getElementById('panel-'+id).style.display=id===t.dataset.tab?'':'none');
    if(focus)t.focus();
    if(t.dataset.tab==='dash')renderDash(); if(t.dataset.tab==='dist')drawBell(); if(t.dataset.tab==='ab')renderAB(); if(t.dataset.tab==='sql')run(); if(window.DataAnalysisExtra)window.DataAnalysisExtra.redraw(t.dataset.tab);
  }
  tabs.onclick=e=>{const t=e.target.closest('.tab');if(t)activateDataTab(t);};
  tabs.onkeydown=e=>{const current=e.target.closest('.tab');if(!current)return;const items=[...tabs.children],index=items.indexOf(current);let next=index;if(e.key==='ArrowRight')next=(index+1)%items.length;else if(e.key==='ArrowLeft')next=(index-1+items.length)%items.length;else if(e.key==='Home')next=0;else if(e.key==='End')next=items.length-1;else return;e.preventDefault();activateDataTab(items[next],true);};
  window.addEventListener('resize',()=>{ run(); if(document.getElementById('panel-dash').style.display!=='none')renderDash(); });
})();
</script>
