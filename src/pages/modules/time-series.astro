---
import ModuleLayout from '../../layouts/ModuleLayout.astro';
import ModuleTabs from '../../components/ModuleTabs.astro';
---

<ModuleLayout
  title="Time Series & Forecasting — AI Atlas"
  pageId="timeseries"
  crumb="Time Series"
  eyebrow="Time Series & Forecasting"
  heading="Data that remembers its order"
>
  <Fragment slot="head">
<style is:global>
  .ts-stack{ display:flex; flex-direction:column; gap:8px; }
  .ts-stack canvas{ border-radius:12px; border:1px solid var(--stroke); background:#0c0c16; width:100%; height:auto; }
  .ts-cap{ font-family:var(--mono); font-size:11px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-mute); }
  .ts-cards{ display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:14px; margin-top:18px; }
  .ts-card{ padding:18px; border-radius:var(--r); border:1px solid var(--stroke); background:var(--glass); }
  .ts-card h4{ font-size:14px; margin-bottom:8px; }
  .ts-card p{ font-size:13px; color:var(--ink-soft); line-height:1.6; }
  .ts-tag{ display:inline-flex; align-items:center; gap:6px; font-family:var(--mono); font-size:11.5px; padding:5px 10px; border-radius:999px; background:var(--glass-2); border:1px solid var(--stroke); color:var(--ink-soft); margin:4px 4px 0 0; }
  .ts-legend{ display:flex; gap:16px; flex-wrap:wrap; margin-top:12px; font-size:12.5px; color:var(--ink-soft); }
  .ts-legend i{ display:inline-block; width:12px; height:12px; border-radius:3px; margin-right:6px; vertical-align:middle; }
</style>
  </Fragment>
  <Fragment slot="status"><span class="pill"><span class="dot emerald"></span>forecasting</span></Fragment>
  <Fragment slot="description">When time is an axis, order carries meaning: a trend drifts, a season repeats, noise wobbles on top. Pull a series apart into its components, smooth away the jitter, then project the next stretch with a confidence band that honestly widens as you look further ahead.</Fragment>

  <ModuleTabs moduleId="timeseries" scrollable />

  <!-- ===================== DECOMPOSITION ===================== -->
  <div id="panel-decomp">
    <p class="note" style="margin-bottom:16px;max-width:840px">Classical <b style="color:var(--ink)">additive decomposition</b> assumes observed = <b style="color:var(--emerald)">trend</b> + <b style="color:var(--cyan)">seasonality</b> + <b style="color:var(--rose)">residual</b>. Move the sliders to build a series and watch it split into its three parts. The residual is what's left after structure is removed — ideally just noise.</p>
    <div class="pg">
      <div class="glass" style="padding:20px;border-radius:var(--r-lg)">
        <div class="ts-stack"><canvas id="dc" width="720" height="420"></canvas>
          <span class="ts-cap">observed · trend · seasonal · residual</span></div>
      </div>
      <div class="pg-panel">
        <div class="ctrl"><h4>Build the series</h4>
          <div class="field"><label>Trend slope <span class="val" id="dv1">0.30</span></label><input type="range" id="d-trend" min="-0.6" max="0.6" step="0.02" value="0.30"></div>
          <div class="field"><label>Seasonal amplitude <span class="val" id="dv2">18</span></label><input type="range" id="d-amp" min="0" max="40" step="1" value="18"></div>
          <div class="field"><label>Seasonal period <span class="val" id="dv3">24</span></label><input type="range" id="d-per" min="6" max="48" step="1" value="24"></div>
          <div class="field"><label>Noise level <span class="val" id="dv4">6</span></label><input type="range" id="d-noise" min="0" max="25" step="1" value="6"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ===================== STATIONARITY ===================== -->
  <div id="panel-stationarity" style="display:none">
    <p class="note" style="margin-bottom:16px;max-width:840px">Most models assume a <b style="color:var(--ink)">stationary</b> series — one whose mean and variance don't drift over time. A trending, seasonal series is <b style="color:var(--ink)">non-stationary</b>. <b style="color:var(--cyan)">Differencing</b> — subtracting each point from the one before — removes trend; <b style="color:var(--amber)">seasonal differencing</b> subtracts a whole period back. Apply each and watch the series flatten toward a constant mean.</p>
    <div class="pg">
      <div class="glass" style="padding:20px;border-radius:var(--r-lg)">
        <div class="ts-stack"><canvas id="stat-canvas" width="720" height="300"></canvas>
          <span class="ts-cap">transformed series (cyan) · rolling mean (amber) · zero line</span></div>
      </div>
      <div class="pg-panel">
        <div class="ctrl"><h4>Differencing</h4>
          <div class="seg" id="stat-mode"><button class="active" data-v="none">None</button><button data-v="first">1st</button><button data-v="second">2nd</button><button data-v="seasonal">Seasonal</button></div>
          <p class="note" style="margin-top:12px" id="stat-note">Raw series: trend and season make the mean drift — clearly non-stationary.</p>
        </div>
        <div class="metrics">
          <div class="metric"><div class="l">ROLLING-MEAN SPREAD</div><div class="v mono" id="stat-mean" style="font-size:16px">—</div></div>
          <div class="metric"><div class="l">ROLLING-VAR SPREAD</div><div class="v mono" id="stat-var" style="font-size:16px">—</div></div>
        </div>
        <div class="metric"><div class="l">VERDICT</div><div class="v mono" id="stat-verdict" style="font-size:16px">—</div></div>
      </div>
    </div>
    <div class="ts-cards">
      <div class="ts-card"><h4>The "I" in ARIMA</h4><p>The <b style="color:var(--ink)">d</b> term is exactly this: how many times you difference to reach stationarity. Most series need <b style="color:var(--ink)">d = 1</b>; strongly curved trends need 2. Over-differencing injects artificial noise.</p></div>
      <div class="ts-card"><h4>Unit-root tests</h4><p>The <b style="color:var(--ink)">ADF</b> and <b style="color:var(--ink)">KPSS</b> tests formalise this eyeball check — they ask whether a stochastic trend (a "unit root") remains after differencing.</p></div>
      <div class="ts-card"><h4>Variance too</h4><p>A flat mean isn't enough — the <b style="color:var(--ink)">variance</b> must also be stable. Growing swings call for a <b style="color:var(--ink)">log</b> or Box-Cox transform before differencing.</p></div>
    </div>
  </div>

  <!-- ===================== AUTOCORRELATION ===================== -->
  <div id="panel-autocorr" style="display:none">
    <p class="note" style="margin-bottom:16px;max-width:840px">The <b style="color:var(--ink)">autocorrelation function (ACF)</b> measures how much a series correlates with a lagged copy of itself. For an <b style="color:var(--cyan)">AR(1)</b> process x<sub>t</sub> = φ·x<sub>t−1</sub> + ε, the ACF decays geometrically as φ<sup>k</sup>. Slide the coefficient and watch the bars stretch out (strong memory) or collapse (near-white noise).</p>
    <div class="pg">
      <div class="glass" style="padding:20px;border-radius:var(--r-lg)">
        <div class="ts-stack"><canvas id="acf-series" width="720" height="150"></canvas>
          <span class="ts-cap">AR(1) series</span></div>
        <div class="ts-stack" style="margin-top:14px"><canvas id="acf-canvas" width="720" height="260"></canvas>
          <span class="ts-cap">ACF · lags 0–20 · dashed = 95% significance band</span></div>
      </div>
      <div class="pg-panel">
        <div class="ctrl"><h4>AR(1) coefficient</h4>
          <div class="field"><label>φ <span class="val" id="acf-phi-v">0.70</span></label><input type="range" id="acf-phi" min="-0.95" max="0.95" step="0.05" value="0.70"></div>
          <button class="btn btn-ghost btn-sm" id="acf-reroll">↻ New noise draw</button>
          <p class="note" style="margin-top:12px">φ near ±1 → long memory, slow decay. φ near 0 → each point is nearly independent.</p>
        </div>
        <div class="metrics">
          <div class="metric"><div class="l">LAG-1 ACF</div><div class="v mono" id="acf-r1" style="font-size:16px">—</div></div>
          <div class="metric"><div class="l">DECAYS BELOW BAND</div><div class="v mono" id="acf-cut" style="font-size:16px">—</div></div>
        </div>
      </div>
    </div>
    <div class="ts-cards">
      <div class="ts-card"><h4>ACF vs PACF</h4><p>The <b style="color:var(--ink)">partial</b> ACF strips out indirect lag effects. An AR(p) process cuts off sharply in the PACF after lag p; an MA(q) cuts off in the ACF after lag q — the classic identification rule.</p></div>
      <div class="ts-card"><h4>Reading the bars</h4><p>Bars poking past the <b style="color:var(--ink)">significance band</b> (±1.96/√n) signal real correlation. A slow, sinusoidal ACF hints at leftover <b style="color:var(--ink)">seasonality</b>.</p></div>
      <div class="ts-card"><h4>Why it matters</h4><p>Autocorrelation is the structure a forecaster exploits. Residuals that still show ACF mean the model left predictable signal on the table.</p></div>
    </div>
  </div>

  <!-- ===================== SMOOTHING ===================== -->
  <div id="panel-smooth" style="display:none">
    <p class="note" style="margin-bottom:16px;max-width:840px">Smoothing trades responsiveness for stability. A <b style="color:var(--cyan)">simple moving average</b> averages the last <b>W</b> points equally; an <b style="color:var(--amber)">exponential moving average</b> weights recent points more, decaying by <b>α</b>. Widen the window and the line lags; raise α and it hugs the data.</p>
    <div class="pg">
      <div class="glass" style="padding:20px;border-radius:var(--r-lg)">
        <div class="ts-stack"><canvas id="sm" width="720" height="320"></canvas>
          <span class="ts-cap">raw (faint) · SMA (cyan) · EMA (amber)</span></div>
        <div class="eqn" style="margin-top:16px">SMA<sub>t</sub> = mean(x<sub>t−W+1…t</sub>)&nbsp;&nbsp;&nbsp;EMA<sub>t</sub> = <span class="g">α</span>·x<sub>t</sub> + (1−<span class="g">α</span>)·EMA<sub>t−1</sub></div>
      </div>
      <div class="pg-panel">
        <div class="ctrl"><h4>Smoothers</h4>
          <div class="field"><label>Window W (SMA) <span class="val" id="sv1">7</span></label><input type="range" id="s-win" min="1" max="30" step="1" value="7"></div>
          <div class="field"><label>α (EMA) <span class="val" id="sv2">0.30</span></label><input type="range" id="s-alpha" min="0.02" max="1" step="0.02" value="0.30"></div>
          <button class="btn btn-ghost btn-sm" id="s-reroll">↻ New noisy series</button>
          <p class="note" style="margin-top:12px">Low α ≈ long memory (smooth, laggy). High α ≈ short memory (reactive).</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ===================== ARIMA ===================== -->
  <div id="panel-arima" style="display:none">
    <p class="note" style="margin-bottom:16px;max-width:840px"><b style="color:var(--ink)">ARIMA(p, d, q)</b> stitches three ideas together: <b style="color:var(--cyan)">AR(p)</b> regresses on the last <b>p</b> values, <b style="color:var(--amber)">I(d)</b> differences the series <b>d</b> times to make it stationary, and <b style="color:var(--rose)">MA(q)</b> corrects using the last <b>q</b> forecast errors. Turn the three dials and watch the <span style="color:var(--indigo-lt)">one-step fit</span> track the <span style="color:var(--ink)">actual</span> series, with residuals below.</p>
    <div class="pg">
      <div class="glass" style="padding:20px;border-radius:var(--r-lg)">
        <div class="ts-stack"><canvas id="arima-canvas" width="720" height="250"></canvas>
          <span class="ts-cap">actual (grey) · fitted one-step (indigo)</span></div>
        <div class="ts-stack" style="margin-top:14px"><canvas id="arima-resid" width="720" height="120"></canvas>
          <span class="ts-cap">residuals (actual − fitted)</span></div>
      </div>
      <div class="pg-panel">
        <div class="ctrl"><h4>Orders</h4>
          <div class="field"><label>AR order p <span class="val" id="arima-p-v">1</span></label><input type="range" id="arima-p" min="0" max="4" step="1" value="1"></div>
          <div class="field"><label>Differencing d <span class="val" id="arima-d-v">1</span></label><input type="range" id="arima-d" min="0" max="2" step="1" value="1"></div>
          <div class="field"><label>MA order q <span class="val" id="arima-q-v">1</span></label><input type="range" id="arima-q" min="0" max="4" step="1" value="1"></div>
          <p class="note" style="margin-top:8px" id="arima-note">—</p>
        </div>
        <div class="metrics">
          <div class="metric"><div class="l">RESIDUAL STD</div><div class="v mono" id="arima-rstd" style="font-size:16px">—</div></div>
          <div class="metric"><div class="l">AIC (toy)</div><div class="v mono" id="arima-aic" style="font-size:16px">—</div></div>
        </div>
      </div>
    </div>
    <div class="ts-cards">
      <div class="ts-card"><h4>Picking p, d, q</h4><p>Choose <b style="color:var(--ink)">d</b> from stationarity, then read <b style="color:var(--ink)">p</b> from the PACF and <b style="color:var(--ink)">q</b> from the ACF. <b style="color:var(--ink)">auto_arima</b> automates the search by minimising AIC.</p></div>
      <div class="ts-card"><h4>SARIMA</h4><p>Real data has seasons, so <b style="color:var(--ink)">SARIMA(p,d,q)(P,D,Q)ₘ</b> adds a second seasonal triple at lag <b>m</b> — e.g. 12 for monthly data.</p></div>
      <div class="ts-card"><h4>Good residuals</h4><p>A well-fit model leaves residuals that look like <b style="color:var(--ink)">white noise</b>: no autocorrelation, constant variance, roughly zero mean. That's the diagnostic to chase.</p></div>
    </div>
  </div>

  <!-- ===================== FORECAST ===================== -->
  <div id="panel-forecast" style="display:none">
    <p class="note" style="margin-bottom:16px;max-width:840px">A forecast extends the series into the future. Here <b style="color:var(--indigo-lt)">simple exponential smoothing with drift</b> projects the level forward; the shaded band is a prediction interval that <b style="color:var(--ink)">widens with the horizon</b> — the further out, the less certain. Honest uncertainty is half the job.</p>
    <div class="pg">
      <div class="glass" style="padding:20px;border-radius:var(--r-lg)">
        <div class="ts-stack"><canvas id="fc" width="720" height="340"></canvas>
          <span class="ts-cap">history (solid) · forecast (dashed) · ±interval (shaded)</span></div>
      </div>
      <div class="pg-panel">
        <div class="ctrl"><h4>Project forward</h4>
          <div class="field"><label>Horizon H <span class="val" id="fv1">20</span></label><input type="range" id="f-h" min="4" max="48" step="1" value="20"></div>
          <div class="field"><label>Smoothing α <span class="val" id="fv2">0.40</span></label><input type="range" id="f-alpha" min="0.05" max="0.95" step="0.05" value="0.40"></div>
          <button class="btn btn-ghost btn-sm" id="f-reroll">↻ New series</button>
        </div>
        <div class="metrics">
          <div class="metric"><div class="l">LEVEL</div><div class="v mono" id="f-lvl">—</div></div>
          <div class="metric"><div class="l">DRIFT / STEP</div><div class="v mono" id="f-drift">—</div></div>
        </div>
      </div>
    </div>
    <div class="ts-cards">
      <div class="ts-card"><h4>Baselines first</h4><p>Naive (last value), seasonal-naive (last season), mean, and drift. Always beat these before reaching for ARIMA or deep nets.</p></div>
      <div class="ts-card"><h4>ARIMA / ETS</h4><p>ARIMA(p,d,q) models autocorrelation after differencing; SARIMA adds seasonality. ETS is the state-space form of exponential smoothing (Holt-Winters).</p></div>
      <div class="ts-card"><h4>ML &amp; deep</h4><p>Gradient boosting on lag/rolling features, LSTMs, and Temporal Fusion Transformers — powerful, but validate with rolling-origin backtests to avoid leakage.</p></div>
    </div>
  </div>

  <!-- ===================== BACKTESTING ===================== -->
  <div id="panel-eval" style="display:none">
    <p class="note" style="margin-bottom:16px;max-width:840px">You can't shuffle time, so you validate with <b style="color:var(--ink)">rolling-origin</b> (walk-forward) backtesting: train on the past, forecast the next window, then roll the origin forward and repeat. Each <span style="color:var(--emerald)">test fold</span> sits strictly after its <span style="color:var(--ink)">training data</span>. Add folds and watch the errors accumulate across the marching windows.</p>
    <div class="pg">
      <div class="glass" style="padding:20px;border-radius:var(--r-lg)">
        <div class="ts-stack"><canvas id="bt-canvas" width="720" height="330"></canvas>
          <span class="ts-cap">series (grey) · train (shaded) · test folds (emerald) · per-fold forecast (dashed)</span></div>
        <div class="ts-legend">
          <span><i style="background:var(--emerald)"></i>test fold</span>
          <span><i style="background:rgba(139,140,246,.5)"></i>train region</span>
          <span><i style="background:var(--amber)"></i>forecast</span>
        </div>
      </div>
      <div class="pg-panel">
        <div class="ctrl"><h4>Folds</h4>
          <div class="field"><label>Number of folds <span class="val" id="bt-folds-v">4</span></label><input type="range" id="bt-folds" min="2" max="6" step="1" value="4"></div>
          <button class="btn btn-ghost btn-sm" id="bt-reroll">↻ New series</button>
          <p class="note" style="margin-top:12px">Each fold's forecast is a drift extrapolation of its own training tail — a simple, leakage-free baseline.</p>
        </div>
        <div class="metrics">
          <div class="metric"><div class="l">MAE</div><div class="v mono" id="bt-mae" style="font-size:18px;color:var(--cyan)">—</div></div>
          <div class="metric"><div class="l">RMSE</div><div class="v mono" id="bt-rmse" style="font-size:18px">—</div></div>
        </div>
        <div class="metric"><div class="l">MAPE</div><div class="v mono" id="bt-mape" style="font-size:18px;color:var(--amber)">—</div></div>
      </div>
    </div>
    <div class="ts-cards">
      <div class="ts-card"><h4>Expanding vs sliding</h4><p><b style="color:var(--ink)">Expanding</b> windows keep all history; <b style="color:var(--ink)">sliding</b> windows use a fixed recent span. Sliding adapts to regime change; expanding uses more data.</p></div>
      <div class="ts-card"><h4>Which metric</h4><p><b style="color:var(--ink)">MAE</b> is robust and in the data's units; <b style="color:var(--ink)">RMSE</b> punishes big misses; <b style="color:var(--ink)">MAPE</b> is scale-free but blows up near zero. Report more than one.</p></div>
      <div class="ts-card"><h4>Leakage traps</h4><p>Never let future rows touch training — no random K-fold, no fitting scalers on the whole series, and add a <b style="color:var(--ink)">gap</b> when features use future-looking windows.</p></div>
    </div>
  </div>

  <!-- ===================== ANOMALY DETECTION ===================== -->
  <div id="panel-anomaly" style="display:none">
    <p class="note" style="margin-bottom:16px;max-width:840px">Once the structure is modelled, whatever's left — the <b style="color:var(--ink)">residual</b> — should be small and boring. Points whose residual is many standard deviations from zero are <b style="color:var(--rose)">anomalies</b>. Drag the <b>σ threshold</b>: lower it to catch more (and risk false alarms), raise it to flag only the extreme spikes. Precision and recall move against each other.</p>
    <div class="pg">
      <div class="glass" style="padding:20px;border-radius:var(--r-lg)">
        <div class="ts-stack"><canvas id="anom-canvas" width="720" height="330"></canvas>
          <span class="ts-cap">series (grey) · ±σ band (shaded) · injected (ring) · flagged (red)</span></div>
        <div class="ts-legend">
          <span><i style="background:var(--rose)"></i>flagged anomaly</span>
          <span><i style="border:2px solid var(--amber);background:transparent"></i>true injected spike</span>
        </div>
      </div>
      <div class="pg-panel">
        <div class="ctrl"><h4>Detector</h4>
          <div class="field"><label>z-score threshold <span class="val" id="anom-z-v">3.0</span></label><input type="range" id="anom-z" min="1.5" max="5" step="0.1" value="3.0"></div>
          <button class="btn btn-ghost btn-sm" id="anom-reroll">↻ New spikes</button>
          <p class="note" style="margin-top:12px">Residual = series − rolling median. z = residual / σ. Flag when |z| exceeds the threshold.</p>
        </div>
        <div class="metrics">
          <div class="metric"><div class="l">FLAGGED</div><div class="v mono" id="anom-count" style="font-size:18px">—</div></div>
          <div class="metric"><div class="l">PRECISION</div><div class="v mono" id="anom-prec" style="font-size:18px;color:var(--emerald)">—</div></div>
        </div>
        <div class="metric"><div class="l">RECALL</div><div class="v mono" id="anom-rec" style="font-size:18px;color:var(--cyan)">—</div></div>
      </div>
    </div>
    <div class="ts-cards">
      <div class="ts-card"><h4>Point vs contextual</h4><p>A <b style="color:var(--ink)">point</b> anomaly is extreme anywhere; a <b style="color:var(--ink)">contextual</b> one is only odd for its season (hot in winter). Deseasonalise before scoring, or you drown in false positives.</p></div>
      <div class="ts-card"><h4>Beyond z-score</h4><p><b style="color:var(--ink)">STL</b> residuals, <b style="color:var(--ink)">rolling IQR</b>, <b style="color:var(--ink)">Isolation Forest</b>, and forecast-residual monitors all generalise this idea to messier, multivariate data.</p></div>
      <div class="ts-card"><h4>The trade-off</h4><p>Every threshold is a point on a <b style="color:var(--ink)">precision–recall</b> curve. The "right" spot depends on the cost of a missed event versus the cost of a false alarm.</p></div>
    </div>
  </div>

  <Fragment slot="scripts">
<script is:inline>
(function(){
  const NP=120;                              // number of history points
  function rnd(){ return Math.random()*2-1; }
  // simple axis + polyline helpers on a canvas ctx given a value range
  function axes(ctx,W,H,pad){ ctx.strokeStyle='rgba(255,255,255,.12)'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.moveTo(pad,H-pad); ctx.lineTo(W-6,H-pad); ctx.stroke(); }
  const range=a=>{ let lo=Infinity,hi=-Infinity; a.forEach(v=>{lo=Math.min(lo,v);hi=Math.max(hi,v);}); const m=(hi-lo)*0.1||1; return [lo-m,hi+m]; };

  /* ===== decomposition ===== */
  const dc=document.getElementById('dc').getContext('2d');
  function drawDecomp(){
    const slope=+v('d-trend'), amp=+v('d-amp'), per=+v('d-per'), noise=+v('d-noise');
    setv('dv1',slope.toFixed(2)); setv('dv2',amp); setv('dv3',per); setv('dv4',noise);
    const trend=[],seas=[],resid=[],obs=[];
    for(let i=0;i<NP;i++){ const t=50+slope*i; const s=amp*Math.sin(2*Math.PI*i/per); const e=noise*rnd();
      trend.push(t); seas.push(s); resid.push(e); obs.push(t+s+e); }
    const W=720,H=420,pad=30, rowH=H/4;
    dc.clearRect(0,0,W,H);
    const rows=[['observed',obs,'#8B8CF6'],['trend',trend,'#34D399'],['seasonal',seas,'#22D3EE'],['residual',resid,'#FB7185']];
    rows.forEach((rw,idx)=>{
      dc.save(); dc.translate(0,idx*rowH);
      const [lo,hi]=range(rw[1]);
      dc.strokeStyle='rgba(255,255,255,.10)'; dc.beginPath(); dc.moveTo(pad,rowH-10); dc.lineTo(W-6,rowH-10); dc.stroke();
      plot2(dc,rw[1],W,rowH-6,pad,8,lo,hi,rw[2],1.6);
      dc.fillStyle='var(--ink-mute)'; dc.fillStyle='#7C7C92'; dc.font='11px JetBrains Mono, monospace'; dc.textAlign='left';
      dc.fillText(rw[0], pad+2, 14);
      dc.restore();
    });
  }
  // plot within a sub-band [top..bottom]
  function plot2(ctx,data,W,bottom,pad,top,lo,hi,color,width){
    ctx.strokeStyle=color; ctx.lineWidth=width; ctx.beginPath();
    data.forEach((val,i)=>{ const x=pad+(W-pad-6)*(i/(data.length-1)); const y=bottom-(bottom-top)*((val-lo)/(hi-lo||1));
      i?ctx.lineTo(x,y):ctx.moveTo(x,y); });
    ctx.stroke();
  }
  ['d-trend','d-amp','d-per','d-noise'].forEach(id=>document.getElementById(id).oninput=drawDecomp);

  /* ===== smoothing ===== */
  const sm=document.getElementById('sm').getContext('2d');
  let noisy=genNoisy();
  function genNoisy(){ const a=[]; let x=50; for(let i=0;i<NP;i++){ x+=0.15*Math.sin(i/9)+ (Math.random()*10-5); a.push(x); } return a; }
  function sma(a,w){ const o=[]; for(let i=0;i<a.length;i++){ let s=0,c=0; for(let j=Math.max(0,i-w+1);j<=i;j++){s+=a[j];c++;} o.push(s/c);} return o; }
  function ema(a,al){ const o=[a[0]]; for(let i=1;i<a.length;i++) o.push(al*a[i]+(1-al)*o[i-1]); return o; }
  function drawSmooth(){
    const w=+v('s-win'), al=+v('s-alpha'); setv('sv1',w); setv('sv2',al.toFixed(2));
    const W=720,H=320,pad=30; sm.clearRect(0,0,W,H); axes(sm,W,H,pad);
    const [lo,hi]=range(noisy);
    plotFull(sm,noisy,W,H,pad,lo,hi,'rgba(185,185,204,.35)',1.2);
    plotFull(sm,sma(noisy,w),W,H,pad,lo,hi,'#22D3EE',2);
    plotFull(sm,ema(noisy,al),W,H,pad,lo,hi,'#F59E0B',2);
  }
  function plotFull(ctx,data,W,H,pad,lo,hi,color,width){ ctx.strokeStyle=color; ctx.lineWidth=width; ctx.beginPath();
    data.forEach((val,i)=>{ const x=pad+(W-pad-6)*(i/(data.length-1)); const y=(H-pad)-(H-2*pad)*((val-lo)/(hi-lo||1));
      i?ctx.lineTo(x,y):ctx.moveTo(x,y); }); ctx.stroke(); }
  ['s-win','s-alpha'].forEach(id=>document.getElementById(id).oninput=drawSmooth);
  document.getElementById('s-reroll').onclick=()=>{ noisy=genNoisy(); drawSmooth(); };

  /* ===== forecast ===== */
  const fc=document.getElementById('fc').getContext('2d');
  let hist=genHist();
  function genHist(){ const a=[]; let x=40; for(let i=0;i<NP;i++){ x+=0.12+ (Math.random()*6-3)+4*Math.sin(i/11); a.push(x);} return a; }
  function drawForecast(){
    const H_=+v('f-h'), al=+v('f-alpha'); setv('fv1',H_); setv('fv2',al.toFixed(2));
    // SES level + drift estimate from tail
    let level=hist[0]; for(let i=1;i<hist.length;i++) level=al*hist[i]+(1-al)*level;
    const tail=hist.slice(-12); const drift=(tail[tail.length-1]-tail[0])/(tail.length-1);
    setv('f-lvl',level.toFixed(1)); setv('f-drift',drift.toFixed(2));
    const resid=Math.sqrt(hist.slice(1).reduce((s,x,i)=>s+Math.pow(x-hist[i],2),0)/(hist.length-1));
    const fcast=[],up=[],dn=[];
    for(let h=1;h<=H_;h++){ const yv=level+drift*h; fcast.push(yv); const band=resid*Math.sqrt(h)*1.28; up.push(yv+band); dn.push(yv-band); }
    const all=hist.concat(fcast,up,dn); const [lo,hi]=range(all);
    const W=720,H=340,pad=30; const total=NP+H_;
    fc.clearRect(0,0,W,H); axes(fc,W,H,pad);
    const X=i=>pad+(W-pad-6)*(i/(total-1));
    const Y=val=>(H-pad)-(H-2*pad)*((val-lo)/(hi-lo||1));
    // band polygon
    fc.fillStyle='rgba(99,102,241,.14)'; fc.beginPath();
    up.forEach((val,h)=>{ const x=X(NP-1+h+1),y=Y(val); h?fc.lineTo(x,y):fc.moveTo(X(NP-1),Y(hist[NP-1])); });
    for(let h=dn.length-1;h>=0;h--){ fc.lineTo(X(NP-1+h+1),Y(dn[h])); }
    fc.closePath(); fc.fill();
    // history
    fc.strokeStyle='#B9B9CC'; fc.lineWidth=1.8; fc.beginPath();
    hist.forEach((val,i)=>{ const x=X(i),y=Y(val); i?fc.lineTo(x,y):fc.moveTo(x,y); }); fc.stroke();
    // forecast dashed
    fc.strokeStyle='#8B8CF6'; fc.lineWidth=2; fc.setLineDash([6,5]); fc.beginPath();
    fc.moveTo(X(NP-1),Y(hist[NP-1]));
    fcast.forEach((val,h)=>fc.lineTo(X(NP-1+h+1),Y(val))); fc.stroke(); fc.setLineDash([]);
    // divider
    fc.strokeStyle='rgba(255,255,255,.18)'; fc.setLineDash([3,4]); fc.beginPath(); fc.moveTo(X(NP-1),pad); fc.lineTo(X(NP-1),H-pad); fc.stroke(); fc.setLineDash([]);
  }
  ['f-h','f-alpha'].forEach(id=>document.getElementById(id).oninput=drawForecast);
  document.getElementById('f-reroll').onclick=()=>{ hist=genHist(); drawForecast(); };

  /* helpers */
  function v(id){ return document.getElementById(id).value; }
  function setv(id,val){ document.getElementById(id).textContent=val; }

  /* initial paints */
  drawDecomp(); drawSmooth(); drawForecast();

  /* ===== tabs ===== */
  const tabs=document.getElementById('tabs');
  const PANELS=['decomp','stationarity','autocorr','smooth','arima','forecast','eval','anomaly'];
  tabs.onclick=e=>{ const t=e.target.closest('.tab'); if(!t)return;
    [...tabs.children].forEach(c=>{ c.classList.remove('active'); c.setAttribute('aria-selected','false'); c.tabIndex=-1; });
    t.classList.add('active'); t.setAttribute('aria-selected','true'); t.tabIndex=0;
    PANELS.forEach(p=>document.getElementById('panel-'+p).style.display=(t.dataset.tab===p?'':'none'));
    if(t.dataset.tab==='decomp')drawDecomp(); if(t.dataset.tab==='smooth')drawSmooth(); if(t.dataset.tab==='forecast')drawForecast();
  };
})();
</script>
<script is:inline src="/js/playgrounds/timeseries-extra.js"></script>
  </Fragment>
</ModuleLayout>
