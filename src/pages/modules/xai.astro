---
import ModuleLayout from '../../layouts/ModuleLayout.astro';
import ModuleTabs from '../../components/ModuleTabs.astro';
import XaiPlaygrounds from '../../components/playgrounds/XaiPlaygrounds.astro';
---

<ModuleLayout
  title="Explainable AI — AI Atlas"
  pageId="xai"
  crumb="Explainable AI"
  eyebrow="Explainable AI (XAI)"
  heading="Open the black box"
>
  <Fragment slot="status"><span class="pill"><span class="dot amber"></span>8 interactive playgrounds</span></Fragment>
  <Fragment slot="description">Explain individual predictions, audit global behaviour, inspect curves and vision heatmaps, generate counterfactuals, measure group fairness, and trace how language models form answers.</Fragment>

  <ModuleTabs moduleId="xai" scrollable />
  <XaiPlaygrounds />

  <Fragment slot="scripts">
    <script is:inline>
      (() => {
        const lessonIds = ['xai', 'lime', 'global', 'pdp', 'gradcam', 'counter', 'fairness', 'llm'];
        const tabs = document.getElementById('tabs');
        if (!tabs) return;
        const tabItems = [...tabs.querySelectorAll('.tab')];
        lessonIds.forEach((id) => {
          const panel = document.getElementById('panel-' + id);
          if (!panel) return;
          panel.setAttribute('role', 'tabpanel');
          panel.setAttribute('aria-labelledby', 'tab-' + id);
        });
        const selectTab = (tab, focus = false) => {
          tabItems.forEach((item) => {
            const selected = item === tab;
            item.classList.toggle('active', selected);
            item.setAttribute('aria-selected', String(selected));
            item.tabIndex = selected ? 0 : -1;
          });
          lessonIds.forEach((id) => {
            const panel = document.getElementById('panel-' + id);
            if (panel) panel.style.display = id === tab.dataset.tab ? '' : 'none';
          });
          document.dispatchEvent(new CustomEvent('xai:tab', { detail: tab.dataset.tab }));
          if (focus) tab.focus();
        };
        tabs.addEventListener('click', (event) => {
          const tab = event.target.closest('.tab');
          if (tab) selectTab(tab);
        });
        tabs.addEventListener('keydown', (event) => {
          const current = event.target.closest('.tab');
          if (!current) return;
          const index = tabItems.indexOf(current);
          let next = index;
          if (event.key === 'ArrowRight') next = (index + 1) % tabItems.length;
          else if (event.key === 'ArrowLeft') next = (index - 1 + tabItems.length) % tabItems.length;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = tabItems.length - 1;
          else return;
          event.preventDefault();
          selectTab(tabItems[next], true);
        });
      })();
    </script>
  </Fragment>
</ModuleLayout>
