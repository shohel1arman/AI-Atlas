---
import ModuleLayout from '../../layouts/ModuleLayout.astro';
import ModuleTabs from '../../components/ModuleTabs.astro';
import LlmAgentPlaygrounds from '../../components/playgrounds/LlmAgentPlaygrounds.astro';
---

<ModuleLayout
  title="LLM &amp; Agents Lab — AI Atlas"
  pageId="llm-agents"
  crumb="LLM &amp; Agents Lab"
  eyebrow="LLM &amp; Agents Lab"
  heading="Build, run, tune, and orchestrate language models"
>
  <Fragment slot="status"><span class="pill"><span class="dot violet"></span>8 interactive playgrounds</span></Fragment>
  <Fragment slot="description">Follow the full LLM lifecycle: train and size a model, design its prompt, connect tools, step through an agent loop, manage memory, fine-tune adapters, and gate releases with evaluation.</Fragment>

  <ModuleTabs moduleId="llm-agents" scrollable />
  <LlmAgentPlaygrounds />

  <Fragment slot="scripts">
    <script is:inline>
      (() => {
        const lessonIds = ['build', 'local', 'prompt', 'tools', 'agent', 'memory', 'tune', 'eval'];
        const tabs = document.getElementById('tabs');
        if (!tabs) return;
        const tabItems = [...tabs.querySelectorAll('.tab')];
        lessonIds.forEach((id) => {
          const panel = document.getElementById('panel-' + id);
          if (!panel) return;
          panel.setAttribute('role', 'tabpanel');
          panel.setAttribute('aria-labelledby', 'tab-' + id);
        });
        const selectTab = (tab, focus = false) => {
          tabItems.forEach((item) => {
            const selected = item === tab;
            item.classList.toggle('active', selected);
            item.setAttribute('aria-selected', String(selected));
            item.tabIndex = selected ? 0 : -1;
          });
          lessonIds.forEach((id) => {
            const panel = document.getElementById('panel-' + id);
            if (panel) panel.style.display = id === tab.dataset.tab ? '' : 'none';
          });
          if (focus) tab.focus();
        };
        tabs.addEventListener('click', (event) => {
          const tab = event.target.closest('.tab');
          if (tab) selectTab(tab);
        });
        tabs.addEventListener('keydown', (event) => {
          const current = event.target.closest('.tab');
          if (!current) return;
          const index = tabItems.indexOf(current);
          let next = index;
          if (event.key === 'ArrowRight') next = (index + 1) % tabItems.length;
          else if (event.key === 'ArrowLeft') next = (index - 1 + tabItems.length) % tabItems.length;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = tabItems.length - 1;
          else return;
          event.preventDefault();
          selectTab(tabItems[next], true);
        });
      })();
    </script>
  </Fragment>
</ModuleLayout>
