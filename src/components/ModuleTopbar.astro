---
interface Props {
  crumb: string;
}

const { crumb } = Astro.props;
---

<div class="topbar">
  <button class="menu-btn" onclick="toggleSide()" aria-label="Menu">
    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
      <path d="M2 4h14M2 9h14M2 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
    </svg>
  </button>
  <div class="crumb">Atlas <span>/</span> <b>{crumb}</b></div>
  <div class="actions"><slot /></div>
</div>
