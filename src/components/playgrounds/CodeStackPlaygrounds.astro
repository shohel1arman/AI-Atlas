<div class="code-stack">
  <div id="panel-lang">
    <div class="cs-toolbar">
      <div class="cs-language-switch" id="cs-languages" aria-label="Programming language">
        <button class="cs-language active" data-language="python" aria-pressed="true"><span class="cs-logo python">Py</span>Python</button>
        <button class="cs-language" data-language="r" aria-pressed="false"><span class="cs-logo r">R</span>R</button>
        <button class="cs-language" data-language="go" aria-pressed="false"><span class="cs-logo go">Go</span>Golang</button>
      </div>
      <span class="pill" id="cs-runtime" role="status"><span class="dot amber"></span>Python runtime idle</span>
    </div>
    <div class="cs-learn-grid">
      <aside class="glass cs-lessons" aria-label="Coding lessons">
        <h4 class="cs-label">Lessons</h4>
        <div id="cs-lesson-list"></div>
      </aside>
      <section aria-labelledby="cs-lesson-title">
        <div class="glass cs-brief">
          <div class="row between center"><h3 id="cs-lesson-title">—</h3><span class="mono note" id="cs-lesson-index"></span></div>
          <p class="note" id="cs-lesson-brief"></p>
        </div>
        <div class="cs-code-area">
          <div class="cs-code-head"><span class="cs-window-dot rose"></span><span class="cs-window-dot amber"></span><span class="cs-window-dot green"></span><span class="mono note" id="cs-file">lesson.py</span><span class="mono note cs-edit-note">editable · Ctrl/⌘ + Enter to run</span></div>
          <label class="sr-only" for="cs-editor">Lesson code editor</label>
          <textarea class="cs-editor" id="cs-editor" spellcheck="false"></textarea>
        </div>
        <div class="cs-actions">
          <button class="btn btn-primary btn-sm" id="cs-run">▶ Run code</button>
          <button class="btn btn-ghost btn-sm" id="cs-reset">↺ Reset</button>
          <button class="btn btn-ghost btn-sm" id="cs-check">✓ Check</button>
        </div>
        <div class="row between center cs-console-head"><h4 class="cs-label">Console</h4><span class="pill mono" id="cs-language-meta">CPython · Pyodide</span></div>
        <pre class="cs-console" id="cs-console" aria-live="polite">$ ready — press Run</pre>
      </section>
    </div>
  </div>

  <div id="panel-libs" style="display:none">
    <div class="pg">
      <section class="glass cs-workbench" aria-labelledby="cs-libs-heading">
        <h4 id="cs-libs-heading" class="cs-kicker">Build an applied AI stack</h4>
        <div class="cs-stack-flow" id="cs-stack-flow" aria-live="polite"></div>
      </section>
      <aside class="pg-panel">
        <div class="ctrl"><h4>Project goal</h4><div class="seg" id="cs-lib-goal"><button class="active" data-v="analysis">Analysis</button><button data-v="classic">Classic ML</button><button data-v="deep">Deep learning</button></div></div>
        <div class="ctrl"><h4>Deployment target</h4><div class="seg" id="cs-lib-target"><button class="active" data-v="notebook">Notebook</button><button data-v="api">API</button><button data-v="edge">Edge</button></div></div>
        <div class="metrics" aria-live="polite"><div class="metric"><div class="l">CORE LIBRARY</div><div class="v cs-small" id="cs-lib-core">—</div></div><div class="metric"><div class="l">STACK SIZE</div><div class="v mono" id="cs-lib-size">—</div></div></div>
        <p class="note" id="cs-lib-note"></p>
      </aside>
    </div>
  </div>

  <div id="panel-db" style="display:none">
    <div class="pg">
      <section class="glass cs-workbench" aria-labelledby="cs-db-heading">
        <h4 id="cs-db-heading" class="cs-kicker">Choose a data store from the workload</h4>
        <div class="cs-db-choice"><span class="cs-db-icon" id="cs-db-icon">SQL</span><div><strong id="cs-db-name">PostgreSQL</strong><p class="note" id="cs-db-reason"></p></div></div>
        <pre class="cs-console cs-query" id="cs-db-query" aria-live="polite"></pre>
      </section>
      <aside class="pg-panel">
        <div class="ctrl"><div class="field"><label for="cs-db-relations">Relationship complexity <span class="val" id="cs-db-relations-v">70%</span></label><input id="cs-db-relations" type="range" min="0" max="100" value="70" /></div><div class="field"><label for="cs-db-change">Schema change frequency <span class="val" id="cs-db-change-v">25%</span></label><input id="cs-db-change" type="range" min="0" max="100" value="25" /></div><div class="field"><label for="cs-db-search">Semantic search need <span class="val" id="cs-db-search-v">10%</span></label><input id="cs-db-search" type="range" min="0" max="100" value="10" /></div></div>
        <div class="metrics"><div class="metric"><div class="l">MODEL</div><div class="v cs-small" id="cs-db-model">—</div></div><div class="metric"><div class="l">CONSISTENCY</div><div class="v cs-small" id="cs-db-consistency">—</div></div></div>
      </aside>
    </div>
  </div>

  <div id="panel-git" style="display:none">
    <div class="pg">
      <section class="glass cs-workbench" aria-labelledby="cs-git-heading"><h4 id="cs-git-heading" class="cs-kicker">Branch, commit, and merge safely</h4><div class="cs-git-graph" id="cs-git-graph" role="img" aria-label="Git commit history"></div><div class="cs-command" id="cs-git-command" aria-live="polite">git status</div></section>
      <aside class="pg-panel"><div class="ctrl"><h4>Branch strategy</h4><div class="seg" id="cs-git-strategy"><button class="active" data-v="feature">Feature</button><button data-v="trunk">Trunk</button><button data-v="release">Release</button></div></div><div class="ctrl"><div class="field"><label for="cs-git-commits">Commits on branch <span class="val" id="cs-git-commits-v">3</span></label><input id="cs-git-commits" type="range" min="1" max="7" value="3" /></div></div><button class="btn btn-primary btn-sm" id="cs-git-merge">Merge branch</button><div class="metrics"><div class="metric"><div class="l">BRANCHES</div><div class="v mono" id="cs-git-branches">2</div></div><div class="metric"><div class="l">STATUS</div><div class="v cs-small" id="cs-git-status">ready</div></div></div></aside>
    </div>
  </div>

  <div id="panel-api" style="display:none">
    <div class="pg">
      <section class="glass cs-workbench" aria-labelledby="cs-api-heading"><h4 id="cs-api-heading" class="cs-kicker">Send an API request</h4><div class="cs-request"><span id="cs-api-method-label">GET</span><code id="cs-api-url">/v1/models</code></div><pre class="cs-console cs-response" id="cs-api-response" aria-live="polite">Waiting for a request…</pre></section>
      <aside class="pg-panel"><div class="ctrl"><h4>Method</h4><div class="seg" id="cs-api-method"><button class="active" data-v="GET">GET</button><button data-v="POST">POST</button><button data-v="DELETE">DELETE</button></div></div><div class="ctrl"><label for="cs-api-endpoint">Endpoint</label><select id="cs-api-endpoint"><option value="models">/v1/models</option><option value="predict">/v1/predict</option><option value="jobs">/v1/jobs/42</option></select></div><label class="cs-check"><input id="cs-api-auth" type="checkbox" checked /> Include bearer token</label><button class="btn btn-primary btn-sm" id="cs-api-send">Send request</button><div class="metrics"><div class="metric"><div class="l">STATUS</div><div class="v mono" id="cs-api-status">—</div></div><div class="metric"><div class="l">LATENCY</div><div class="v mono" id="cs-api-latency">—</div></div></div></aside>
    </div>
  </div>

  <div id="panel-containers" style="display:none">
    <div class="pg">
      <section class="glass cs-workbench" aria-labelledby="cs-container-heading"><h4 id="cs-container-heading" class="cs-kicker">Package and scale a service</h4><div class="cs-containers" id="cs-container-grid" aria-live="polite"></div><pre class="cs-console cs-query" id="cs-dockerfile"></pre></section>
      <aside class="pg-panel"><div class="ctrl"><div class="field"><label for="cs-container-replicas">Replicas <span class="val" id="cs-container-replicas-v">2</span></label><input id="cs-container-replicas" type="range" min="1" max="6" value="2" /></div><div class="field"><label for="cs-container-memory">Memory each <span class="val" id="cs-container-memory-v">512 MB</span></label><input id="cs-container-memory" type="range" min="256" max="2048" step="256" value="512" /></div></div><div class="ctrl"><h4>Image profile</h4><div class="seg" id="cs-container-image"><button class="active" data-v="slim">Slim</button><button data-v="standard">Standard</button><button data-v="gpu">GPU</button></div></div><div class="metrics"><div class="metric"><div class="l">TOTAL MEMORY</div><div class="v mono" id="cs-container-total">—</div></div><div class="metric"><div class="l">IMAGE SIZE</div><div class="v mono" id="cs-container-size">—</div></div></div></aside>
    </div>
  </div>

  <div id="panel-compute" style="display:none">
    <div class="pg">
      <section class="glass cs-workbench" aria-labelledby="cs-compute-heading"><h4 id="cs-compute-heading" class="cs-kicker">Match workload to hardware</h4><div class="cs-hardware" id="cs-hardware"><span id="cs-hardware-chip">GPU</span><strong id="cs-hardware-name">NVIDIA L4</strong><p class="note" id="cs-hardware-note"></p></div><div class="cs-meter"><i id="cs-compute-meter"></i></div></section>
      <aside class="pg-panel"><div class="ctrl"><h4>Workload</h4><div class="seg" id="cs-compute-workload"><button class="active" data-v="train">Training</button><button data-v="batch">Batch</button><button data-v="realtime">Realtime</button></div></div><div class="ctrl"><div class="field"><label for="cs-compute-model">Model size <span class="val" id="cs-compute-model-v">7B</span></label><input id="cs-compute-model" type="range" min="1" max="70" value="7" /></div><div class="field"><label for="cs-compute-users">Concurrent jobs <span class="val" id="cs-compute-users-v">4</span></label><input id="cs-compute-users" type="range" min="1" max="32" value="4" /></div></div><div class="metrics"><div class="metric"><div class="l">VRAM NEED</div><div class="v mono" id="cs-compute-vram">—</div></div><div class="metric"><div class="l">RELATIVE COST</div><div class="v mono" id="cs-compute-cost">—</div></div></div></aside>
    </div>
  </div>

  <div id="panel-test" style="display:none">
    <div class="pg">
      <section class="glass cs-workbench" aria-labelledby="cs-test-heading"><h4 id="cs-test-heading" class="cs-kicker">Run a layered test suite</h4><div class="cs-test-list" id="cs-test-list" aria-live="polite"></div></section>
      <aside class="pg-panel"><div class="ctrl"><h4>Injected fault</h4><div class="seg" id="cs-test-fault"><button class="active" data-v="none">None</button><button data-v="data">Bad data</button><button data-v="api">API timeout</button></div></div><div class="ctrl"><div class="field"><label for="cs-test-coverage">Test coverage <span class="val" id="cs-test-coverage-v">70%</span></label><input id="cs-test-coverage" type="range" min="20" max="100" step="10" value="70" /></div></div><button class="btn btn-primary btn-sm" id="cs-test-run">Run test suite</button><div class="metrics"><div class="metric"><div class="l">PASSED</div><div class="v mono" id="cs-test-passed">—</div></div><div class="metric"><div class="l">RELEASE</div><div class="v cs-small" id="cs-test-release">waiting</div></div></div><p class="note" id="cs-test-note">Unit, integration, data, and smoke tests catch different failure modes.</p></aside>
    </div>
  </div>
</div>

<style is:global>
  .code-stack .cs-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px;flex-wrap:wrap}.code-stack .cs-language-switch{display:flex;gap:8px;flex-wrap:wrap}.code-stack .cs-language{display:flex;align-items:center;gap:9px;padding:10px 14px;border-radius:11px;border:1px solid var(--stroke);background:var(--glass-2);color:var(--ink-soft);font:600 14px var(--sans);cursor:pointer;transition:border-color .18s,color .18s,transform .18s}.code-stack .cs-language:hover{color:var(--ink);transform:translateY(-1px)}.code-stack .cs-language.active{border-color:var(--indigo-lt);color:var(--ink);background:#e9eefb}.code-stack .cs-logo{width:24px;height:24px;border-radius:7px;display:grid;place-items:center;font-size:11px;font-weight:700}.code-stack .cs-logo.python{background:#3776ab;color:#ffd43b}.code-stack .cs-logo.r{background:#276dc3;color:#fff}.code-stack .cs-logo.go{background:#00add8;color:#fff}.code-stack .cs-learn-grid{display:grid;grid-template-columns:230px 1fr;gap:18px;align-items:start}.code-stack .cs-lessons{padding:14px;border-radius:var(--r-lg)}.code-stack .cs-label{font:600 12px var(--mono);text-transform:uppercase;color:var(--ink-mute);margin:0}.code-stack .cs-lessons .cs-label{padding:6px 8px 10px}.code-stack #cs-lesson-list{display:flex;flex-direction:column;gap:4px}.code-stack .cs-lesson{display:flex;align-items:center;gap:10px;text-align:left;padding:10px 12px;border-radius:10px;border:1px solid transparent;background:transparent;color:var(--ink-soft);font:500 13.5px var(--sans);cursor:pointer;transition:background .18s,color .18s,border-color .18s}.code-stack .cs-lesson:hover{background:var(--glass-2);color:var(--ink)}.code-stack .cs-lesson.active{background:rgba(37,99,235,.12);color:var(--ink);border-color:var(--stroke-acc)}.code-stack .cs-lesson-number{width:18px;font:11px var(--mono);color:var(--ink-mute)}.code-stack .cs-lesson.done .cs-lesson-number{color:var(--emerald)}.code-stack .cs-brief{padding:16px 18px;border-radius:var(--r);margin-bottom:14px}.code-stack .cs-brief h3{font-size:16px}.code-stack .cs-brief p{margin:6px 0 0;font-size:13.5px}.code-stack .cs-code-area{background:#0a0a13;border:1px solid #343746;border-radius:14px;overflow:hidden}.code-stack .cs-code-head{display:flex;align-items:center;gap:8px;padding:10px 14px;border-bottom:1px solid #343746}.code-stack .cs-window-dot{width:11px;height:11px;border-radius:50%}.code-stack .cs-window-dot.rose{background:#fb7185}.code-stack .cs-window-dot.amber{background:#f59e0b}.code-stack .cs-window-dot.green{background:#34d399}.code-stack #cs-file{margin-left:8px;color:#a8aec3}.code-stack .cs-edit-note{margin-left:auto;color:#a8aec3;font-size:11px}.code-stack .cs-editor{width:100%;min-height:230px;resize:vertical;border:0;outline:0;background:#0a0a13;color:#e5e7f2;font:13.5px/1.7 var(--mono);padding:16px 18px;display:block;tab-size:4}.code-stack .cs-editor:focus-visible{box-shadow:inset 0 0 0 2px var(--indigo-lt)}.code-stack .cs-actions{display:flex;gap:8px;margin-top:14px}.code-stack .cs-actions #cs-run{flex:1;justify-content:center}.code-stack .cs-console-head{margin:18px 0 10px}.code-stack .cs-console{margin:0;min-height:120px;padding:16px 18px;border:1px solid #343746;border-radius:14px;background:#06060c;color:#a7f3d0;font:13px/1.7 var(--mono);white-space:pre-wrap;overflow:auto}.code-stack .cs-workbench{padding:24px;border-radius:var(--r-lg);min-height:360px}.code-stack .cs-kicker{font:600 12px var(--mono);text-transform:uppercase;color:var(--ink-mute);margin-bottom:22px}.code-stack .cs-small{font-size:15px!important}.code-stack .ctrl>label{display:block;color:var(--ink-soft);font-size:13px;margin-bottom:8px}.code-stack select{width:100%;border:1px solid var(--stroke);border-radius:10px;padding:9px 10px;background:var(--glass-2);color:var(--ink)}.code-stack .cs-stack-flow{display:grid;gap:10px}.code-stack .cs-stack-item{display:grid;grid-template-columns:110px 1fr auto;align-items:center;gap:12px;padding:14px;border:1px solid var(--stroke);border-radius:12px;background:var(--glass-2)}.code-stack .cs-stack-item strong{font-size:14px}.code-stack .cs-stack-item code{font-size:11px;color:var(--ink-mute)}.code-stack .cs-badge{font:11px var(--mono);color:#9a6700}.code-stack .cs-db-choice,.code-stack .cs-hardware{display:flex;align-items:center;gap:18px;padding:22px;border:1px solid var(--stroke);border-radius:14px;background:var(--glass-2);margin-bottom:18px}.code-stack .cs-db-icon,.code-stack #cs-hardware-chip{display:grid;place-items:center;min-width:64px;height:64px;border-radius:14px;background:#fff4d6;color:#8a5800;font:700 14px var(--mono)}.code-stack .cs-db-choice strong,.code-stack .cs-hardware strong{font-size:20px}.code-stack .cs-db-choice p,.code-stack .cs-hardware p{margin:5px 0 0}.code-stack .cs-query{min-height:140px}.code-stack .cs-git-graph{display:flex;align-items:center;gap:8px;min-height:180px;overflow-x:auto;padding:22px 4px}.code-stack .cs-commit{display:flex;align-items:center;gap:8px;flex:0 0 auto}.code-stack .cs-commit i{width:18px;height:18px;border:4px solid #2563eb;border-radius:50%;background:#fff}.code-stack .cs-commit.branch i{border-color:#f59e0b}.code-stack .cs-commit span{width:34px;height:2px;background:var(--stroke-acc)}.code-stack .cs-command,.code-stack .cs-request{padding:14px 16px;border-radius:11px;background:#0a0a13;color:#dfe1ff;font:13px var(--mono)}.code-stack .cs-request{display:flex;gap:12px;margin-bottom:14px}.code-stack .cs-request span{color:#fbbf24;font-weight:700}.code-stack .cs-response{min-height:240px}.code-stack .cs-check{display:flex;align-items:center;gap:9px;color:var(--ink-soft);font-size:13px}.code-stack .cs-containers{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:18px}.code-stack .cs-container{min-height:86px;display:grid;place-items:center;border:1px solid #60a5fa;border-radius:12px;background:#eff6ff;color:#1d4ed8;font:600 12px var(--mono)}.code-stack .cs-meter{height:14px;border-radius:999px;background:var(--glass-2);border:1px solid var(--stroke);overflow:hidden;margin-top:28px}.code-stack .cs-meter i{display:block;height:100%;width:50%;background:#2563eb;transition:transform .18s;transform-origin:left}.code-stack .cs-test-list{display:grid;gap:10px}.code-stack .cs-test{display:grid;grid-template-columns:1fr auto;gap:12px;padding:14px 16px;border:1px solid var(--stroke);border-radius:12px;background:var(--glass-2)}.code-stack .cs-test span{font:12px var(--mono);color:var(--ink-mute)}.code-stack .cs-test.pass span{color:#067647}.code-stack .cs-test.fail{border-color:#fda29b}.code-stack .cs-test.fail span{color:#b42318}@media(max-width:900px){.code-stack .cs-learn-grid{grid-template-columns:1fr}.code-stack .cs-edit-note{display:none}.code-stack .cs-stack-item{grid-template-columns:1fr}.code-stack .cs-containers{grid-template-columns:repeat(2,1fr)}}@media(prefers-reduced-motion:reduce){.code-stack *{transition-duration:.01ms!important}}
</style>

<script>
  const root = document.querySelector('.code-stack');
  if (root) {
    const get = (id: string) => document.getElementById(id)!;
    const input = (id: string) => get(id) as HTMLInputElement;
    const set = (id: string, value: string) => { get(id).textContent = value; };
    const selected = (id: string) => (get(id).querySelector('button.active') as HTMLButtonElement).dataset.v!;
    const segment = (id: string, render: () => void) => {
      const group = get(id);
      group.querySelectorAll('button').forEach((button) => button.setAttribute('aria-pressed', String(button.classList.contains('active'))));
      group.addEventListener('click', (event) => {
        const button = (event.target as Element).closest('button'); if (!button) return;
        group.querySelectorAll('button').forEach((item) => { const on = item === button; item.classList.toggle('active', on); item.setAttribute('aria-pressed', String(on)); }); render();
      });
    };
    const watch = (ids: string[], render: () => void) => ids.forEach((id) => input(id).addEventListener('input', render));

    const learn = (window as any).LEARN;
    if (learn) {
      let language = 'python', lessonIndex = 0;
      const complete: Record<string, Set<number>> = { python: new Set(), r: new Set(), go: new Set() };
      const editor = get('cs-editor') as HTMLTextAreaElement, consoleEl = get('cs-console');
      const current = () => learn.LESSONS[language][lessonIndex];
      const runtime = (message: string, tone = 'amber') => { const dot = document.createElement('span'); dot.className = `dot ${tone}`; get('cs-runtime').replaceChildren(dot, document.createTextNode(message)); };
      const renderLessons = () => {
        get('cs-lesson-list').replaceChildren(...learn.LESSONS[language].map((lesson: any, index: number) => { const button = document.createElement('button'), number = document.createElement('span'); button.className = `cs-lesson${index === lessonIndex ? ' active' : ''}${complete[language].has(index) ? ' done' : ''}`; button.dataset.index = String(index); button.setAttribute('aria-current', index === lessonIndex ? 'true' : 'false'); number.className = 'cs-lesson-number'; number.textContent = complete[language].has(index) ? '✓' : String(index + 1); button.append(number, document.createTextNode(lesson.t)); return button; }));
      };
      const loadLesson = (index: number) => { lessonIndex = index; const lesson = current(); set('cs-file', learn.TRACKS[language].file); set('cs-lesson-title', lesson.t); set('cs-lesson-index', `lesson ${index + 1} / ${learn.LESSONS[language].length}`); set('cs-lesson-brief', lesson.brief); editor.value = lesson.code; consoleEl.textContent = '$ ready — press Run'; set('cs-language-meta', language === 'python' ? 'CPython · Pyodide' : language === 'r' ? 'R 4.4 · preview' : 'Go 1.23 · preview'); renderLessons(); };
      const loadLanguage = () => { lessonIndex = 0; get('cs-languages').querySelectorAll('button').forEach((button) => { const on = (button as HTMLButtonElement).dataset.language === language; button.classList.toggle('active', on); button.setAttribute('aria-pressed', String(on)); }); runtime(language === 'python' ? (learn.hasPyodide() ? 'Python runtime ready' : 'Python runtime idle') : `${learn.TRACKS[language].name} · preview mode`, language === 'python' && learn.hasPyodide() ? 'emerald' : 'amber'); loadLesson(0); };
      get('cs-languages').addEventListener('click', (event) => { const button = (event.target as Element).closest('button') as HTMLButtonElement | null; if (!button) return; language = button.dataset.language!; loadLanguage(); });
      get('cs-lesson-list').addEventListener('click', (event) => { const button = (event.target as Element).closest('button') as HTMLButtonElement | null; if (button) loadLesson(Number(button.dataset.index)); });
      get('cs-reset').addEventListener('click', () => { editor.value = current().code; consoleEl.textContent = '$ reset'; });
      const finish = (text: string) => { consoleEl.textContent = `$ ${learn.TRACKS[language].file}\n${text.replace(/\n+$/, '')}\n[done] exit 0`; complete[language].add(lessonIndex); renderLessons(); };
      const run = async () => { const lesson = current(); if (language === 'python' && !lesson.preview) { consoleEl.textContent = '$ starting Python…'; runtime('starting Python…'); const result = await learn.runPython(editor.value, (out: string) => finish(out), (status: string) => { runtime(status); consoleEl.textContent = `$ ${status}`; }); if (result.fallback) { finish(`Browser runtime unavailable. Reference output:\n${lesson.out || lesson.expect || ''}`); runtime('offline · reference output shown'); } else runtime('Python runtime ready', 'emerald'); return; } consoleEl.textContent = `$ ${learn.TRACKS[language].file}\n${lesson.out || lesson.expect || ''}\n[done] exit 0`; complete[language].add(lessonIndex); renderLessons(); };
      get('cs-run').addEventListener('click', run); get('cs-check').addEventListener('click', () => { const expected = String(current().out || current().expect || '').trim().split('\n')[0]; consoleEl.textContent += expected && consoleEl.textContent?.includes(expected) ? '\n✓ Output matches the lesson goal.' : '\n↻ Run your code first, then check.'; });
      editor.addEventListener('keydown', (event) => { if (event.key === 'Tab') { event.preventDefault(); const start = editor.selectionStart, end = editor.selectionEnd; editor.setRangeText('    ', start, end, 'end'); } if ((event.metaKey || event.ctrlKey) && event.key === 'Enter') run(); }); loadLanguage();
    }

    const libData: Record<string, Record<string, {core:string; note:string; stack:string[]}>> = { analysis:{notebook:{core:'pandas',note:'A compact exploratory stack for cleaning, plotting, and notebook work.',stack:['NumPy · arrays','pandas · tables','seaborn · charts','Jupyter · workspace']},api:{core:'pandas',note:'Add validation and a lightweight API around repeatable analysis.',stack:['pandas · transforms','Pydantic · schemas','FastAPI · service','Docker · runtime']},edge:{core:'Polars',note:'Prefer a small, fast dataframe engine when memory is constrained.',stack:['Polars · tables','Arrow · memory','DuckDB · queries']}},classic:{notebook:{core:'scikit-learn',note:'Pipelines keep preprocessing and estimators reproducible.',stack:['pandas · features','scikit-learn · model','joblib · artifact','MLflow · tracking']},api:{core:'scikit-learn',note:'Serve a serialized pipeline behind a typed endpoint.',stack:['scikit-learn · model','joblib · artifact','FastAPI · service','Docker · runtime']},edge:{core:'ONNX Runtime',note:'Export the fitted model to a portable optimized graph.',stack:['scikit-learn · train','ONNX · export','ONNX Runtime · infer']}},deep:{notebook:{core:'PyTorch',note:'A research-friendly stack with tensors, autograd, and experiment tracking.',stack:['PyTorch · model','Lightning · loops','W&B · tracking','Jupyter · workspace']},api:{core:'PyTorch',note:'Batch requests and serve an optimized model process.',stack:['PyTorch · model','TorchScript · optimize','FastAPI · service','Docker · runtime']},edge:{core:'TensorFlow Lite',note:'Quantize and package the network for mobile or embedded inference.',stack:['Keras · train','TFLite · convert','Delegate · accelerate']}}};
    const renderLibs = () => { const data = libData[selected('cs-lib-goal')][selected('cs-lib-target')]; get('cs-stack-flow').replaceChildren(...data.stack.map((item, index) => { const [name, role] = item.split(' · '), row = document.createElement('div'), label = document.createElement('span'), code = document.createElement('code'), badge = document.createElement('span'); row.className = 'cs-stack-item'; label.textContent = `${index + 1}. ${name}`; code.textContent = role; badge.className = 'cs-badge'; badge.textContent = index === 0 ? 'foundation' : 'layer'; row.append(label, code, badge); return row; })); set('cs-lib-core', data.core); set('cs-lib-size', String(data.stack.length)); set('cs-lib-note', data.note); };
    segment('cs-lib-goal', renderLibs); segment('cs-lib-target', renderLibs); renderLibs();

    const renderDb = () => { const relations = +input('cs-db-relations').value, change = +input('cs-db-change').value, search = +input('cs-db-search').value; set('cs-db-relations-v', `${relations}%`); set('cs-db-change-v', `${change}%`); set('cs-db-search-v', `${search}%`); let db = 'PostgreSQL', icon = 'SQL', reason = 'Strong relationships and transactional consistency favour a relational schema.', model = 'relational', consistency = 'strong', query = 'SELECT customer_id, SUM(total)\nFROM orders\nGROUP BY customer_id;'; if (search > 65) { db = 'Vector database'; icon = 'VEC'; reason = 'Semantic retrieval dominates this workload; store embeddings with metadata filters.'; model = 'vectors'; consistency = 'tunable'; query = 'index.query(\n  vector=embed(question),\n  top_k=5, filter={"team":"ai"}\n)'; } else if (change > 60 && relations < 55) { db = 'Document database'; icon = '{ }'; reason = 'Fast-changing nested records fit documents without frequent schema migrations.'; model = 'document'; consistency = 'tunable'; query = 'db.events.find({\n  type: "prediction",\n  "model.stage": "prod"\n})'; } set('cs-db-name', db); set('cs-db-icon', icon); set('cs-db-reason', reason); set('cs-db-model', model); set('cs-db-consistency', consistency); set('cs-db-query', query); };
    watch(['cs-db-relations','cs-db-change','cs-db-search'], renderDb); renderDb();

    let merged = false; const renderGit = () => { const count = +input('cs-git-commits').value, strategy = selected('cs-git-strategy'); set('cs-git-commits-v', String(count)); const graph = get('cs-git-graph'); graph.replaceChildren(...Array.from({length:count + 2}, (_, index) => { const item = document.createElement('div'), dot = document.createElement('i'); item.className = `cs-commit${index > 1 && !merged ? ' branch' : ''}`; item.append(dot); if (index < count + 1) item.append(document.createElement('span')); return item; })); set('cs-git-command', merged ? `git merge ${strategy}/model-update\n✓ fast-forwarded ${count} commits` : `git switch -c ${strategy}/model-update\ngit commit × ${count}`); set('cs-git-branches', merged ? '1' : strategy === 'release' ? '3' : '2'); set('cs-git-status', merged ? 'merged' : 'ready'); };
    segment('cs-git-strategy', () => { merged = false; renderGit(); }); watch(['cs-git-commits'], () => { merged = false; renderGit(); }); get('cs-git-merge').addEventListener('click', () => { merged = true; renderGit(); }); renderGit();

    const updateApiUrl = () => { set('cs-api-method-label', selected('cs-api-method')); set('cs-api-url', `/v1/${(get('cs-api-endpoint') as HTMLSelectElement).value}${(get('cs-api-endpoint') as HTMLSelectElement).value === 'jobs' ? '/42' : ''}`); };
    segment('cs-api-method', updateApiUrl); get('cs-api-endpoint').addEventListener('change', updateApiUrl); get('cs-api-send').addEventListener('click', () => { const method = selected('cs-api-method'), endpoint = (get('cs-api-endpoint') as HTMLSelectElement).value, auth = input('cs-api-auth').checked, status = !auth ? 401 : method === 'DELETE' && endpoint === 'models' ? 405 : method === 'POST' && endpoint === 'predict' ? 201 : 200; set('cs-api-status', String(status)); set('cs-api-latency', `${38 + endpoint.length * 7} ms`); set('cs-api-response', status === 401 ? '{\n  "error": "Missing bearer token",\n  "reference": "Add Authorization: Bearer <token>"\n}' : status === 405 ? '{\n  "error": "Method not allowed",\n  "allowed": ["GET"]\n}' : `{\n  "status": "ok",\n  "method": "${method}",\n  "resource": "${endpoint}"\n}`); }); updateApiUrl();

    const renderContainers = () => { const replicas = +input('cs-container-replicas').value, memory = +input('cs-container-memory').value, profile = selected('cs-container-image'), sizes:Record<string,number> = {slim:180,standard:620,gpu:3800}; set('cs-container-replicas-v', String(replicas)); set('cs-container-memory-v', `${memory} MB`); get('cs-container-grid').replaceChildren(...Array.from({length:replicas}, (_, index) => { const box = document.createElement('div'); box.className = 'cs-container'; box.textContent = `api-${index + 1}\n${memory} MB`; return box; })); set('cs-container-total', `${(replicas * memory / 1024).toFixed(1)} GB`); set('cs-container-size', sizes[profile] >= 1000 ? `${(sizes[profile]/1000).toFixed(1)} GB` : `${sizes[profile]} MB`); set('cs-dockerfile', profile === 'gpu' ? 'FROM nvidia/cuda:12-runtime\nCOPY model /app/model\nCMD ["python", "serve.py"]' : `FROM python:3.12-${profile === 'slim' ? 'slim' : 'bookworm'}\nCOPY . /app\nRUN pip install -r requirements.txt\nCMD ["python", "serve.py"]`); };
    segment('cs-container-image', renderContainers); watch(['cs-container-replicas','cs-container-memory'], renderContainers); renderContainers();

    const renderCompute = () => { const model = +input('cs-compute-model').value, jobs = +input('cs-compute-users').value, workload = selected('cs-compute-workload'), vram = Math.ceil(model * (workload === 'train' ? 6 : 2) + jobs * .5); set('cs-compute-model-v', `${model}B`); set('cs-compute-users-v', String(jobs)); let chip = 'CPU', name = 'Compute-optimized CPU', note = 'Cost-efficient for small batch models and preprocessing.', cost = '1×'; if (vram > 16 || workload === 'train') { chip = vram > 80 ? 'MULTI' : 'GPU'; name = vram > 80 ? 'Multi-GPU node' : workload === 'realtime' ? 'NVIDIA L4' : 'NVIDIA A100'; note = vram > 80 ? 'Shard model weights or use quantization to fit across accelerators.' : 'An accelerator provides the required tensor throughput and memory bandwidth.'; cost = vram > 80 ? '12×' : '5×'; } set('cs-hardware-chip', chip); set('cs-hardware-name', name); set('cs-hardware-note', note); set('cs-compute-vram', `${vram} GB`); set('cs-compute-cost', cost); get('cs-compute-meter').style.transform = `scaleX(${Math.min(1, vram / 160)})`; };
    segment('cs-compute-workload', renderCompute); watch(['cs-compute-model','cs-compute-users'], renderCompute); renderCompute();

    const tests = ['Unit · feature transforms','Data · schema contract','Integration · prediction API','Smoke · deployed service']; const renderTests = (ran = false) => { const fault = selected('cs-test-fault'), coverage = +input('cs-test-coverage').value, caught = fault === 'data' ? 1 : fault === 'api' ? 2 : -1; set('cs-test-coverage-v', `${coverage}%`); let passed = 0; get('cs-test-list').replaceChildren(...tests.map((name, index) => { const row = document.createElement('div'), status = document.createElement('span'), fails = ran && index === caught && coverage >= (index + 1) * 20; row.className = `cs-test${ran ? fails ? ' fail' : ' pass' : ''}`; status.textContent = ran ? fails ? 'FAIL' : 'PASS' : 'WAITING'; if (ran && !fails) passed++; row.append(document.createTextNode(name), status); return row; })); set('cs-test-passed', ran ? `${passed}/4` : '—'); set('cs-test-release', !ran ? 'waiting' : passed === 4 ? 'ready' : 'blocked'); set('cs-test-note', ran && caught >= 0 && coverage < (caught + 1) * 20 ? 'The injected fault escaped this coverage level. Add a targeted regression test.' : ran && passed < 4 ? 'The suite caught the fault and blocked the release.' : 'Unit, integration, data, and smoke tests catch different failure modes.'); };
    segment('cs-test-fault', () => renderTests(false)); watch(['cs-test-coverage'], () => renderTests(false)); get('cs-test-run').addEventListener('click', () => renderTests(true)); renderTests();
  }
</script>
