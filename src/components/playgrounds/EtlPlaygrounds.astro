<div class="etl-labs">
  <div id="panel-etl"><div class="pg et-grid"><section class="pg-stage et-stage" aria-labelledby="et-dag-heading"><h4 id="et-dag-heading" class="sr-only">ETL directed acyclic graph</h4><div class="stage-bar"><button class="iconbtn primary" id="et-dag-run" aria-label="Start data flow"><span id="et-dag-run-icon" aria-hidden="true">▶</span></button><div class="spacer"></div><span class="pill" id="et-dag-status" role="status">idle</span></div><canvas id="et-dag-canvas" role="img" aria-label="Animated data flow from API and Kafka sources through cleaning, joining, aggregation, and a warehouse"></canvas></section><aside class="pg-panel"><div class="ctrl"><div class="field"><label for="et-dag-rate">Throughput <span class="val" id="et-dag-rate-v">8k/s</span></label><input id="et-dag-rate" type="range" min="1" max="20" value="8" /></div><p class="note">Records are limited by the slowest stage—the pipeline bottleneck.</p></div><div class="ctrl"><h4>Pipeline stages</h4><ol class="et-stage-list" id="et-dag-stages"></ol></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">RECORDS</div><div class="v mono" id="et-dag-records">0</div></div><div class="metric"><div class="l">LATENCY</div><div class="v mono" id="et-dag-latency">—</div></div></div></aside></div></div>

  <div id="panel-ingest" style="display:none"><div class="pg et-grid"><section class="glass et-workbench" aria-labelledby="et-ingest-heading"><h4 id="et-ingest-heading" class="et-kicker">Batch and streaming ingestion</h4><div class="et-ingest-flow" id="et-ingest-flow" aria-live="polite"></div></section><aside class="pg-panel"><div class="ctrl"><h4>Ingestion mode</h4><div class="seg" id="et-ingest-mode"><button class="active" data-v="batch">Batch</button><button data-v="micro">Micro-batch</button><button data-v="stream">Streaming</button></div></div><div class="ctrl"><div class="field"><label for="et-ingest-volume">Event volume <span class="val" id="et-ingest-volume-v">25k/min</span></label><input id="et-ingest-volume" type="range" min="5" max="100" step="5" value="25" /></div><div class="field"><label for="et-ingest-window">Delivery window <span class="val" id="et-ingest-window-v">15 min</span></label><input id="et-ingest-window" type="range" min="1" max="60" value="15" /></div></div><div class="metrics"><div class="metric"><div class="l">FRESHNESS</div><div class="v mono" id="et-ingest-freshness">—</div></div><div class="metric"><div class="l">TOOL</div><div class="v et-small" id="et-ingest-tool">—</div></div></div><p class="note" id="et-ingest-note"></p></aside></div></div>

  <div id="panel-transform" style="display:none"><div class="pg et-grid"><section class="glass et-workbench" aria-labelledby="et-transform-heading"><h4 id="et-transform-heading" class="et-kicker">Transform raw records into trusted rows</h4><table class="et-table"><thead><tr><th>customer_id</th><th>region</th><th>amount</th><th>quality</th></tr></thead><tbody id="et-transform-table"></tbody></table></section><aside class="pg-panel"><fieldset class="ctrl et-fieldset"><legend>Transform steps</legend><label><input id="et-transform-null" type="checkbox" checked /> Fill missing regions</label><label><input id="et-transform-dedupe" type="checkbox" checked /> Remove duplicate IDs</label><label><input id="et-transform-type" type="checkbox" /> Cast amount to number</label></fieldset><button class="btn btn-primary btn-sm" id="et-transform-run">Apply transforms</button><div class="metrics"><div class="metric"><div class="l">OUTPUT ROWS</div><div class="v mono" id="et-transform-rows">—</div></div><div class="metric"><div class="l">VALID ROWS</div><div class="v mono" id="et-transform-valid">—</div></div></div><p class="note" id="et-transform-note" aria-live="polite">Choose steps, then apply the transformation.</p></aside></div></div>

  <div id="panel-warehouse" style="display:none"><div class="pg et-grid"><section class="glass et-workbench" aria-labelledby="et-warehouse-heading"><h4 id="et-warehouse-heading" class="et-kicker">Model analytics data</h4><div class="et-schema" id="et-schema" role="img" aria-label="Warehouse schema diagram"></div></section><aside class="pg-panel"><div class="ctrl"><h4>Model</h4><div class="seg" id="et-warehouse-model"><button class="active" data-v="star">Star</button><button data-v="snowflake">Snowflake</button><button data-v="wide">Wide table</button></div></div><div class="ctrl"><div class="field"><label for="et-warehouse-dims">Dimensions <span class="val" id="et-warehouse-dims-v">3</span></label><input id="et-warehouse-dims" type="range" min="2" max="6" value="3" /></div></div><div class="metrics"><div class="metric"><div class="l">JOINS / QUERY</div><div class="v mono" id="et-warehouse-joins">—</div></div><div class="metric"><div class="l">REDUNDANCY</div><div class="v et-small" id="et-warehouse-redundancy">—</div></div></div><p class="note" id="et-warehouse-note"></p></aside></div></div>

  <div id="panel-spark" style="display:none"><div class="pg et-grid"><section class="glass et-workbench" aria-labelledby="et-spark-heading"><h4 id="et-spark-heading" class="et-kicker">Partition work across a cluster</h4><div class="et-workers" id="et-spark-workers" aria-live="polite"></div></section><aside class="pg-panel"><div class="ctrl"><div class="field"><label for="et-spark-data">Dataset size <span class="val" id="et-spark-data-v">500 GB</span></label><input id="et-spark-data" type="range" min="100" max="3000" step="100" value="500" /></div><div class="field"><label for="et-spark-workers-count">Workers <span class="val" id="et-spark-workers-v">4</span></label><input id="et-spark-workers-count" type="range" min="2" max="12" value="4" /></div><div class="field"><label for="et-spark-skew">Key skew <span class="val" id="et-spark-skew-v">20%</span></label><input id="et-spark-skew" type="range" min="0" max="90" value="20" /></div></div><div class="metrics"><div class="metric"><div class="l">SLOWEST TASK</div><div class="v mono" id="et-spark-slowest">—</div></div><div class="metric"><div class="l">EFFICIENCY</div><div class="v mono" id="et-spark-efficiency">—</div></div></div></aside></div></div>

  <div id="panel-orchestrate" style="display:none"><div class="pg et-grid"><section class="glass et-workbench" aria-labelledby="et-orch-heading"><h4 id="et-orch-heading" class="et-kicker">Schedule, retry, and recover tasks</h4><div class="et-timeline" id="et-orch-timeline" aria-live="polite"></div></section><aside class="pg-panel"><div class="ctrl"><h4>Failure point</h4><div class="seg" id="et-orch-failure"><button class="active" data-v="none">None</button><button data-v="transform">Transform</button><button data-v="load">Load</button></div></div><div class="ctrl"><div class="field"><label for="et-orch-retries">Retry limit <span class="val" id="et-orch-retries-v">2</span></label><input id="et-orch-retries" type="range" min="0" max="4" value="2" /></div></div><button class="btn btn-primary btn-sm" id="et-orch-run">Run workflow</button><div class="metrics"><div class="metric"><div class="l">RUN STATE</div><div class="v et-small" id="et-orch-state">ready</div></div><div class="metric"><div class="l">ATTEMPTS</div><div class="v mono" id="et-orch-attempts">—</div></div></div><p class="note" id="et-orch-note">An orchestrator records dependencies, retries, schedules, and task history.</p></aside></div></div>

  <div id="panel-quality" style="display:none"><div class="pg et-grid"><section class="glass et-workbench" aria-labelledby="et-quality-heading"><h4 id="et-quality-heading" class="et-kicker">Test a dataset contract</h4><div class="et-quality-list" id="et-quality-list" aria-live="polite"></div></section><aside class="pg-panel"><div class="ctrl"><h4>Incoming dataset</h4><div class="seg" id="et-quality-dataset"><button class="active" data-v="clean">Clean</button><button data-v="nulls">Null spike</button><button data-v="drift">Schema drift</button></div></div><div class="ctrl"><div class="field"><label for="et-quality-threshold">Null tolerance <span class="val" id="et-quality-threshold-v">5%</span></label><input id="et-quality-threshold" type="range" min="0" max="25" value="5" /></div></div><button class="btn btn-primary btn-sm" id="et-quality-run">Run checks</button><div class="metrics"><div class="metric"><div class="l">PASSED</div><div class="v mono" id="et-quality-passed">—</div></div><div class="metric"><div class="l">ACTION</div><div class="v et-small" id="et-quality-action">waiting</div></div></div></aside></div></div>

  <div id="panel-features" style="display:none"><div class="pg et-grid"><section class="glass et-workbench" aria-labelledby="et-feature-heading"><h4 id="et-feature-heading" class="et-kicker">Keep training and serving features aligned</h4><div class="et-feature-path"><div><span>OFFLINE</span><strong>warehouse</strong><small id="et-feature-offline">updated 24h ago</small></div><i aria-hidden="true">→</i><div><span>REGISTRY</span><strong id="et-feature-name">customer_risk_30d</strong><small>versioned definition</small></div><i aria-hidden="true">→</i><div><span>ONLINE</span><strong>low-latency store</strong><small id="et-feature-online">updated 5m ago</small></div></div></section><aside class="pg-panel"><div class="ctrl"><h4>Materialization</h4><div class="seg" id="et-feature-mode"><button class="active" data-v="batch">Batch</button><button data-v="stream">Streaming</button><button data-v="request">On request</button></div></div><div class="ctrl"><div class="field"><label for="et-feature-age">Source age <span class="val" id="et-feature-age-v">24h</span></label><input id="et-feature-age" type="range" min="1" max="72" value="24" /></div></div><div class="metrics"><div class="metric"><div class="l">SERVING LATENCY</div><div class="v mono" id="et-feature-latency">—</div></div><div class="metric"><div class="l">TRAIN / SERVE</div><div class="v et-small" id="et-feature-parity">—</div></div></div><p class="note" id="et-feature-note"></p></aside></div></div>
</div>

<style is:global>
  .et-grid{grid-template-columns:minmax(0,1fr) 340px}.et-stage{aspect-ratio:16/9;min-height:360px}.et-workbench{padding:26px;border-radius:var(--r-lg);min-height:360px;min-width:0}.et-kicker{font:12px var(--mono);text-transform:uppercase;color:var(--ink-mute);margin:0 0 20px}.et-small{font-size:14px!important}.et-stage-list{display:grid;gap:8px;margin:12px 0 0;padding:0;list-style:none}.et-stage-list li{display:grid;grid-template-columns:10px 1fr auto;gap:9px;align-items:center;color:var(--ink-soft);font-size:13px}.et-stage-list i{width:8px;height:8px;border-radius:50%;background:var(--stage-color)}.et-stage-list code{font-size:10px;color:var(--ink-mute)}.et-ingest-flow{display:grid;gap:12px}.et-flow-row{display:grid;grid-template-columns:90px 1fr 90px;gap:12px;align-items:center}.et-flow-row span,.et-flow-row output{font:11px var(--mono);color:var(--ink-soft)}.et-flow-row output{text-align:right}.et-flow-track{height:20px;border:1px solid var(--stroke);background:var(--surface);border-radius:6px;overflow:hidden}.et-flow-track i{display:block;width:100%;height:100%;background:var(--cyan);transform:scaleX(var(--fill));transform-origin:left;transition:transform .18s}.et-table{width:100%;border-collapse:collapse}.et-table th,.et-table td{padding:12px;border-bottom:1px solid var(--stroke);text-align:left;font:12px var(--mono)}.et-table th{color:var(--ink-mute)}.et-table tr.invalid td:last-child{color:#b42318}.et-table tr.valid td:last-child{color:#067647}.et-fieldset{border:0;margin:0;padding:0}.et-fieldset legend{font-weight:600;margin-bottom:12px}.et-fieldset label{display:flex;gap:9px;align-items:center;margin:11px 0;color:var(--ink-soft);font-size:13px}.et-schema{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;align-items:center;min-height:270px}.et-schema-card{padding:14px;border:1px solid var(--stroke);border-radius:12px;background:var(--glass-2);text-align:center}.et-schema-card.fact{border-color:var(--cyan);grid-column:2}.et-schema-card strong{font-size:13px}.et-schema-card small{display:block;margin-top:5px;color:var(--ink-mute);font:10px var(--mono)}.et-workers{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.et-worker{border:1px solid var(--stroke);border-radius:12px;padding:13px;background:var(--glass-2)}.et-worker strong{font:12px var(--mono)}.et-worker div{height:90px;margin-top:10px;display:flex;align-items:end;background:var(--surface);border-radius:7px;overflow:hidden}.et-worker i{display:block;width:100%;height:var(--load);background:var(--cyan);transform-origin:bottom}.et-worker output{display:block;margin-top:7px;font:10px var(--mono);color:var(--ink-mute)}.et-timeline,.et-quality-list{display:grid;gap:10px}.et-task,.et-check{display:grid;grid-template-columns:1fr auto;gap:12px;padding:14px 16px;border:1px solid var(--stroke);border-radius:12px;background:var(--glass-2)}.et-task span,.et-check span{font:11px var(--mono);color:var(--ink-mute)}.et-task.success span,.et-check.pass span{color:#067647}.et-task.failed,.et-check.fail{border-color:#fda29b}.et-task.failed span,.et-check.fail span{color:#b42318}.et-feature-path{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:12px;align-items:center;min-height:260px}.et-feature-path>div{padding:18px;border:1px solid var(--stroke);border-radius:13px;background:var(--glass-2);text-align:center}.et-feature-path span,.et-feature-path small{display:block;font:10px var(--mono);color:var(--ink-mute)}.et-feature-path strong{display:block;margin:8px 0;font-size:13px}.et-feature-path>i{color:var(--cyan);font-style:normal}@media(max-width:900px){.et-grid{grid-template-columns:1fr}.et-workers{grid-template-columns:repeat(3,1fr)}.et-feature-path{grid-template-columns:1fr}.et-feature-path>i{transform:rotate(90deg);text-align:center}}@media(max-width:560px){.et-workbench{padding:18px}.et-flow-row{grid-template-columns:70px 1fr}.et-flow-row output{grid-column:2}.et-workers{grid-template-columns:repeat(2,1fr)}}@media(prefers-reduced-motion:reduce){.etl-labs *{transition-duration:.01ms!important}}
</style>

<script>
  const byId=(id:string)=>document.getElementById(id)!;const slider=(id:string)=>byId(id) as HTMLInputElement;const put=(id:string,value:string)=>{byId(id).textContent=value};const active=(id:string)=>(byId(id).querySelector('button.active') as HTMLButtonElement).dataset.v!;function segment(id:string,render:()=>void){const group=byId(id);group.querySelectorAll('button').forEach(button=>button.setAttribute('aria-pressed',String(button.classList.contains('active'))));group.addEventListener('click',event=>{const button=(event.target as Element).closest('button');if(!button)return;group.querySelectorAll('button').forEach(item=>{const on=item===button;item.classList.toggle('active',on);item.setAttribute('aria-pressed',String(on))});render()})}const watch=(ids:string[],render:()=>void)=>ids.forEach(id=>slider(id).addEventListener('input',render));
  const canvas=byId('et-dag-canvas') as HTMLCanvasElement,ctx=canvas.getContext('2d')!,nodes=[{id:'api',x:.09,y:.28,label:'API',kind:'extract'},{id:'kafka',x:.09,y:.72,label:'Kafka',kind:'extract'},{id:'clean',x:.34,y:.28,label:'Clean',kind:'transform'},{id:'parse',x:.34,y:.72,label:'Parse',kind:'transform'},{id:'join',x:.58,y:.5,label:'Join',kind:'transform'},{id:'agg',x:.78,y:.5,label:'Aggregate',kind:'transform'},{id:'dw',x:.93,y:.5,label:'Warehouse',kind:'load'}],edges=[['api','clean'],['kafka','parse'],['clean','join'],['parse','join'],['join','agg'],['agg','dw']],colors:Record<string,string>={extract:'#0891b2',transform:'#4f46e5',load:'#059669'};let dagRunning=false,dagVisible=true,dagFrame=0,dagLast=0,dagRecords=0,pulses:{edge:string[],progress:number}[]=[];const node=(id:string)=>nodes.find(item=>item.id===id)!;function fit(){const rect=canvas.getBoundingClientRect(),dpr=Math.min(devicePixelRatio||1,2);if(!rect.width||!rect.height)return null;canvas.width=rect.width*dpr;canvas.height=rect.height*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);return rect}function rounded(x:number,y:number,w:number,h:number,r:number){ctx.beginPath();ctx.roundRect(x,y,w,h,r)}function drawDag(){const rect=fit();if(!rect)return;const W=rect.width,H=rect.height,point=(item:any)=>({x:item.x*W,y:item.y*H});ctx.clearRect(0,0,W,H);edges.forEach(([a,b])=>{const p=point(node(a)),q=point(node(b)),mid=(p.x+q.x)/2;ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.bezierCurveTo(mid,p.y,mid,q.y,q.x,q.y);ctx.strokeStyle='rgba(100,116,139,.35)';ctx.lineWidth=1.5;ctx.stroke()});pulses.forEach(pulse=>{const a=point(node(pulse.edge[0])),b=point(node(pulse.edge[1])),mid=(a.x+b.x)/2,t=pulse.progress,u=1-t,x=u*u*u*a.x+3*u*u*t*mid+3*u*t*t*mid+t*t*t*b.x,y=u*u*u*a.y+3*u*u*t*a.y+3*u*t*t*b.y+t*t*t*b.y;ctx.fillStyle='#0891b2';ctx.beginPath();ctx.arc(x,y,4,0,Math.PI*2);ctx.fill()});nodes.forEach(item=>{const p=point(item);rounded(p.x-36,p.y-19,72,38,9);ctx.fillStyle='#111827';ctx.fill();ctx.strokeStyle=colors[item.kind];ctx.lineWidth=1.5;ctx.stroke();ctx.fillStyle='#f8fafc';ctx.font='11px JetBrains Mono';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(item.label,p.x,p.y)})}function dagLoop(time:number){dagFrame=0;if(!dagRunning||!dagVisible||document.hidden)return;const dt=Math.min(50,time-(dagLast||time));dagLast=time;const rate=+slider('et-dag-rate').value;pulses.forEach(p=>p.progress+=dt*.00045*(1+rate/10));pulses=pulses.filter(p=>p.progress<1);if(Math.floor(time/Math.max(180,700-rate*20))!==Math.floor((time-dt)/Math.max(180,700-rate*20))){pulses.push({edge:edges[Math.floor(Math.random()*edges.length)],progress:0});dagRecords+=rate*125;put('et-dag-records',dagRecords.toLocaleString());put('et-dag-latency',`${Math.round(92-rate*2.5)}ms`)}drawDag();dagFrame=requestAnimationFrame(dagLoop)}function toggleDag(){dagRunning=!dagRunning;put('et-dag-run-icon',dagRunning?'Ⅱ':'▶');put('et-dag-status',dagRunning?'streaming':'idle');byId('et-dag-run').setAttribute('aria-label',dagRunning?'Pause data flow':'Start data flow');if(dagRunning){dagLast=0;dagFrame=requestAnimationFrame(dagLoop)}else{cancelAnimationFrame(dagFrame);dagFrame=0;pulses=[];drawDag()}}byId('et-dag-run').addEventListener('click',toggleDag);slider('et-dag-rate').addEventListener('input',()=>put('et-dag-rate-v',`${slider('et-dag-rate').value}k/s`));byId('et-dag-stages').replaceChildren(...nodes.map(item=>{const li=document.createElement('li'),dot=document.createElement('i'),kind=document.createElement('code');dot.style.setProperty('--stage-color',colors[item.kind]);kind.textContent=item.kind;li.append(dot,document.createTextNode(item.label),kind);return li}));new IntersectionObserver(([entry])=>{dagVisible=entry.isIntersecting;if(dagVisible&&dagRunning&&!dagFrame)dagFrame=requestAnimationFrame(dagLoop);else if(!dagVisible&&dagFrame){cancelAnimationFrame(dagFrame);dagFrame=0}},{rootMargin:'80px'}).observe(canvas);window.addEventListener('resize',drawDag);drawDag();
  function renderIngest(){const mode=active('et-ingest-mode'),volume=+slider('et-ingest-volume').value,windowSize=+slider('et-ingest-window').value,configs:Record<string,[string,string,string]>={batch:[`${windowSize} min`,'Object store','Lowest operational complexity for scheduled files.'],micro:[`${Math.max(1,Math.round(windowSize/4))} min`,'Spark','Small frequent batches balance freshness and cost.'],stream:['< 2 sec','Kafka','Continuous events provide the lowest latency with more operational state.']},sources=[['API',.68],['Database',.82],['Events',mode==='stream'?1:.48],['Files',mode==='batch'?1:.62]];byId('et-ingest-flow').replaceChildren(...sources.map(([name,base])=>{const row=document.createElement('div'),label=document.createElement('span'),track=document.createElement('div'),fill=document.createElement('i'),out=document.createElement('output');row.className='et-flow-row';label.textContent=String(name);track.className='et-flow-track';fill.style.setProperty('--fill',String(Math.min(1,Number(base)*volume/50)));track.append(fill);out.textContent=`${Math.round(Number(base)*volume)}k/min`;row.append(label,track,out);return row}));put('et-ingest-volume-v',`${volume}k/min`);put('et-ingest-window-v',`${windowSize} min`);put('et-ingest-freshness',configs[mode][0]);put('et-ingest-tool',configs[mode][1]);put('et-ingest-note',configs[mode][2])}segment('et-ingest-mode',renderIngest);watch(['et-ingest-volume','et-ingest-window'],renderIngest);renderIngest();
  const rawRows=[['C-101','North','120.50'],['C-102','','89'],['C-102','','89'],['C-103','West','unknown']];function renderTransform(applied=false){const fill=slider('et-transform-null').checked,dedupe=slider('et-transform-dedupe').checked,cast=slider('et-transform-type').checked,seen=new Set<string>(),rows=rawRows.filter(row=>{if(!applied||!dedupe)return true;if(seen.has(row[0]))return false;seen.add(row[0]);return true}).map(row=>{const next=[...row];if(applied&&fill&&!next[1])next[1]='Unknown';const valid=!applied||(!cast||!Number.isNaN(Number(next[2])))&&Boolean(next[1]);return{row:next,valid}});byId('et-transform-table').replaceChildren(...rows.map(item=>{const tr=document.createElement('tr');tr.className=item.valid?'valid':'invalid';item.row.forEach(cell=>{const td=document.createElement('td');td.textContent=cell||'NULL';tr.append(td)});const quality=document.createElement('td');quality.textContent=item.valid?'valid':'invalid';tr.append(quality);return tr}));const valid=rows.filter(item=>item.valid).length;put('et-transform-rows',applied?String(rows.length):'—');put('et-transform-valid',applied?`${valid}/${rows.length}`:'—');put('et-transform-note',!applied?'Choose steps, then apply the transformation.':valid===rows.length?'Every output row satisfies the selected rules.':'Some rows still violate the contract—inspect missing or invalid values.')}['et-transform-null','et-transform-dedupe','et-transform-type'].forEach(id=>slider(id).addEventListener('change',()=>renderTransform(false)));byId('et-transform-run').addEventListener('click',()=>renderTransform(true));renderTransform();
  function renderWarehouse(){const model=active('et-warehouse-model'),dimensions=+slider('et-warehouse-dims').value;put('et-warehouse-dims-v',String(dimensions));const root=byId('et-schema'),cards:string[]=[];if(model==='wide')cards.push('analytics_wide');else{cards.push('fact_sales');for(let i=1;i<=dimensions;i++)cards.push(`${model==='snowflake'&&i>3?'subdim':'dim'}_${['customer','product','date','region','channel','campaign'][i-1]}`)}root.replaceChildren(...cards.map((name,index)=>{const card=document.createElement('div'),strong=document.createElement('strong'),small=document.createElement('small');card.className=`et-schema-card${index===0&&model!=='wide'?' fact':''}`;strong.textContent=name;small.textContent=index===0?'measures & keys':model==='snowflake'&&index>3?'normalized lookup':'descriptive attributes';card.append(strong,small);return card}));put('et-warehouse-joins',model==='wide'?'0':model==='star'?String(dimensions):String(dimensions+2));put('et-warehouse-redundancy',model==='wide'?'high':model==='star'?'medium':'low');put('et-warehouse-note',model==='star'?'A central fact table keeps business measures consistent and dimensions easy to query.':model==='snowflake'?'Normalized dimensions reduce duplication but add joins and model complexity.':'A wide table is fast for a stable use case but duplicates attributes and is harder to govern.')}segment('et-warehouse-model',renderWarehouse);watch(['et-warehouse-dims'],renderWarehouse);renderWarehouse();
  function renderSpark(){const data=+slider('et-spark-data').value,workers=+slider('et-spark-workers-count').value,skew=+slider('et-spark-skew').value,loads=Array.from({length:workers},(_,i)=>data/workers*(i===0?1+skew/40:1-skew/200));put('et-spark-data-v',`${data} GB`);put('et-spark-workers-v',String(workers));put('et-spark-skew-v',`${skew}%`);byId('et-spark-workers').replaceChildren(...loads.map((load,index)=>{const card=document.createElement('div'),name=document.createElement('strong'),meter=document.createElement('div'),fill=document.createElement('i'),out=document.createElement('output');card.className='et-worker';name.textContent=`worker-${index+1}`;fill.style.setProperty('--load',`${Math.max(8,load/Math.max(...loads)*100)}%`);meter.append(fill);out.textContent=`${Math.round(load)} GB`;card.append(name,meter,out);return card}));put('et-spark-slowest',`${Math.ceil(Math.max(...loads)/18)} min`);put('et-spark-efficiency',`${Math.max(35,Math.round(100-skew*.65))}%`)}watch(['et-spark-data','et-spark-workers-count','et-spark-skew'],renderSpark);renderSpark();
  const orchTasks=['Extract sources','Transform models','Quality checks','Load warehouse'];function renderOrchestration(ran=false){const failure=active('et-orch-failure'),retries=+slider('et-orch-retries').value,failedIndex=failure==='transform'?1:failure==='load'?3:-1,recovered=ran&&failedIndex>=0&&retries>0;put('et-orch-retries-v',String(retries));byId('et-orch-timeline').replaceChildren(...orchTasks.map((name,index)=>{const task=document.createElement('div'),state=document.createElement('span'),failed=ran&&index===failedIndex&&!recovered;task.className=`et-task${ran?failed?' failed':' success':''}`;state.textContent=!ran?'WAITING':failed?'FAILED':index===failedIndex&&recovered?'RETRIED':'SUCCESS';task.append(document.createTextNode(name),state);return task}));put('et-orch-state',!ran?'ready':failedIndex<0||recovered?'success':'failed');put('et-orch-attempts',ran?String(orchTasks.length+(recovered?1:0)):'—');put('et-orch-note',!ran?'An orchestrator records dependencies, retries, schedules, and task history.':failedIndex<0?'Every dependent task completed in order.':recovered?'The failed task recovered on retry and downstream work continued.':'No retry was available, so downstream tasks were blocked.')}segment('et-orch-failure',()=>renderOrchestration(false));watch(['et-orch-retries'],()=>renderOrchestration(false));byId('et-orch-run').addEventListener('click',()=>renderOrchestration(true));renderOrchestration();
  const checks=['Schema matches contract','Primary key is unique','Required fields are present','Volume stays in range'];function renderQuality(ran=false){const dataset=active('et-quality-dataset'),threshold=+slider('et-quality-threshold').value,failed=dataset==='drift'?0:dataset==='nulls'&&threshold<18?2:-1,passed=ran?checks.length-(failed>=0?1:0):0;put('et-quality-threshold-v',`${threshold}%`);byId('et-quality-list').replaceChildren(...checks.map((name,index)=>{const row=document.createElement('div'),state=document.createElement('span'),bad=ran&&index===failed;row.className=`et-check${ran?bad?' fail':' pass':''}`;state.textContent=!ran?'WAITING':bad?'FAIL':'PASS';row.append(document.createTextNode(name),state);return row}));put('et-quality-passed',ran?`${passed}/4`:'—');put('et-quality-action',!ran?'waiting':passed===4?'publish':'quarantine')}segment('et-quality-dataset',()=>renderQuality(false));watch(['et-quality-threshold'],()=>renderQuality(false));byId('et-quality-run').addEventListener('click',()=>renderQuality(true));renderQuality();
  function renderFeatures(){const mode=active('et-feature-mode'),age=+slider('et-feature-age').value,config:Record<string,[string,string,string]>={batch:['8 ms',age<=24?'aligned':'stale','Scheduled materialization is simple, but freshness follows the batch cadence.'],stream:['12 ms','aligned','Streaming updates keep online values fresh with more infrastructure state.'],request:['85 ms','computed','On-request features are freshest but add computation to every prediction.']};put('et-feature-age-v',`${age}h`);put('et-feature-offline',`updated ${age}h ago`);put('et-feature-online',mode==='stream'?'updated seconds ago':mode==='request'?'computed now':'updated 5m ago');put('et-feature-latency',config[mode][0]);put('et-feature-parity',config[mode][1]);put('et-feature-note',config[mode][2])}segment('et-feature-mode',renderFeatures);watch(['et-feature-age'],renderFeatures);renderFeatures();
  const redraw:Record<string,()=>void>={etl:drawDag,ingest:renderIngest,transform:()=>renderTransform(false),warehouse:renderWarehouse,spark:renderSpark,orchestrate:()=>renderOrchestration(false),quality:()=>renderQuality(false),features:renderFeatures};document.addEventListener('etl:tab',event=>requestAnimationFrame(()=>redraw[(event as CustomEvent<string>).detail]?.()));
</script>
