<div class="research-labs">
  <div id="panel-research"><div class="pg rs-grid"><section class="pg-stage rs-stage" aria-labelledby="rs-bv-heading"><h4 id="rs-bv-heading" class="sr-only">Bias variance tradeoff chart</h4><div class="stage-bar"><span class="pill">model complexity → error</span><div class="spacer"></div><span class="pill" id="rs-fit-state" role="status"><span class="dot emerald"></span>good fit</span></div><canvas id="rs-bv-canvas" role="img" aria-label="Bias, variance, and total error across model complexity"></canvas></section><aside class="pg-panel"><div class="ctrl"><div class="field"><label for="rs-complexity">Model complexity <span class="val" id="rs-complexity-v">5</span></label><input id="rs-complexity" type="range" min="1" max="10" value="5" /></div><p class="note" id="rs-complexity-note">A balanced model captures the pattern without fitting too much noise.</p></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">BIAS²</div><div class="v mono" id="rs-bias">—</div></div><div class="metric"><div class="l">VARIANCE</div><div class="v mono" id="rs-variance">—</div></div><div class="metric"><div class="l">TOTAL ERROR</div><div class="v mono" id="rs-total">—</div></div><div class="metric"><div class="l">REGIME</div><div class="v rs-small" id="rs-regime">—</div></div></div></aside></div></div>

  <div id="panel-cv" style="display:none"><div class="pg rs-grid"><section class="glass rs-workbench" aria-labelledby="rs-cv-heading"><h4 id="rs-cv-heading" class="rs-kicker">Estimate generalization with held-out folds</h4><div class="rs-folds" id="rs-cv-folds" aria-live="polite"></div></section><aside class="pg-panel"><div class="ctrl"><h4>Validation strategy</h4><div class="seg" id="rs-cv-method"><button class="active" data-v="kfold">K-fold</button><button data-v="stratified">Stratified</button><button data-v="time">Time split</button></div></div><div class="ctrl"><div class="field"><label for="rs-cv-k">Number of folds <span class="val" id="rs-cv-k-v">5</span></label><input id="rs-cv-k" type="range" min="3" max="10" value="5" /></div></div><div class="metrics"><div class="metric"><div class="l">MEAN SCORE</div><div class="v mono" id="rs-cv-mean">—</div></div><div class="metric"><div class="l">STD DEV</div><div class="v mono" id="rs-cv-std">—</div></div></div><p class="note" id="rs-cv-note"></p></aside></div></div>

  <div id="panel-bootstrap" style="display:none"><div class="pg rs-grid"><section class="glass rs-workbench" aria-labelledby="rs-boot-heading"><h4 id="rs-boot-heading" class="rs-kicker">Build uncertainty by resampling</h4><div class="rs-histogram" id="rs-boot-hist" role="img" aria-label="Bootstrap distribution of an estimated metric"></div></section><aside class="pg-panel"><div class="ctrl"><div class="field"><label for="rs-boot-samples">Bootstrap samples <span class="val" id="rs-boot-samples-v">500</span></label><input id="rs-boot-samples" type="range" min="100" max="2000" step="100" value="500" /></div><div class="field"><label for="rs-boot-size">Dataset size <span class="val" id="rs-boot-size-v">200</span></label><input id="rs-boot-size" type="range" min="40" max="1000" step="20" value="200" /></div></div><div class="ctrl"><h4>Interval</h4><div class="seg" id="rs-boot-level"><button data-v="90">90%</button><button class="active" data-v="95">95%</button><button data-v="99">99%</button></div></div><div class="metrics"><div class="metric"><div class="l">ESTIMATE</div><div class="v mono" id="rs-boot-estimate">—</div></div><div class="metric"><div class="l">INTERVAL</div><div class="v rs-small" id="rs-boot-ci">—</div></div></div></aside></div></div>

  <div id="panel-hypothesis" style="display:none"><div class="pg rs-grid"><section class="glass rs-workbench" aria-labelledby="rs-test-heading"><h4 id="rs-test-heading" class="rs-kicker">Test an observed difference</h4><div class="rs-test-result"><span>NULL HYPOTHESIS</span><p>Variant B has no real effect over A.</p><strong id="rs-test-verdict">Not tested</strong><small id="rs-test-detail"></small></div></section><aside class="pg-panel"><div class="ctrl"><div class="field"><label for="rs-test-effect">Observed lift <span class="val" id="rs-test-effect-v">4%</span></label><input id="rs-test-effect" type="range" min="0" max="15" value="4" /></div><div class="field"><label for="rs-test-n">Sample per group <span class="val" id="rs-test-n-v">500</span></label><input id="rs-test-n" type="range" min="100" max="5000" step="100" value="500" /></div></div><div class="ctrl"><h4>Significance level</h4><div class="seg" id="rs-test-alpha"><button data-v="10">10%</button><button class="active" data-v="5">5%</button><button data-v="1">1%</button></div></div><button class="btn btn-primary btn-sm" id="rs-test-run">Run hypothesis test</button><div class="metrics"><div class="metric"><div class="l">P-VALUE</div><div class="v mono" id="rs-test-p">—</div></div><div class="metric"><div class="l">DECISION</div><div class="v rs-small" id="rs-test-decision">waiting</div></div></div></aside></div></div>

  <div id="panel-power" style="display:none"><div class="pg rs-grid"><section class="glass rs-workbench" aria-labelledby="rs-power-heading"><h4 id="rs-power-heading" class="rs-kicker">Plan an experiment before collecting data</h4><div class="rs-power-meter"><i id="rs-power-fill"></i><span id="rs-power-label">—</span></div><p class="note" id="rs-power-summary"></p></section><aside class="pg-panel"><div class="ctrl"><div class="field"><label for="rs-power-effect">Minimum detectable effect <span class="val" id="rs-power-effect-v">5%</span></label><input id="rs-power-effect" type="range" min="1" max="20" value="5" /></div><div class="field"><label for="rs-power-n">Sample per group <span class="val" id="rs-power-n-v">800</span></label><input id="rs-power-n" type="range" min="100" max="5000" step="100" value="800" /></div><div class="field"><label for="rs-power-noise">Outcome noise <span class="val" id="rs-power-noise-v">40%</span></label><input id="rs-power-noise" type="range" min="10" max="90" value="40" /></div></div><div class="metrics"><div class="metric"><div class="l">POWER</div><div class="v mono" id="rs-power-value">—</div></div><div class="metric"><div class="l">TARGET</div><div class="v mono">80%</div></div></div></aside></div></div>

  <div id="panel-ablation" style="display:none"><div class="pg rs-grid"><section class="glass rs-workbench" aria-labelledby="rs-ablation-heading"><h4 id="rs-ablation-heading" class="rs-kicker">Measure what each component contributes</h4><div class="rs-ablation-list" id="rs-ablation-list" aria-live="polite"></div></section><aside class="pg-panel"><fieldset class="ctrl rs-fieldset"><legend>Enabled components</legend><label><input id="rs-ablation-aug" type="checkbox" checked /> Data augmentation</label><label><input id="rs-ablation-attn" type="checkbox" checked /> Attention block</label><label><input id="rs-ablation-pre" type="checkbox" checked /> Pretraining</label><label><input id="rs-ablation-reg" type="checkbox" checked /> Regularization</label></fieldset><div class="metrics"><div class="metric"><div class="l">CURRENT F1</div><div class="v mono" id="rs-ablation-score">—</div></div><div class="metric"><div class="l">LARGEST EFFECT</div><div class="v rs-small" id="rs-ablation-largest">—</div></div></div><p class="note">Ablate one factor at a time while holding the rest of the experimental setup fixed.</p></aside></div></div>

  <div id="panel-reproduce" style="display:none"><div class="pg rs-grid"><section class="glass rs-workbench" aria-labelledby="rs-repro-heading"><h4 id="rs-repro-heading" class="rs-kicker">Audit a reproducible experiment package</h4><div class="rs-evidence" id="rs-repro-evidence" aria-live="polite"></div></section><aside class="pg-panel"><fieldset class="ctrl rs-fieldset"><legend>Published artifacts</legend><label><input id="rs-repro-code" type="checkbox" checked /> Source code and commit</label><label><input id="rs-repro-env" type="checkbox" /> Environment lockfile</label><label><input id="rs-repro-data" type="checkbox" /> Data version or generator</label><label><input id="rs-repro-seed" type="checkbox" checked /> Random seeds</label><label><input id="rs-repro-config" type="checkbox" /> Full configuration</label></fieldset><div class="metrics"><div class="metric"><div class="l">READINESS</div><div class="v mono" id="rs-repro-score">—</div></div><div class="metric"><div class="l">STATUS</div><div class="v rs-small" id="rs-repro-status">—</div></div></div><p class="note" id="rs-repro-note"></p></aside></div></div>

  <div id="panel-report" style="display:none"><div class="pg rs-grid"><section class="glass rs-workbench" aria-labelledby="rs-report-heading"><h4 id="rs-report-heading" class="rs-kicker">Match the claim to the evidence</h4><div class="rs-claim"><span>PROPOSED CLAIM</span><strong id="rs-report-claim">The method improves performance.</strong><p id="rs-report-feedback" aria-live="polite"></p></div></section><aside class="pg-panel"><div class="ctrl"><h4>Evidence strength</h4><div class="seg" id="rs-report-evidence"><button class="active" data-v="single">Single run</button><button data-v="multi">Multiple seeds</button><button data-v="external">External data</button></div></div><div class="ctrl"><h4>Claim language</h4><div class="seg" id="rs-report-language"><button data-v="causes">Causes</button><button class="active" data-v="improves">Improves</button><button data-v="suggests">Suggests</button></div></div><label class="rs-check"><input id="rs-report-limits" type="checkbox" /> Limitations reported</label><div class="metrics"><div class="metric"><div class="l">CLAIM FIT</div><div class="v rs-small" id="rs-report-fit">—</div></div><div class="metric"><div class="l">REVIEW</div><div class="v rs-small" id="rs-report-review">—</div></div></div></aside></div></div>
</div>

<style is:global>
  .rs-grid{grid-template-columns:minmax(0,1fr) 340px}.rs-stage{aspect-ratio:16/10;min-height:360px}.rs-workbench{padding:26px;border-radius:var(--r-lg);min-height:360px;min-width:0}.rs-kicker{font:12px var(--mono);text-transform:uppercase;color:var(--ink-mute);margin:0 0 20px}.rs-small{font-size:14px!important}.rs-folds{display:grid;gap:10px}.rs-fold{display:grid;grid-template-columns:70px 1fr 64px;align-items:center;gap:12px}.rs-fold>span,.rs-fold>output{font:11px var(--mono);color:var(--ink-soft)}.rs-fold>output{text-align:right}.rs-fold-bar{display:flex;height:20px;border:1px solid var(--stroke);border-radius:6px;overflow:hidden}.rs-fold-bar i{flex:1;background:#dbeafe;border-right:1px solid #fff}.rs-fold-bar i.test{background:#8b8cf6}.rs-histogram{display:flex;align-items:end;gap:5px;height:280px;padding:18px;border:1px solid var(--stroke);border-radius:14px;background:var(--surface)}.rs-histogram i{flex:1;height:var(--bar);background:#6366f1;border-radius:4px 4px 0 0;opacity:var(--alpha)}.rs-test-result,.rs-trigger-card,.rs-claim{padding:28px;border:1px solid var(--stroke);border-radius:14px;background:var(--glass-2)}.rs-test-result span,.rs-claim span{font:10px var(--mono);color:var(--ink-mute)}.rs-test-result p{margin:10px 0 28px;color:var(--ink-soft)}.rs-test-result strong,.rs-claim strong{display:block;font-size:28px}.rs-test-result small{display:block;margin-top:10px;color:var(--ink-mute)}.rs-power-meter{height:44px;border:1px solid var(--stroke);border-radius:12px;background:var(--surface);overflow:hidden;position:relative;margin:70px 0 24px}.rs-power-meter i{display:block;height:100%;background:#6366f1;transform:scaleX(var(--power));transform-origin:left;transition:transform .18s}.rs-power-meter span{position:absolute;inset:0;display:grid;place-items:center;font:700 13px var(--mono);color:var(--ink)}.rs-ablation-list,.rs-evidence{display:grid;gap:10px}.rs-ablation-row,.rs-evidence-row{display:grid;grid-template-columns:1fr auto;gap:12px;padding:14px 16px;border:1px solid var(--stroke);border-radius:12px;background:var(--glass-2)}.rs-ablation-row span,.rs-evidence-row span{font:11px var(--mono);color:var(--ink-mute)}.rs-evidence-row.present{border-color:#86d8bd}.rs-evidence-row.present span{color:#067647}.rs-evidence-row.missing{border-color:#fda29b}.rs-evidence-row.missing span{color:#b42318}.rs-fieldset{border:0;margin:0;padding:0}.rs-fieldset legend{font-weight:600;margin-bottom:12px}.rs-fieldset label,.rs-check{display:flex;align-items:center;gap:9px;margin:11px 0;color:var(--ink-soft);font-size:13px}.rs-claim p{margin-top:20px;color:var(--ink-soft)}@media(max-width:900px){.rs-grid{grid-template-columns:1fr}}@media(max-width:560px){.rs-workbench{padding:18px}.rs-fold{grid-template-columns:54px 1fr}.rs-fold>output{grid-column:2}.rs-test-result strong,.rs-claim strong{font-size:22px}}@media(prefers-reduced-motion:reduce){.research-labs *{transition-duration:.01ms!important}}
</style>

<script>
  const by=(id:string)=>document.getElementById(id)!;const slider=(id:string)=>by(id) as HTMLInputElement;const put=(id:string,value:string)=>{by(id).textContent=value};const current=(id:string)=>(by(id).querySelector('button.active') as HTMLButtonElement).dataset.v!;function segment(id:string,render:()=>void){const group=by(id);group.querySelectorAll('button').forEach(button=>button.setAttribute('aria-pressed',String(button.classList.contains('active'))));group.addEventListener('click',event=>{const button=(event.target as Element).closest('button');if(!button)return;group.querySelectorAll('button').forEach(item=>{const on=item===button;item.classList.toggle('active',on);item.setAttribute('aria-pressed',String(on))});render()})}const watch=(ids:string[],render:()=>void)=>ids.forEach(id=>slider(id).addEventListener('input',render));
  const bvCanvas=by('rs-bv-canvas') as HTMLCanvasElement,bvContext=bvCanvas.getContext('2d')!,bias=(x:number)=>1.05*Math.exp(-x/2.6)+.04,variance=(x:number)=>.03*Math.exp(x/3),total=(x:number)=>bias(x)+variance(x)+.05;function drawBiasVariance(){const rect=bvCanvas.getBoundingClientRect();if(!rect.width||!rect.height)return;const dpr=Math.min(devicePixelRatio||1,2);bvCanvas.width=rect.width*dpr;bvCanvas.height=rect.height*dpr;bvContext.setTransform(dpr,0,0,dpr,0,0);bvContext.clearRect(0,0,rect.width,rect.height);const complexity=+slider('rs-complexity').value,W=rect.width,H=rect.height,ox=46,oy=H-40,gw=W-70,gh=H-72,max=total(10),X=(x:number)=>ox+(x-1)/9*gw,Y=(y:number)=>oy-y/max*gh,plot=(fn:(x:number)=>number,color:string)=>{bvContext.beginPath();for(let i=0;i<=100;i++){const x=1+i/100*9;i?bvContext.lineTo(X(x),Y(fn(x))):bvContext.moveTo(X(x),Y(fn(x)))}bvContext.strokeStyle=color;bvContext.lineWidth=2.4;bvContext.stroke()};bvContext.strokeStyle='rgba(100,116,139,.35)';bvContext.beginPath();bvContext.moveTo(ox,oy);bvContext.lineTo(ox+gw,oy);bvContext.moveTo(ox,oy);bvContext.lineTo(ox,oy-gh);bvContext.stroke();plot(bias,'#0891b2');plot(variance,'#e11d48');plot(total,'#6366f1');bvContext.fillStyle='#111827';bvContext.beginPath();bvContext.arc(X(complexity),Y(total(complexity)),5,0,Math.PI*2);bvContext.fill();let regime='good fit',note='A balanced model captures the pattern without fitting too much noise.';if(complexity<=3){regime='underfit';note='The model is too simple: high bias hides the real pattern.'}else if(complexity>=8){regime='overfit';note='The model is too complex: high variance follows noise instead of generalizing.'}put('rs-complexity-v',String(complexity));put('rs-bias',bias(complexity).toFixed(2));put('rs-variance',variance(complexity).toFixed(2));put('rs-total',total(complexity).toFixed(2));put('rs-regime',regime);put('rs-complexity-note',note);const dot=document.createElement('span');dot.className=`dot ${regime==='good fit'?'emerald':'amber'}`;by('rs-fit-state').replaceChildren(dot,document.createTextNode(regime))}slider('rs-complexity').addEventListener('input',drawBiasVariance);window.addEventListener('resize',drawBiasVariance);drawBiasVariance();
  function renderCv(){const method=current('rs-cv-method'),k=+slider('rs-cv-k').value,base=method==='stratified'?.88:method==='time'?.81:.86,scores=Array.from({length:k},(_,index)=>base+Math.sin(index*2.1)*.018+(method==='time'?index*.004:0)),mean=scores.reduce((sum,value)=>sum+value,0)/k,std=Math.sqrt(scores.reduce((sum,value)=>sum+(value-mean)**2,0)/k);put('rs-cv-k-v',String(k));by('rs-cv-folds').replaceChildren(...scores.map((score,index)=>{const row=document.createElement('div'),label=document.createElement('span'),bar=document.createElement('div'),out=document.createElement('output');row.className='rs-fold';label.textContent=`fold ${index+1}`;bar.className='rs-fold-bar';for(let part=0;part<k;part++){const cell=document.createElement('i');if(part===index)cell.className='test';bar.append(cell)}out.textContent=score.toFixed(3);row.append(label,bar,out);return row}));put('rs-cv-mean',mean.toFixed(3));put('rs-cv-std',std.toFixed(3));put('rs-cv-note',method==='time'?'Time splits preserve chronology so the model is never validated on its own past.':method==='stratified'?'Stratification preserves class proportions inside each fold.':'K-fold rotates every subset through validation and averages the results.')}segment('rs-cv-method',renderCv);watch(['rs-cv-k'],renderCv);renderCv();
  function renderBootstrap(){const samples=+slider('rs-boot-samples').value,size=+slider('rs-boot-size').value,level=+current('rs-boot-level'),spread=.16/Math.sqrt(size/40),z=level===90?1.64:level===99?2.58:1.96,estimate=.82,bins=Array.from({length:24},(_,index)=>Math.exp(-((index-11.5)**2)/(2*(3.4+200/samples)**2)));put('rs-boot-samples-v',String(samples));put('rs-boot-size-v',String(size));by('rs-boot-hist').replaceChildren(...bins.map((height,index)=>{const bar=document.createElement('i');bar.style.setProperty('--bar',`${height*100}%`);bar.style.setProperty('--alpha',String(.5+(index%3)*.18));return bar}));put('rs-boot-estimate',estimate.toFixed(2));put('rs-boot-ci',`${(estimate-z*spread).toFixed(2)}–${(estimate+z*spread).toFixed(2)}`)}segment('rs-boot-level',renderBootstrap);watch(['rs-boot-samples','rs-boot-size'],renderBootstrap);renderBootstrap();
  function renderTest(tested=false){const effect=+slider('rs-test-effect').value,n=+slider('rs-test-n').value,alpha=+current('rs-test-alpha')/100,p=Math.max(.0001,Math.exp(-effect*Math.sqrt(n)/42)),significant=p<alpha;put('rs-test-effect-v',`${effect}%`);put('rs-test-n-v',String(n));put('rs-test-p',tested?p.toFixed(3):'—');put('rs-test-decision',!tested?'waiting':significant?'reject H₀':'do not reject');put('rs-test-verdict',!tested?'Not tested':significant?'Evidence of a difference':'Insufficient evidence');put('rs-test-detail',tested?`p = ${p.toFixed(3)} compared with α = ${alpha.toFixed(2)}.`:'')}segment('rs-test-alpha',()=>renderTest(false));watch(['rs-test-effect','rs-test-n'],()=>renderTest(false));by('rs-test-run').addEventListener('click',()=>renderTest(true));renderTest();
  function renderPower(){const effect=+slider('rs-power-effect').value,n=+slider('rs-power-n').value,noise=+slider('rs-power-noise').value,power=Math.max(.05,Math.min(.99,.18+effect/20*.46+n/5000*.5-noise/100*.28));put('rs-power-effect-v',`${effect}%`);put('rs-power-n-v',String(n));put('rs-power-noise-v',`${noise}%`);put('rs-power-value',`${Math.round(power*100)}%`);put('rs-power-label',`${Math.round(power*100)}% power`);by('rs-power-fill').style.setProperty('--power',String(power));put('rs-power-summary',power>=.8?'The design meets the conventional 80% power target for this effect.':'The design is underpowered; increase sample size, target a larger effect, or reduce measurement noise.')}watch(['rs-power-effect','rs-power-n','rs-power-noise'],renderPower);renderPower();
  const components=[['Data augmentation','rs-ablation-aug',.025],['Attention block','rs-ablation-attn',.04],['Pretraining','rs-ablation-pre',.075],['Regularization','rs-ablation-reg',.018]] as [string,string,number][];function renderAblation(){const score=.74+components.reduce((sum,[,id,effect])=>sum+(slider(id).checked?effect:0),0),largest=[...components].sort((a,b)=>b[2]-a[2])[0];by('rs-ablation-list').replaceChildren(...components.map(([name,id,effect])=>{const row=document.createElement('div'),out=document.createElement('span');row.className='rs-ablation-row';out.textContent=slider(id).checked?`+${effect.toFixed(3)}`:'removed';row.append(document.createTextNode(name),out);return row}));put('rs-ablation-score',score.toFixed(3));put('rs-ablation-largest',largest[0])}components.forEach(([,id])=>slider(id).addEventListener('change',renderAblation));renderAblation();
  const repro=[['Source code and commit','rs-repro-code'],['Environment lockfile','rs-repro-env'],['Data version or generator','rs-repro-data'],['Random seeds','rs-repro-seed'],['Full configuration','rs-repro-config']];function renderRepro(){const present=repro.filter(([,id])=>slider(id).checked).length;by('rs-repro-evidence').replaceChildren(...repro.map(([name,id])=>{const on=slider(id).checked,row=document.createElement('div'),state=document.createElement('span');row.className=`rs-evidence-row ${on?'present':'missing'}`;state.textContent=on?'PUBLISHED':'MISSING';row.append(document.createTextNode(name),state);return row}));put('rs-repro-score',`${present}/5`);put('rs-repro-status',present===5?'reproducible':present>=3?'partial':'blocked');put('rs-repro-note',present===5?'Another researcher has the minimum artifacts needed to attempt the experiment.':'Publish missing artifacts or a documented substitute before claiming reproducibility.')}repro.forEach(([,id])=>slider(id).addEventListener('change',renderRepro));renderRepro();
  function renderReport(){const evidence=current('rs-report-evidence'),language=current('rs-report-language'),limits=slider('rs-report-limits').checked,claim=language==='causes'?'The method causes the observed improvement.':language==='improves'?'The method improves performance.':'The results suggest the method may improve performance.',fit=evidence==='external'&&language!=='causes'||evidence==='multi'&&language==='suggests'||evidence==='single'&&language==='suggests'?'matched':evidence==='external'&&language==='causes'?'needs design':'overstated',review=fit==='matched'&&limits?'ready':fit==='matched'?'add limits':'revise';put('rs-report-claim',claim);put('rs-report-fit',fit);put('rs-report-review',review);put('rs-report-feedback',fit==='matched'?(limits?'The wording matches the evidence and limitations are explicit.':'The wording is defensible; add limitations and boundary conditions.'):'The claim is stronger than this evidence supports. Use cautious language or collect stronger evidence.')}segment('rs-report-evidence',renderReport);segment('rs-report-language',renderReport);slider('rs-report-limits').addEventListener('change',renderReport);renderReport();
  const redraw:Record<string,()=>void>={research:drawBiasVariance,cv:renderCv,bootstrap:renderBootstrap,hypothesis:()=>renderTest(false),power:renderPower,ablation:renderAblation,reproduce:renderRepro,report:renderReport};document.addEventListener('research:tab',event=>requestAnimationFrame(()=>redraw[(event as CustomEvent<string>).detail]?.()));
</script>
