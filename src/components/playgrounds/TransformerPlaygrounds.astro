<div id="panel-attn">
  <div class="glass tf-input-card"><label for="tf-attn-input">Sentence for self-attention</label><input class="text-input" id="tf-attn-input" value="The cat sat on the mat because it was tired" /></div>
  <div class="pg tf-grid"><section class="glass tf-workbench" aria-labelledby="tf-attn-heading"><div class="row between center tf-wrap"><h4 id="tf-attn-heading" class="tf-kicker">Query → key weights</h4><span class="pill" id="tf-attn-focus">query: The</span></div><div class="tf-attn-tokens" id="tf-attn-tokens" aria-label="Select a query token"></div><div class="tf-matrix" id="tf-attn-matrix" role="img" aria-label="Attention weights from the selected query token"></div></section><aside class="pg-panel"><div class="ctrl"><h4>Attention head</h4><div class="seg" id="tf-heads"><button class="active" data-v="0">H1</button><button data-v="1">H2</button><button data-v="2">H3</button><button data-v="3">H4</button></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">STRONGEST KEY</div><div class="v mono tf-small" id="tf-attn-top">—</div></div><div class="metric"><div class="l">WEIGHT</div><div class="v mono" id="tf-attn-weight">—</div></div></div><div class="eqn">softmax(QKᵀ / √dₖ) V</div></aside></div>
</div>

<div id="panel-tok" style="display:none"><div class="pg tf-grid"><section class="glass tf-workbench" aria-labelledby="tf-tok-heading"><h4 id="tf-tok-heading" class="tf-kicker">Subword tokenizer</h4><label for="tf-tok-input" class="tf-label">Text</label><input class="text-input" id="tf-tok-input" value="Transformers are remarkably powerful!" /><div class="tok-row tf-token-output" id="tf-tok-output" aria-live="polite"></div></section><aside class="pg-panel"><div class="metrics" aria-live="polite"><div class="metric"><div class="l">TOKENS</div><div class="v mono" id="tf-tok-count">—</div></div><div class="metric"><div class="l">VOCAB USED</div><div class="v mono" id="tf-vocab-count">—</div></div></div><div class="ctrl"><h4>Why subwords?</h4><p class="note">A fixed vocabulary can represent familiar words compactly and still spell unfamiliar ones from reusable pieces.</p></div></aside></div></div>

<div id="panel-pos" style="display:none"><div class="pg tf-grid"><section class="glass tf-workbench" aria-labelledby="tf-pos-heading"><div class="row between center tf-wrap"><h4 id="tf-pos-heading" class="tf-kicker">Position signal by token</h4><span class="pill" id="tf-pos-method-label">sinusoidal</span></div><div class="tf-position-chart" id="tf-position-chart" role="img" aria-label="Position encoding values across a token sequence"></div></section><aside class="pg-panel"><div class="ctrl"><h4>Encoding method</h4><div class="seg" id="tf-pos-method"><button class="active" data-v="sin">Sinusoidal</button><button data-v="learned">Learned</button><button data-v="rope">RoPE</button></div></div><div class="ctrl"><div class="field"><label for="tf-pos-length">Sequence length <span class="val" id="tf-pos-length-v">8 tokens</span></label><input id="tf-pos-length" type="range" min="4" max="16" value="8" /></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">DIMENSIONS</div><div class="v mono">4</div></div><div class="metric"><div class="l">MAX POSITION</div><div class="v mono" id="tf-pos-max">8</div></div></div><p class="note" id="tf-pos-note">Sine waves at different frequencies give each position a unique, extrapolatable pattern.</p></aside></div></div>

<div id="panel-block" style="display:none"><div class="pg tf-grid"><section class="glass tf-workbench" aria-labelledby="tf-block-heading"><h4 id="tf-block-heading" class="tf-kicker">One transformer block</h4><div class="tf-pipeline" id="tf-block-pipeline"><div data-stage="0">Input<br/><small>x</small></div><div data-stage="1">Attention<br/><small>mix context</small></div><div data-stage="2">Add &amp; norm<br/><small>x + attn</small></div><div data-stage="3">Feed-forward<br/><small>expand</small></div><div data-stage="4">Add &amp; norm<br/><small>output</small></div></div><div class="tf-signal" id="tf-block-signal" aria-live="polite">Ready at input embedding.</div></section><aside class="pg-panel"><div class="ctrl"><div class="field"><label for="tf-block-residual">Residual strength <span class="val" id="tf-block-residual-v">1.0×</span></label><input id="tf-block-residual" type="range" min="0" max="1.5" step="0.1" value="1" /></div><div class="field"><label for="tf-block-ffn">FFN expansion <span class="val" id="tf-block-ffn-v">4×</span></label><input id="tf-block-ffn" type="range" min="1" max="8" value="4" /></div></div><div class="row tf-actions"><button class="btn btn-primary btn-sm" id="tf-block-step" type="button">Advance signal</button><button class="btn btn-ghost btn-sm" id="tf-block-reset" type="button">Reset</button></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">STAGE</div><div class="v mono" id="tf-block-stage">1 / 5</div></div><div class="metric"><div class="l">WIDTH</div><div class="v mono" id="tf-block-width">4d</div></div></div></aside></div></div>

<div id="panel-next" style="display:none"><div class="pg tf-grid"><section class="glass tf-workbench" aria-labelledby="tf-next-heading"><h4 id="tf-next-heading" class="tf-kicker">Next-token distribution</h4><label for="tf-next-input" class="tf-label">Prompt</label><input class="text-input" id="tf-next-input" value="The neural network is" /><div id="tf-next-bars" class="tf-bars"></div><div class="glass glass-hi tf-result"><span class="mono">sampled →</span><strong class="mono" id="tf-next-pick" aria-live="polite">—</strong></div></section><aside class="pg-panel"><div class="ctrl"><div class="field"><label for="tf-next-temp">Temperature <span class="val" id="tf-next-temp-v">0.8</span></label><input type="range" id="tf-next-temp" min="0.1" max="1.8" step="0.1" value="0.8" /></div></div><button class="btn btn-primary" id="tf-next-sample" type="button">Sample next token</button><div class="metrics" aria-live="polite"><div class="metric"><div class="l">ENTROPY</div><div class="v mono" id="tf-next-entropy">—</div></div><div class="metric"><div class="l">TOP TOKEN</div><div class="v mono tf-small" id="tf-next-top">—</div></div></div></aside></div></div>

<div id="panel-context" style="display:none"><div class="pg tf-grid"><section class="glass tf-workbench" aria-labelledby="tf-context-heading"><h4 id="tf-context-heading" class="tf-kicker">What fits in the context window?</h4><label for="tf-context-input" class="tf-label">Conversation</label><textarea class="text-input tf-textarea" id="tf-context-input">System: Answer using the supplied notes. User: Explain why attention helps a model resolve references across a sentence. Notes: Attention lets every token directly weigh information from earlier tokens.</textarea><div class="tf-context-tokens" id="tf-context-tokens" aria-live="polite"></div></section><aside class="pg-panel"><div class="ctrl"><div class="field"><label for="tf-context-limit">Window size <span class="val" id="tf-context-limit-v">24 tokens</span></label><input id="tf-context-limit" type="range" min="8" max="48" step="4" value="24" /></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">USED</div><div class="v mono" id="tf-context-used">—</div></div><div class="metric"><div class="l">DROPPED</div><div class="v mono" id="tf-context-dropped">—</div></div><div class="metric"><div class="l">UTILIZATION</div><div class="v mono" id="tf-context-util">—</div></div></div><p class="note">When the prompt exceeds the window, the oldest tokens are truncated unless the application summarizes or retrieves them again.</p></aside></div></div>

<div id="panel-rag" style="display:none"><div class="pg tf-grid"><section class="glass tf-workbench" aria-labelledby="tf-rag-heading"><h4 id="tf-rag-heading" class="tf-kicker">Retrieve → augment → generate</h4><label for="tf-rag-query" class="tf-label">Question</label><input class="text-input" id="tf-rag-query" value="How does attention connect distant words?" /><div class="tf-docs" id="tf-rag-docs" aria-live="polite"></div><div class="glass glass-hi tf-answer"><span>GROUNDED ANSWER</span><p id="tf-rag-answer">—</p></div></section><aside class="pg-panel"><div class="ctrl"><div class="field"><label for="tf-rag-k">Retrieve top <span class="val" id="tf-rag-k-v">2 documents</span></label><input id="tf-rag-k" type="range" min="1" max="4" value="2" /></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">TOP SCORE</div><div class="v mono" id="tf-rag-score">—</div></div><div class="metric"><div class="l">CONTEXT TOKENS</div><div class="v mono" id="tf-rag-tokens">—</div></div></div><p class="note">Retrieval supplies current, relevant evidence at inference time; the model still needs instructions to stay grounded in it.</p></aside></div></div>

<div id="panel-arch" style="display:none"><div class="pg tf-grid"><section class="glass tf-workbench" aria-labelledby="tf-arch-heading"><h4 id="tf-arch-heading" class="tf-kicker">Attention mask and information flow</h4><div class="tf-arch-grid" id="tf-arch-grid" role="img" aria-label="Allowed attention connections for the selected transformer architecture"></div></section><aside class="pg-panel"><div class="ctrl"><h4>Architecture</h4><div class="seg" id="tf-arch-kind"><button class="active" data-v="encoder">Encoder</button><button data-v="decoder">Decoder</button><button data-v="encdec">Enc–Dec</button></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">MASK</div><div class="v mono tf-small" id="tf-arch-mask">bidirectional</div></div><div class="metric"><div class="l">BEST FOR</div><div class="v mono tf-small" id="tf-arch-use">understanding</div></div></div><p class="note" id="tf-arch-note">Encoder tokens can attend in both directions, making the full input available for representation learning.</p></aside></div></div>

<style>
  .tf-grid{grid-template-columns:minmax(0,1fr) 320px}.tf-input-card{padding:18px;border-radius:var(--r);margin-bottom:20px}.tf-input-card label,.tf-label{display:block;color:var(--ink-mute);font-size:12px;margin-bottom:8px}.tf-workbench{padding:26px;border-radius:var(--r-lg);min-width:0}.tf-kicker{font:12px var(--mono);text-transform:uppercase;color:var(--ink-mute);margin:0 0 14px}.tf-wrap{flex-wrap:wrap;gap:10px}.tf-small{font-size:14px!important}.tf-attn-tokens{display:flex;flex-wrap:wrap;gap:7px;margin:16px 0}.tf-attn-tokens button{border:1px solid var(--stroke);border-radius:8px;background:var(--surface);color:var(--ink-soft);padding:7px 9px;font:12px var(--mono)}.tf-attn-tokens button.active{background:var(--violet);border-color:var(--violet);color:white}.tf-matrix{display:grid;grid-template-columns:repeat(var(--cols),minmax(26px,1fr));gap:5px;min-height:230px;align-items:end}.tf-weight{display:flex;align-items:flex-end;justify-content:center;height:100%;min-width:0}.tf-weight i{display:block;width:100%;min-height:6px;background:var(--violet);border-radius:5px 5px 2px 2px}.tf-weight span{position:absolute;font:10px var(--mono);color:var(--ink);transform:translateY(18px)}.tf-token-output{margin-top:20px}.tf-position-chart{display:grid;grid-template-columns:repeat(var(--cols),1fr);gap:8px;align-items:center;min-height:310px}.tf-pos-column{display:grid;grid-template-rows:repeat(4,1fr);gap:5px;height:250px}.tf-pos-cell{border-radius:5px;background:var(--violet);opacity:var(--alpha)}.tf-pos-index{text-align:center;font:10px var(--mono);color:var(--ink-mute)}.tf-pipeline{display:grid;grid-template-columns:repeat(5,1fr);gap:9px;align-items:stretch;margin:28px 0}.tf-pipeline>div{border:1px solid var(--stroke);border-radius:12px;padding:18px 10px;text-align:center;font-size:13px;color:var(--ink-soft)}.tf-pipeline>div.active{border-color:var(--violet);background:var(--violet);color:white}.tf-pipeline small{font:10px var(--mono);opacity:.8}.tf-signal{border:1px solid var(--stroke);border-radius:10px;padding:14px;color:var(--ink-soft);font-size:13px}.tf-actions{gap:8px}.tf-bars{margin-top:22px}.tf-workbench .pbar i{transition:none;background:var(--violet)}.tf-result{margin-top:20px;padding:15px 18px;border-radius:12px;display:flex;gap:12px}.tf-result strong{color:var(--violet)}.tf-textarea{min-height:120px;resize:vertical;line-height:1.55}.tf-context-tokens{display:flex;flex-wrap:wrap;gap:6px;margin-top:18px}.tf-context-token{border-radius:6px;padding:5px 7px;font:11px var(--mono);background:var(--violet);color:white}.tf-context-token.dropped{background:var(--surface);border:1px dashed var(--stroke);color:var(--ink-mute);text-decoration:line-through}.tf-docs{display:grid;gap:9px;margin:20px 0}.tf-doc{border:1px solid var(--stroke);border-radius:11px;padding:14px;display:grid;grid-template-columns:1fr auto;gap:10px}.tf-doc strong{font-size:13px}.tf-doc p{grid-column:1/-1;color:var(--ink-mute);font-size:12px;margin:0}.tf-doc span{font:11px var(--mono);color:var(--violet)}.tf-answer{padding:16px;border-radius:12px}.tf-answer span{font:10px var(--mono);color:var(--ink-mute)}.tf-answer p{margin:7px 0 0;color:var(--ink);font-size:14px}.tf-arch-grid{display:grid;grid-template-columns:repeat(8,1fr);gap:5px;max-width:460px;margin:18px auto}.tf-arch-cell{aspect-ratio:1;border-radius:4px;background:var(--surface);border:1px solid var(--stroke)}.tf-arch-cell.on{background:var(--violet);border-color:var(--violet)}
  @media(max-width:850px){.tf-grid{grid-template-columns:1fr}}@media(max-width:650px){.tf-workbench{padding:18px}.tf-pipeline{grid-template-columns:1fr}.tf-position-chart{gap:4px}.tf-matrix{min-height:190px}}
</style>

<script>
  const el=(name:string)=>document.getElementById(name)!;const inp=(name:string)=>el(name) as HTMLInputElement;const text=(name:string,value:string)=>{el(name).textContent=value};
  function segment(name:string,render:()=>void){const root=el(name);root.querySelectorAll('button').forEach(button=>button.setAttribute('aria-pressed',String(button.classList.contains('active'))));root.addEventListener('click',event=>{const button=(event.target as Element).closest('button');if(!button)return;root.querySelectorAll('button').forEach(item=>{const active=item===button;item.classList.toggle('active',active);item.setAttribute('aria-pressed',String(active))});render()})}const choice=(name:string)=>(el(name).querySelector('button.active') as HTMLButtonElement).dataset.v!;
  function hash(value:string){let h=2166136261;for(const char of value){h^=char.charCodeAt(0);h=Math.imul(h,16777619)}return h>>>0}function random(seed:number){let state=seed||1;return()=>{state=(Math.imul(state,1103515245)+12345)&0x7fffffff;return state/0x7fffffff}}function softmax(values:number[],temperature=1){const scaled=values.map(value=>value/temperature),max=Math.max(...scaled),exp=scaled.map(value=>Math.exp(value-max)),sum=exp.reduce((a,b)=>a+b,0);return exp.map(value=>value/sum)}
  let queryIndex=0;function renderAttention(){const tokens=inp('tf-attn-input').value.trim().split(/\s+/).filter(Boolean).slice(0,10),head=Number(choice('tf-heads'));queryIndex=Math.min(queryIndex,Math.max(0,tokens.length-1));const rng=random(hash(`${tokens.join('|')}|${head}|${queryIndex}`)),weights=softmax(tokens.map((token,index)=>rng()+((token.toLowerCase()==='it'&&tokens[index-1]?.toLowerCase()==='because')?.5:0))),row=el('tf-attn-tokens');row.replaceChildren(...tokens.map((token,index)=>{const button=document.createElement('button');button.type='button';button.textContent=token;button.classList.toggle('active',index===queryIndex);button.setAttribute('aria-pressed',String(index===queryIndex));button.addEventListener('click',()=>{queryIndex=index;renderAttention()});return button}));const matrix=el('tf-attn-matrix');matrix.style.setProperty('--cols',String(Math.max(1,tokens.length)));matrix.replaceChildren(...weights.map((weight,index)=>{const col=document.createElement('div'),bar=document.createElement('i'),label=document.createElement('span');col.className='tf-weight';col.style.position='relative';bar.style.height=`${Math.max(6,weight*210)}px`;bar.style.opacity=String(.25+weight*.75);label.textContent=tokens[index]?.slice(0,7)||'';col.append(bar,label);return col}));let top=0;weights.forEach((weight,index)=>{if(weight>weights[top])top=index});text('tf-attn-focus',`query: ${tokens[queryIndex]||'—'}`);text('tf-attn-top',tokens[top]||'—');text('tf-attn-weight',weights[top]?.toFixed(2)||'—')}
  segment('tf-heads',renderAttention);inp('tf-attn-input').addEventListener('input',()=>{queryIndex=0;renderAttention()});
  const common=new Set(['the','a','an','is','are','to','of','in','and','attention','transformers']);function tokenize(value:string){return(value.match(/[A-Za-z]+|\d+|[^\sA-Za-z\d]/g)||[]).flatMap(word=>{if(word.length<9||common.has(word.toLowerCase())||/[^A-Za-z]/.test(word))return[word];return[word.slice(0,5),'##'+word.slice(5)]})}function renderTokenizer(){const tokens=tokenize(inp('tf-tok-input').value),root=el('tf-tok-output');root.replaceChildren(...tokens.map(token=>{const chip=document.createElement('span'),small=document.createElement('small');chip.className='tok id';chip.append(document.createTextNode(token));small.textContent=String(1000+hash(token)%8000);chip.append(small);return chip}));text('tf-tok-count',String(tokens.length));text('tf-vocab-count',String(new Set(tokens).size))}inp('tf-tok-input').addEventListener('input',renderTokenizer);
  function renderPosition(){const method=choice('tf-pos-method'),length=Number(inp('tf-pos-length').value),chart=el('tf-position-chart');chart.style.setProperty('--cols',String(length));const rng=random(hash(method));chart.replaceChildren(...Array.from({length},(_,position)=>{const wrap=document.createElement('div'),column=document.createElement('div'),index=document.createElement('div');column.className='tf-pos-column';for(let dim=0;dim<4;dim++){const cell=document.createElement('span'),value=method==='sin'?Math.sin(position/Math.pow(10,dim/2)):method==='rope'?Math.cos(position*(dim+1)*.42):rng()*2-1;cell.className='tf-pos-cell';cell.style.setProperty('--alpha',String(.15+Math.abs(value)*.85));column.append(cell)}index.className='tf-pos-index';index.textContent=String(position);wrap.append(column,index);return wrap}));text('tf-pos-method-label',method==='sin'?'sinusoidal':method==='learned'?'learned table':'rotary · RoPE');text('tf-pos-length-v',`${length} tokens`);text('tf-pos-max',String(length));text('tf-pos-note',method==='sin'?'Sine waves at different frequencies give each position a unique, extrapolatable pattern.':method==='learned'?'A learned lookup table adapts positions to the training data but has a fixed maximum length.':'RoPE rotates query and key dimensions so their dot product carries relative distance.')}
  segment('tf-pos-method',renderPosition);inp('tf-pos-length').addEventListener('input',renderPosition);
  let blockStage=0;const blockNotes=['Ready at input embedding.','Attention mixes information from related tokens.','The residual path restores the original signal before normalization.','The feed-forward network transforms each token independently.','A second residual connection stabilizes the block output.'];function renderBlock(){el('tf-block-pipeline').querySelectorAll('[data-stage]').forEach((node,index)=>node.classList.toggle('active',index===blockStage));text('tf-block-signal',blockNotes[blockStage]);text('tf-block-stage',`${blockStage+1} / 5`);text('tf-block-residual-v',`${Number(inp('tf-block-residual').value).toFixed(1)}×`);text('tf-block-ffn-v',`${inp('tf-block-ffn').value}×`);text('tf-block-width',`${inp('tf-block-ffn').value}d`)}el('tf-block-step').addEventListener('click',()=>{blockStage=(blockStage+1)%5;renderBlock()});el('tf-block-reset').addEventListener('click',()=>{blockStage=0;renderBlock()});['tf-block-residual','tf-block-ffn'].forEach(name=>inp(name).addEventListener('input',renderBlock));
  const banks:Record<string,string[]>={is:['learning','powerful','a','trained','useful','complex'],the:['model','system','network','data','result','answer'],default:['the','a','and','to','model','data']};function nextDistribution(){const prompt=inp('tf-next-input').value,last=prompt.trim().split(/\s+/).at(-1)?.toLowerCase()||'',tokens=banks[last]||banks.default,rng=random(hash(prompt)),logits=tokens.map((_,index)=>1.7-index*.25+rng()*.4),temperature=Number(inp('tf-next-temp').value);return tokens.map((token,index)=>({token,p:softmax(logits,temperature)[index]})).sort((a,b)=>b.p-a.p)}function renderBars(rootId:string,rows:{token:string,p:number}[]){const root=el(rootId);root.replaceChildren(...rows.map(row=>{const line=document.createElement('div'),label=document.createElement('span'),track=document.createElement('div'),fill=document.createElement('i'),value=document.createElement('span');line.className='prob-row';label.className='pt';label.textContent=row.token;track.className='pbar';fill.style.width=`${Math.max(2,row.p*100)}%`;track.append(fill);value.className='pv';value.textContent=`${Math.round(row.p*100)}%`;line.append(label,track,value);return line}))}function renderNext(){const dist=nextDistribution(),temperature=Number(inp('tf-next-temp').value),entropy=-dist.reduce((sum,item)=>sum+item.p*Math.log2(item.p),0);renderBars('tf-next-bars',dist);text('tf-next-temp-v',temperature.toFixed(1));text('tf-next-entropy',entropy.toFixed(2));text('tf-next-top',dist[0].token)}inp('tf-next-input').addEventListener('input',renderNext);inp('tf-next-temp').addEventListener('input',renderNext);el('tf-next-sample').addEventListener('click',()=>{const dist=nextDistribution();let draw=Math.random(),pick=dist[0].token;for(const item of dist){draw-=item.p;if(draw<=0){pick=item.token;break}}text('tf-next-pick',pick)});
  function renderContext(){const tokens=inp('tf-context-input').value.trim().split(/\s+/).filter(Boolean),limit=Number(inp('tf-context-limit').value),dropped=Math.max(0,tokens.length-limit),root=el('tf-context-tokens');root.replaceChildren(...tokens.map((token,index)=>{const chip=document.createElement('span');chip.className=`tf-context-token${index<dropped?' dropped':''}`;chip.textContent=token;return chip}));text('tf-context-limit-v',`${limit} tokens`);text('tf-context-used',String(Math.min(tokens.length,limit)));text('tf-context-dropped',String(dropped));text('tf-context-util',`${Math.min(100,Math.round(tokens.length/limit*100))}%`)}inp('tf-context-input').addEventListener('input',renderContext);inp('tf-context-limit').addEventListener('input',renderContext);
  const docs=[{title:'Self-attention',body:'Every token computes weights over other tokens, creating direct paths between distant words.',keys:['attention','connect','distant','words','token']},{title:'Recurrence',body:'RNNs pass information through sequential hidden states, making long paths harder to optimize.',keys:['rnn','recurrent','sequence','hidden']},{title:'Position encoding',body:'Position signals preserve token order because attention itself is permutation invariant.',keys:['position','order','sequence']},{title:'Retrieval',body:'RAG retrieves relevant chunks and places them into the model context before generation.',keys:['rag','retrieve','document','context']}];function renderRag(){const query=inp('tf-rag-query').value.toLowerCase(),terms=query.match(/[a-z]+/g)||[],ranked=docs.map(doc=>({...doc,score:.18+doc.keys.filter(key=>terms.some(term=>key.includes(term)||term.includes(key))).length*.2})).sort((a,b)=>b.score-a.score),k=Number(inp('tf-rag-k').value),selected=ranked.slice(0,k),root=el('tf-rag-docs');root.replaceChildren(...selected.map(doc=>{const card=document.createElement('article'),title=document.createElement('strong'),score=document.createElement('span'),body=document.createElement('p');card.className='tf-doc';title.textContent=doc.title;score.textContent=doc.score.toFixed(2);body.textContent=doc.body;card.append(title,score,body);return card}));text('tf-rag-k-v',`${k} ${k===1?'document':'documents'}`);text('tf-rag-score',selected[0].score.toFixed(2));text('tf-rag-tokens',String(selected.reduce((sum,doc)=>sum+doc.body.split(/\s+/).length,0)));text('tf-rag-answer',selected[0].body)}inp('tf-rag-query').addEventListener('input',renderRag);inp('tf-rag-k').addEventListener('input',renderRag);
  function renderArchitecture(){const kind=choice('tf-arch-kind'),root=el('tf-arch-grid');root.replaceChildren(...Array.from({length:64},(_,index)=>{const row=Math.floor(index/8),col=index%8,cell=document.createElement('span'),on=kind==='encoder'||kind==='encdec'||col<=row;cell.className=`tf-arch-cell${on?' on':''}`;return cell}));const config=kind==='encoder'?['bidirectional','understanding','Encoder tokens can attend in both directions, making the full input available for representation learning.']:kind==='decoder'?['causal','generation','Decoder tokens can only attend leftward, preventing them from seeing future targets during training.']:['cross-attention','translation','An encoder represents the source while the decoder attends to it as each output token is generated.'];text('tf-arch-mask',config[0]);text('tf-arch-use',config[1]);text('tf-arch-note',config[2])}segment('tf-arch-kind',renderArchitecture);
  renderAttention();renderTokenizer();renderPosition();renderBlock();renderNext();renderContext();renderRag();renderArchitecture();
</script>
