<div id="panel-xai"><div class="pg xa-grid"><section class="glass xa-workbench" aria-labelledby="xa-shap-heading"><div class="row between center xa-wrap"><h4 id="xa-shap-heading" class="xa-kicker">Local feature attributions</h4><span class="pill" id="xa-shap-decision"><span class="dot emerald"></span>approved</span></div><p class="note">Baseline 0.50 → prediction <strong class="mono" id="xa-shap-prediction">—</strong></p><div class="xa-bars" id="xa-shap-bars" aria-live="polite"></div><div class="xa-scale"><span>denied</span><div><i id="xa-shap-marker"></i></div><span>approved</span></div></section><aside class="pg-panel"><div class="ctrl"><h4>Method</h4><div class="seg" id="xa-shap-method"><button class="active" data-v="shap">SHAP</button><button data-v="lime">LIME</button></div><p class="note" id="xa-shap-note">SHAP values sum exactly from the baseline to this prediction.</p></div><fieldset class="ctrl xa-fieldset"><legend>Applicant features</legend><div id="xa-shap-toggles"></div></fieldset></aside></div></div>

<div id="panel-lime" style="display:none"><div class="pg xa-grid"><section class="glass xa-workbench" aria-labelledby="xa-lime-heading"><h4 id="xa-lime-heading" class="xa-kicker">Local surrogate neighbourhood</h4><div class="xa-neighbourhood" id="xa-lime-points" role="img" aria-label="Perturbed samples around the prediction being explained"></div></section><aside class="pg-panel"><div class="ctrl"><div class="field"><label for="xa-lime-radius">Neighbourhood radius <span class="val" id="xa-lime-radius-v">30%</span></label><input id="xa-lime-radius" type="range" min="10" max="90" value="30" /></div><div class="field"><label for="xa-lime-samples">Perturbation samples <span class="val" id="xa-lime-samples-v">50</span></label><input id="xa-lime-samples" type="range" min="20" max="120" step="10" value="50" /></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">LOCAL FIDELITY</div><div class="v mono" id="xa-lime-fidelity">—</div></div><div class="metric"><div class="l">FEATURES USED</div><div class="v mono" id="xa-lime-features">—</div></div></div><p class="note" id="xa-lime-note">A tight neighbourhood gives a faithful explanation of this point but says little about the model elsewhere.</p></aside></div></div>

<div id="panel-global" style="display:none"><div class="pg xa-grid"><section class="glass xa-workbench" aria-labelledby="xa-global-heading"><h4 id="xa-global-heading" class="xa-kicker">Dataset-level feature importance</h4><div class="xa-bars" id="xa-global-bars" aria-live="polite"></div></section><aside class="pg-panel"><div class="ctrl"><h4>Importance method</h4><div class="seg" id="xa-global-method"><button class="active" data-v="permutation">Permutation</button><button data-v="gain">Tree gain</button><button data-v="mean">Mean |SHAP|</button></div></div><div class="ctrl"><div class="field"><label for="xa-global-repeats">Permutation repeats <span class="val" id="xa-global-repeats-v">10</span></label><input id="xa-global-repeats" type="range" min="3" max="30" value="10" /></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">TOP FEATURE</div><div class="v mono xa-small" id="xa-global-top">—</div></div><div class="metric"><div class="l">STABILITY</div><div class="v mono" id="xa-global-stability">—</div></div></div></aside></div></div>

<div id="panel-pdp" style="display:none"><div class="pg xa-grid"><section class="glass xa-workbench" aria-labelledby="xa-pdp-heading"><h4 id="xa-pdp-heading" class="xa-kicker">Partial dependence and ICE</h4><canvas class="xa-canvas" id="xa-pdp-canvas" role="img" aria-label="Partial dependence and individual conditional expectation curves"></canvas></section><aside class="pg-panel"><div class="ctrl"><h4>Feature</h4><div class="seg" id="xa-pdp-feature"><button class="active" data-v="income">Income</button><button data-v="debt">Debt ratio</button><button data-v="tenure">Tenure</button></div></div><div class="ctrl"><div class="field"><label for="xa-pdp-value">Current value <span class="val" id="xa-pdp-value-v">50</span></label><input id="xa-pdp-value" type="range" min="0" max="100" value="50" /></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">AVG PREDICTION</div><div class="v mono" id="xa-pdp-pred">—</div></div><div class="metric"><div class="l">LOCAL SLOPE</div><div class="v mono" id="xa-pdp-slope">—</div></div></div><p class="note">PDP averages the feature effect across the dataset; ICE curves reveal how individual cases differ from that average.</p></aside></div></div>

<div id="panel-gradcam" style="display:none"><div class="pg xa-grid"><section class="glass xa-workbench" aria-labelledby="xa-grad-heading"><h4 id="xa-grad-heading" class="xa-kicker">Vision attribution heatmap</h4><canvas class="xa-canvas" id="xa-grad-canvas" role="img" aria-label="Grad-CAM heatmap over a simplified image"></canvas></section><aside class="pg-panel"><div class="ctrl"><h4>Predicted class</h4><div class="seg" id="xa-grad-class"><button class="active" data-v="cat">Cat</button><button data-v="dog">Dog</button><button data-v="background">Background</button></div></div><div class="ctrl"><div class="field"><label for="xa-grad-layer">CNN layer depth <span class="val" id="xa-grad-layer-v">4</span></label><input id="xa-grad-layer" type="range" min="1" max="6" value="4" /></div><div class="field"><label for="xa-grad-opacity">Heatmap opacity <span class="val" id="xa-grad-opacity-v">65%</span></label><input id="xa-grad-opacity" type="range" min="10" max="100" value="65" /></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">CLASS SCORE</div><div class="v mono" id="xa-grad-score">—</div></div><div class="metric"><div class="l">REGION</div><div class="v mono xa-small" id="xa-grad-region">—</div></div></div></aside></div></div>

<div id="panel-counter" style="display:none"><div class="pg xa-grid"><section class="glass xa-workbench" aria-labelledby="xa-counter-heading"><h4 id="xa-counter-heading" class="xa-kicker">Minimal change to flip the outcome</h4><div class="xa-counter-result" aria-live="polite"><span>CURRENT DECISION</span><strong id="xa-counter-current">denied · 42%</strong><span>COUNTERFACTUAL</span><p id="xa-counter-change">—</p></div></section><aside class="pg-panel"><div class="ctrl"><div class="field"><label for="xa-counter-income">Monthly income <span class="val" id="xa-counter-income-v">$4,000</span></label><input id="xa-counter-income" type="range" min="2000" max="10000" step="250" value="4000" /></div><div class="field"><label for="xa-counter-debt">Debt ratio <span class="val" id="xa-counter-debt-v">45%</span></label><input id="xa-counter-debt" type="range" min="5" max="70" value="45" /></div></div><div class="ctrl"><h4>Allowed changes</h4><div class="seg" id="xa-counter-allowed"><button class="active" data-v="both">Both</button><button data-v="income">Income only</button><button data-v="debt">Debt only</button></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">DISTANCE</div><div class="v mono" id="xa-counter-distance">—</div></div><div class="metric"><div class="l">FEASIBLE</div><div class="v mono xa-small" id="xa-counter-feasible">—</div></div></div></aside></div></div>

<div id="panel-fairness" style="display:none"><div class="pg xa-grid"><section class="glass xa-workbench" aria-labelledby="xa-fair-heading"><h4 id="xa-fair-heading" class="xa-kicker">Group fairness audit</h4><table class="xa-table"><thead><tr><th>Group</th><th>Approval</th><th>TPR</th><th>FPR</th></tr></thead><tbody id="xa-fair-table"></tbody></table><div class="xa-fair-status" id="xa-fair-status" aria-live="polite">—</div></section><aside class="pg-panel"><div class="ctrl"><h4>Mitigation</h4><div class="seg" id="xa-fair-method"><button class="active" data-v="none">None</button><button data-v="reweight">Reweight</button><button data-v="threshold">Thresholds</button></div></div><div class="ctrl"><div class="field"><label for="xa-fair-threshold">Decision threshold <span class="val" id="xa-fair-threshold-v">50%</span></label><input id="xa-fair-threshold" type="range" min="30" max="70" value="50" /></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">TPR GAP</div><div class="v mono" id="xa-fair-gap">—</div></div><div class="metric"><div class="l">ACCURACY</div><div class="v mono" id="xa-fair-accuracy">—</div></div></div><p class="note">Fairness criteria can conflict. Choose metrics based on the decision’s harms, legal context, and stakeholder input.</p></aside></div></div>

<div id="panel-llm" style="display:none"><div class="pg xa-grid"><section class="glass xa-workbench" aria-labelledby="xa-llm-heading"><h4 id="xa-llm-heading" class="xa-kicker">Logit lens through model depth</h4><p class="xa-llm-prompt">The capital of France is <strong id="xa-llm-prediction">—</strong></p><div id="xa-llm-bars" class="xa-bars" aria-live="polite"></div></section><aside class="pg-panel"><div class="ctrl"><div class="field"><label for="xa-llm-layer">Transformer layer <span class="val" id="xa-llm-layer-v">1 / 12</span></label><input id="xa-llm-layer" type="range" min="1" max="12" value="1" /></div></div><div class="ctrl"><h4>Intervention</h4><div class="seg" id="xa-llm-intervention"><button class="active" data-v="none">None</button><button data-v="ablate">Ablate head</button><button data-v="steer">Steer concept</button></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">TOP TOKEN</div><div class="v mono xa-small" id="xa-llm-top">—</div></div><div class="metric"><div class="l">CONFIDENCE</div><div class="v mono" id="xa-llm-confidence">—</div></div></div><p class="note" id="xa-llm-note">Early layers mostly represent syntax and broad context; the answer becomes explicit later.</p></aside></div></div>

<style>
  .xa-grid{grid-template-columns:minmax(0,1fr) 350px}.xa-workbench{padding:26px;border-radius:var(--r-lg);min-width:0}.xa-kicker{font:12px var(--mono);text-transform:uppercase;color:var(--ink-mute);margin:0 0 14px}.xa-small{font-size:14px!important}.xa-wrap{flex-wrap:wrap;gap:10px}.xa-bars{display:grid;gap:10px;margin-top:20px}.xa-bar{display:grid;grid-template-columns:125px 1fr 48px;gap:10px;align-items:center}.xa-bar>span{font:11px var(--mono);color:var(--ink-soft);text-align:right}.xa-bar-track{height:16px;background:var(--surface);border-radius:5px;overflow:hidden}.xa-bar-track i{display:block;height:100%;background:var(--emerald)}.xa-bar.negative .xa-bar-track i{background:var(--rose)}.xa-bar output{font:11px var(--mono);color:var(--ink-mute)}.xa-scale{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;margin-top:26px;font:10px var(--mono);color:var(--ink-mute)}.xa-scale>div{height:12px;background:var(--surface);border-radius:999px;position:relative}.xa-scale i{position:absolute;left:var(--marker);top:50%;width:8px;height:24px;background:var(--ink);border-radius:3px;transform:translate(-50%,-50%)}.xa-fieldset{border:0;margin:0;padding:0}.xa-fieldset legend{font-weight:600;margin-bottom:12px}.xa-toggle{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:10px 0;color:var(--ink-soft);font-size:13px}.xa-neighbourhood{position:relative;min-height:340px;border:1px solid var(--stroke);border-radius:14px;background:var(--surface);overflow:hidden}.xa-point{position:absolute;width:8px;height:8px;border-radius:50%;background:var(--violet);opacity:var(--alpha);left:var(--x);top:var(--y)}.xa-point.target{width:18px;height:18px;background:var(--amber);opacity:1}.xa-canvas{width:100%;height:340px;display:block;border:1px solid var(--stroke);border-radius:14px;background:var(--surface)}.xa-counter-result{display:grid;gap:10px;border:1px solid var(--stroke);border-radius:14px;padding:22px}.xa-counter-result span{font:10px var(--mono);color:var(--ink-mute)}.xa-counter-result strong{font-size:24px;color:var(--rose)}.xa-counter-result p{color:var(--ink-soft);font-size:16px}.xa-table{width:100%;border-collapse:collapse}.xa-table th,.xa-table td{text-align:right;padding:12px;border-bottom:1px solid var(--stroke);font:12px var(--mono)}.xa-table th:first-child,.xa-table td:first-child{text-align:left}.xa-table th{color:var(--ink-mute)}.xa-fair-status{margin-top:20px;border:1px solid var(--stroke);border-radius:10px;padding:14px;color:var(--ink-soft)}.xa-llm-prompt{font:18px var(--mono);padding:18px;border:1px solid var(--stroke);border-radius:12px}.xa-llm-prompt strong{color:var(--amber)}
  @media(max-width:850px){.xa-grid{grid-template-columns:1fr}}@media(max-width:600px){.xa-workbench{padding:18px}.xa-bar{grid-template-columns:90px 1fr 42px}.xa-table{display:block;overflow-x:auto}}
</style>

<script>
  const get=(name:string)=>document.getElementById(name)!;const range=(name:string)=>get(name) as HTMLInputElement;const set=(name:string,value:string)=>{get(name).textContent=value};function segment(name:string,render:()=>void){const root=get(name);root.querySelectorAll('button').forEach(button=>button.setAttribute('aria-pressed',String(button.classList.contains('active'))));root.addEventListener('click',event=>{const button=(event.target as Element).closest('button');if(!button)return;root.querySelectorAll('button').forEach(item=>{const active=item===button;item.classList.toggle('active',active);item.setAttribute('aria-pressed',String(active))});render()})}const active=(name:string)=>(get(name).querySelector('button.active') as HTMLButtonElement).dataset.v!;function bars(rootId:string,items:{label:string,value:number,signed?:boolean}[]){const max=Math.max(...items.map(item=>Math.abs(item.value)),.01),root=get(rootId);root.replaceChildren(...items.map(item=>{const row=document.createElement('div'),label=document.createElement('span'),track=document.createElement('div'),fill=document.createElement('i'),value=document.createElement('output');row.className=`xa-bar${item.value<0?' negative':''}`;label.textContent=item.label;track.className='xa-bar-track';fill.style.width=`${Math.max(3,Math.abs(item.value)/max*100)}%`;track.append(fill);value.textContent=`${item.signed&&item.value>0?'+':''}${item.value.toFixed(2)}`;row.append(label,track,value);return row}))}function fit(canvas:HTMLCanvasElement){const rect=canvas.getBoundingClientRect();if(!rect.width||!rect.height)return null;const dpr=Math.min(devicePixelRatio||1,2);canvas.width=rect.width*dpr;canvas.height=rect.height*dpr;const context=canvas.getContext('2d')!;context.setTransform(dpr,0,0,dpr,0,0);context.clearRect(0,0,rect.width,rect.height);return{context,width:rect.width,height:rect.height}}
const shapFeatures=[{label:'High income',value:.3,on:true},{label:'Long employment',value:.16,on:true},{label:'Low debt ratio',value:.12,on:true},{label:'Clean history',value:.1,on:true},{label:'Younger applicant',value:-.08,on:true},{label:'High-risk region',value:-.18,on:true},{label:'Missed payment',value:-.14,on:false}];const toggleRoot=get('xa-shap-toggles');toggleRoot.replaceChildren(...shapFeatures.map(feature=>{const label=document.createElement('label'),input=document.createElement('input');label.className='xa-toggle';input.type='checkbox';input.checked=feature.on;input.addEventListener('change',()=>{feature.on=input.checked;renderShap()});label.append(document.createTextNode(feature.label),input);return label}));function renderShap(){const method=active('xa-shap-method'),factor=method==='shap'?1:.85,items=shapFeatures.filter(feature=>feature.on).map(feature=>({label:feature.label,value:feature.value*factor,signed:true})).sort((a,b)=>Math.abs(b.value)-Math.abs(a.value)),prediction=Math.max(.02,Math.min(.98,.5+items.reduce((sum,item)=>sum+item.value,0))),approved=prediction>=.5;bars('xa-shap-bars',items);set('xa-shap-prediction',prediction.toFixed(2));get('xa-shap-marker').style.setProperty('--marker',`${prediction*100}%`);get('xa-shap-decision').innerHTML=`<span class="dot ${approved?'emerald':'rose'}"></span>${approved?'approved':'denied'}`;set('xa-shap-note',method==='shap'?'SHAP values sum exactly from the baseline to this prediction.':'LIME approximates this prediction with a sparse local linear model.') }segment('xa-shap-method',renderShap);
  function renderLime(){const radius=Number(range('xa-lime-radius').value),samples=Number(range('xa-lime-samples').value),root=get('xa-lime-points');root.replaceChildren(...Array.from({length:samples},(_,index)=>{const point=document.createElement('i'),angle=index*2.399,distance=(index%samples)/samples*radius*.45;point.className='xa-point';point.style.setProperty('--x',`${50+Math.cos(angle)*distance}%`);point.style.setProperty('--y',`${50+Math.sin(angle)*distance}%`);point.style.setProperty('--alpha',String(.25+(index%7)/10));return point}),Object.assign(document.createElement('i'),{className:'xa-point target'}));const target=root.lastElementChild as HTMLElement;target.style.setProperty('--x','50%');target.style.setProperty('--y','50%');set('xa-lime-radius-v',`${radius}%`);set('xa-lime-samples-v',String(samples));set('xa-lime-fidelity',`${Math.round(96-radius*.32+Math.min(4,samples/40))}%`);set('xa-lime-features',String(Math.max(2,Math.round(radius/16))));set('xa-lime-note',radius<45?'A tight neighbourhood gives a faithful explanation of this point but says little about the model elsewhere.':'A broad neighbourhood is more stable, but its simple surrogate fits the local boundary less precisely.')}['xa-lime-radius','xa-lime-samples'].forEach(name=>range(name).addEventListener('input',renderLime));
  const globalBase=[['Income',.34],['Debt ratio',.25],['Credit history',.2],['Employment',.13],['Region',.08]] as [string,number][];function renderGlobal(){const method=active('xa-global-method'),repeats=Number(range('xa-global-repeats').value),factor=method==='gain'?1.12:method==='mean'?.92:1,items=globalBase.map(([label,value],index)=>({label,value:value*factor*(1+(index%2)*.03)}));bars('xa-global-bars',items);set('xa-global-repeats-v',String(repeats));set('xa-global-top',items[0].label);set('xa-global-stability',`${Math.min(99,70+repeats)}%`)}segment('xa-global-method',renderGlobal);range('xa-global-repeats').addEventListener('input',renderGlobal);
  function drawPdp(){const canvas=get('xa-pdp-canvas') as HTMLCanvasElement,view=fit(canvas);if(!view)return;const{context,width,height}=view,feature=active('xa-pdp-feature'),value=Number(range('xa-pdp-value').value),pad=38,curve=(x:number)=>feature==='income'?.22+.66/(1+Math.exp(-(x-45)/13)):feature==='debt'?.82-.62/(1+Math.exp(-(x-48)/10)):.25+.006*x;context.strokeStyle='rgba(148,163,184,.22)';for(let line=0;line<5;line++){context.beginPath();for(let x=0;x<=100;x++){const y=Math.max(.05,Math.min(.95,curve(x)+(line-2)*.045*Math.sin(x/18+line))),px=pad+x/100*(width-pad-20),py=20+(1-y)*(height-pad-20);x?context.lineTo(px,py):context.moveTo(px,py)}context.stroke()}context.strokeStyle='#F59E0B';context.lineWidth=3;context.beginPath();for(let x=0;x<=100;x++){const px=pad+x/100*(width-pad-20),py=20+(1-curve(x))*(height-pad-20);x?context.lineTo(px,py):context.moveTo(px,py)}context.stroke();const pred=curve(value),slope=(curve(Math.min(100,value+1))-curve(Math.max(0,value-1)))/2;set('xa-pdp-value-v',String(value));set('xa-pdp-pred',pred.toFixed(2));set('xa-pdp-slope',slope.toFixed(3))}segment('xa-pdp-feature',drawPdp);range('xa-pdp-value').addEventListener('input',drawPdp);
  function drawGrad(){const canvas=get('xa-grad-canvas') as HTMLCanvasElement,view=fit(canvas);if(!view)return;const{context,width,height}=view,klass=active('xa-grad-class'),layer=Number(range('xa-grad-layer').value),opacity=Number(range('xa-grad-opacity').value)/100,cx=klass==='cat'?.42:klass==='dog'?.62:.5,cy=klass==='background'?.72:.42;context.fillStyle='#15151F';context.fillRect(0,0,width,height);context.fillStyle='#64748B';context.fillRect(width*.27,height*.3,width*.46,height*.46);const cells=10;for(let x=0;x<cells;x++)for(let y=0;y<cells;y++){const distance=Math.hypot(x/cells-cx,y/cells-cy),heat=Math.max(0,1-distance*(2.5+layer*.08));context.fillStyle=`rgba(245,158,11,${heat*opacity})`;context.fillRect(x/cells*width,y/cells*height,width/cells+1,height/cells+1)}set('xa-grad-layer-v',String(layer));set('xa-grad-opacity-v',`${Math.round(opacity*100)}%`);set('xa-grad-score',klass==='background'?'0.42':'0.87');set('xa-grad-region',klass==='background'?'lower scene':klass==='cat'?'face & ears':'head & torso')}segment('xa-grad-class',drawGrad);['xa-grad-layer','xa-grad-opacity'].forEach(name=>range(name).addEventListener('input',drawGrad));
  function renderCounter(){const income=Number(range('xa-counter-income').value),debt=Number(range('xa-counter-debt').value),allowed=active('xa-counter-allowed'),score=Math.max(.05,Math.min(.95,.18+(income-2000)/8000*.65+(70-debt)/65*.22)),need=Math.max(0,.5-score),incomeChange=Math.ceil(need/.65*8000/250)*250,debtChange=Math.ceil(need/.22*65),feasible=need===0||allowed==='both'||(allowed==='income'&&income+incomeChange<=10000)||(allowed==='debt'&&debt-debtChange>=5);set('xa-counter-income-v',`$${income.toLocaleString()}`);set('xa-counter-debt-v',`${debt}%`);set('xa-counter-current',`${score>=.5?'approved':'denied'} · ${Math.round(score*100)}%`);set('xa-counter-change',need===0?'No change needed—the current profile is already approved.':allowed==='income'?`Increase income by about $${incomeChange.toLocaleString()}.`:allowed==='debt'?`Reduce debt ratio by about ${debtChange} points.`:`Increase income by $${Math.ceil(incomeChange/2/250)*250} and reduce debt by ${Math.ceil(debtChange/2)} points.`);set('xa-counter-distance',need.toFixed(2));set('xa-counter-feasible',feasible?'yes':'no')}segment('xa-counter-allowed',renderCounter);['xa-counter-income','xa-counter-debt'].forEach(name=>range(name).addEventListener('input',renderCounter));
  function renderFair(){const method=active('xa-fair-method'),threshold=Number(range('xa-fair-threshold').value),baseGap=method==='none'?18:method==='reweight'?9:3,groups=[['Group A',Math.max(25,72-(threshold-50)*.7),84-(threshold-50)*.3,12-(threshold-50)*.12],['Group B',Math.max(20,60-(threshold-50)*.65),84-baseGap-(threshold-50)*.25,9-(threshold-50)*.1]],body=get('xa-fair-table');body.replaceChildren(...groups.map(group=>{const row=document.createElement('tr');group.forEach((cell,index)=>{const td=document.createElement('td');td.textContent=index?`${Math.round(Number(cell))}%`:String(cell);row.append(td)});return row}));const accuracy=method==='threshold'?79:method==='reweight'?82:84;set('xa-fair-threshold-v',`${threshold}%`);set('xa-fair-gap',`${baseGap} pt`);set('xa-fair-accuracy',`${accuracy}%`);set('xa-fair-status',baseGap<=5?'Equal-opportunity gap is within the 5-point review target.':'The true-positive-rate gap exceeds the 5-point review target.')}segment('xa-fair-method',renderFair);range('xa-fair-threshold').addEventListener('input',renderFair);
  function renderLlm(){const layer=Number(range('xa-llm-layer').value),intervention=active('xa-llm-intervention'),progress=layer/12,paris=Math.max(.08,progress*(intervention==='ablate'?.68:intervention==='steer'?1.12:1)),tokens=[{label:'Paris',value:paris},{label:'France',value:.34*(1-progress)+.08},{label:'city',value:.28*(1-progress)+.06},{label:'London',value:.18}],sum=tokens.reduce((total,item)=>total+item.value,0);tokens.forEach(item=>item.value/=sum);bars('xa-llm-bars',tokens);const top=[...tokens].sort((a,b)=>b.value-a.value)[0];set('xa-llm-layer-v',`${layer} / 12`);set('xa-llm-prediction',top.label);set('xa-llm-top',top.label);set('xa-llm-confidence',`${Math.round(top.value*100)}%`);set('xa-llm-note',intervention==='ablate'?'Ablating one attention head weakens the emerging answer, suggesting that head contributed to retrieval.':intervention==='steer'?'A concept-steering vector makes the Paris representation appear earlier and more strongly.':layer<7?'Early layers mostly represent syntax and broad context; the answer becomes explicit later.':'Later layers transform the contextual representation into a confident next-token prediction.') }segment('xa-llm-intervention',renderLlm);range('xa-llm-layer').addEventListener('input',renderLlm);
  const redraw:Record<string,()=>void>={xai:renderShap,lime:renderLime,global:renderGlobal,pdp:drawPdp,gradcam:drawGrad,counter:renderCounter,fairness:renderFair,llm:renderLlm};document.addEventListener('xai:tab',event=>requestAnimationFrame(()=>redraw[(event as CustomEvent<string>).detail]?.()));window.addEventListener('resize',()=>{const current=(document.querySelector('#tabs .tab.active') as HTMLElement)?.dataset.tab;if(current)redraw[current]?.()});
  renderShap();renderLime();renderGlobal();drawPdp();drawGrad();renderCounter();renderFair();renderLlm();
</script>
