<div id="panel-build"><div class="pg la-grid"><section class="glass la-workbench" aria-labelledby="la-build-heading"><h4 id="la-build-heading" class="la-kicker">LLM lifecycle</h4><div class="la-steps" id="la-build-steps" aria-label="Select a model-building stage"></div><article class="la-detail" id="la-build-detail" aria-live="polite"></article></section><aside class="pg-panel"><div class="ctrl"><h4>Pretraining simulator</h4><div class="field"><label for="la-train-steps">Training steps <span class="val" id="la-train-steps-v">10</span></label><input id="la-train-steps" type="range" min="5" max="50" step="5" value="10" /></div><button class="btn btn-primary" id="la-train-run" type="button">Train selected steps</button></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">STEP</div><div class="v mono" id="la-train-step">0</div></div><div class="metric"><div class="l">LOSS</div><div class="v mono" id="la-train-loss">10.40</div></div><div class="metric"><div class="l">TOKENS</div><div class="v mono la-small" id="la-train-tokens">0B</div></div><div class="metric"><div class="l">PERPLEXITY</div><div class="v mono" id="la-train-ppl">—</div></div></div><div class="la-loss" id="la-loss" role="img" aria-label="Pretraining loss history"></div></aside></div></div>

<div id="panel-local" style="display:none"><div class="pg la-grid"><section class="glass la-workbench" aria-labelledby="la-local-heading"><div class="row between center la-wrap"><h4 id="la-local-heading" class="la-kicker">Will it fit?</h4><span class="pill" id="la-fit-pill"><span class="dot emerald"></span>fits comfortably</span></div><div class="la-capacity"><div id="la-capacity-use"></div><span id="la-capacity-label">—</span></div><div class="metrics la-metrics-3" aria-live="polite"><div class="metric"><div class="l">VRAM NEEDED</div><div class="v mono" id="la-vram">—</div></div><div class="metric"><div class="l">TOKENS / SEC</div><div class="v mono" id="la-tps">—</div></div><div class="metric"><div class="l">DISK SIZE</div><div class="v mono" id="la-disk">—</div></div></div><div class="eqn la-equation">VRAM ≈ params × bytes/weight × overhead</div></section><aside class="pg-panel"><div class="ctrl"><h4>Model size</h4><div class="seg" id="la-model-size"><button data-v="3">3B</button><button class="active" data-v="7">7B</button><button data-v="13">13B</button><button data-v="34">34B</button><button data-v="70">70B</button></div></div><div class="ctrl"><h4>Precision</h4><div class="seg" id="la-precision"><button data-v="2">FP16</button><button data-v="1">INT8</button><button class="active" data-v="0.5">INT4</button></div></div><div class="ctrl"><h4>Hardware</h4><div class="seg" id="la-hardware"><button data-v="12">12 GB</button><button class="active" data-v="24">24 GB</button><button data-v="36">36 GB</button><button data-v="80">80 GB</button></div></div><div class="ctrl"><h4>Workload</h4><div class="seg" id="la-workload"><button class="active" data-v="infer">Inference</button><button data-v="qlora">QLoRA</button><button data-v="full">Full tune</button></div></div></aside></div></div>

<div id="panel-prompt" style="display:none"><div class="pg la-grid"><section class="glass la-workbench" aria-labelledby="la-prompt-heading"><h4 id="la-prompt-heading" class="la-kicker">Prompt stack</h4><div class="la-role system"><label for="la-system-prompt">SYSTEM</label><textarea id="la-system-prompt">You are a concise science tutor. Explain with one analogy.</textarea></div><div class="la-role user"><label for="la-user-prompt">USER</label><textarea id="la-user-prompt">Why does a neural network need an activation function?</textarea></div><div class="la-response"><span>MODEL BEHAVIOUR</span><p id="la-prompt-output" aria-live="polite">—</p></div></section><aside class="pg-panel"><div class="ctrl"><h4>Output style</h4><div class="seg" id="la-prompt-style"><button class="active" data-v="concise">Concise</button><button data-v="step">Stepwise</button><button data-v="json">JSON</button></div></div><div class="ctrl"><div class="field"><label for="la-prompt-temp">Temperature <span class="val" id="la-prompt-temp-v">0.4</span></label><input id="la-prompt-temp" type="range" min="0" max="1.5" step="0.1" value="0.4" /></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">INPUT TOKENS</div><div class="v mono" id="la-prompt-tokens">—</div></div><div class="metric"><div class="l">VARIANCE</div><div class="v mono la-small" id="la-prompt-variance">low</div></div></div><p class="note">System instructions establish behaviour; user content supplies the task. Clear constraints make outputs easier to evaluate.</p></aside></div></div>

<div id="panel-tools" style="display:none"><div class="pg la-grid"><section class="glass la-workbench" aria-labelledby="la-tools-heading"><h4 id="la-tools-heading" class="la-kicker">Structured tool call</h4><label class="la-label" for="la-tools-request">User request</label><input class="text-input" id="la-tools-request" value="What is the weather in Tokyo tomorrow?" /><div class="la-code" aria-live="polite"><span>ASSISTANT TOOL CALL</span><pre id="la-tools-call"></pre></div><div class="la-tool-result"><span>TOOL RESULT</span><p id="la-tools-result">Choose Run tool to execute the simulated call.</p></div></section><aside class="pg-panel"><div class="ctrl"><h4>Available schema</h4><div class="seg" id="la-tool-kind"><button class="active" data-v="weather">Weather</button><button data-v="search">Search</button><button data-v="calc">Calculator</button></div></div><button class="btn btn-primary" id="la-tool-run" type="button">Run tool</button><div class="metrics" aria-live="polite"><div class="metric"><div class="l">VALID JSON</div><div class="v mono la-small" id="la-tools-valid">yes</div></div><div class="metric"><div class="l">LATENCY</div><div class="v mono" id="la-tools-latency">—</div></div></div><p class="note">The model proposes a function name and typed arguments. Your application validates permission and executes it.</p></aside></div></div>

<div id="panel-agent" style="display:none"><div class="pg la-grid"><section class="glass la-workbench" aria-labelledby="la-agent-heading"><div class="row between center la-wrap"><h4 id="la-agent-heading" class="la-kicker">Plan → act → observe</h4><span class="pill" id="la-agent-state">ready</span></div><ol class="la-trace" id="la-agent-trace" aria-live="polite"></ol></section><aside class="pg-panel"><div class="ctrl"><h4>Goal</h4><p class="note">Find Tokyo’s weather and convert 20°C to Fahrenheit.</p></div><button class="btn btn-primary" id="la-agent-next" type="button">Run next agent step</button><button class="btn btn-ghost" id="la-agent-reset" type="button">Reset trace</button><div class="metrics" aria-live="polite"><div class="metric"><div class="l">ITERATION</div><div class="v mono" id="la-agent-iteration">0 / 7</div></div><div class="metric"><div class="l">TOOL CALLS</div><div class="v mono" id="la-agent-calls">0</div></div></div><p class="note">Each step is explicit, inspectable, and bounded. Production agents also need timeouts, permissions, and stop conditions.</p></aside></div></div>

<div id="panel-memory" style="display:none"><div class="pg la-grid"><section class="glass la-workbench" aria-labelledby="la-memory-heading"><h4 id="la-memory-heading" class="la-kicker">What the agent remembers</h4><div class="la-memory-list" id="la-memory-list" aria-live="polite"></div><div class="la-memory-add"><label class="sr-only" for="la-memory-input">New memory</label><input class="text-input" id="la-memory-input" aria-describedby="la-memory-error" placeholder="Add a fact, e.g. User prefers Celsius" /><button class="btn btn-primary btn-sm" id="la-memory-add" type="button">Add memory</button></div><p class="note" id="la-memory-error" role="status"></p></section><aside class="pg-panel"><div class="ctrl"><h4>Memory strategy</h4><div class="seg" id="la-memory-kind"><button class="active" data-v="window">Window</button><button data-v="summary">Summary</button><button data-v="vector">Vector</button></div></div><div class="ctrl"><div class="field"><label for="la-memory-budget">Token budget <span class="val" id="la-memory-budget-v">24</span></label><input id="la-memory-budget" type="range" min="8" max="48" step="4" value="24" /></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">RETAINED</div><div class="v mono" id="la-memory-retained">—</div></div><div class="metric"><div class="l">DROPPED</div><div class="v mono" id="la-memory-dropped">—</div></div></div><p class="note" id="la-memory-note">A sliding window keeps the newest messages and drops older context first.</p></aside></div></div>

<div id="panel-tune" style="display:none"><div class="pg la-grid"><section class="glass la-workbench" aria-labelledby="la-tune-heading"><h4 id="la-tune-heading" class="la-kicker">Base weights versus LoRA adapters</h4><div class="la-param-row"><span>Frozen base model</span><strong id="la-tune-base-label">13B parameters</strong><div class="la-param-track"><i class="base"></i></div></div><div class="la-param-row"><span>Trainable adapter</span><strong id="la-tune-adapter-label">—</strong><div class="la-param-track"><i class="adapter" id="la-tune-adapter-bar"></i></div></div><div class="eqn la-equation">W′ = W + B·A · r ≪ d</div></section><aside class="pg-panel"><div class="ctrl"><h4>Base model</h4><div class="seg" id="la-tune-size"><button data-v="7">7B</button><button class="active" data-v="13">13B</button><button data-v="70">70B</button></div></div><div class="ctrl"><div class="field"><label for="la-tune-rank">LoRA rank <span class="val" id="la-tune-rank-v">16</span></label><input id="la-tune-rank" type="range" min="4" max="128" step="4" value="16" /></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">TRAINABLE</div><div class="v mono" id="la-tune-percent">—</div></div><div class="metric"><div class="l">ADAPTER SIZE</div><div class="v mono la-small" id="la-tune-mb">—</div></div></div><p class="note">Use fine-tuning to change behaviour or style. Use retrieval when the model mainly needs fresh factual context.</p></aside></div></div>

<div id="panel-eval" style="display:none"><div class="pg la-grid"><section class="glass la-workbench" aria-labelledby="la-eval-heading"><h4 id="la-eval-heading" class="la-kicker">Evaluation scorecard</h4><div class="la-scorecards" id="la-scorecards" aria-live="polite"></div><div class="la-failures"><h4>Failure analysis</h4><div id="la-failure-bars"></div></div></section><aside class="pg-panel"><div class="ctrl"><h4>Candidate model</h4><div class="seg" id="la-eval-model"><button class="active" data-v="base">Base</button><button data-v="sft">SFT</button><button data-v="aligned">Aligned</button></div></div><div class="ctrl"><div class="field"><label for="la-eval-cases">Test cases <span class="val" id="la-eval-cases-v">200</span></label><input id="la-eval-cases" type="range" min="50" max="1000" step="50" value="200" /></div><div class="field"><label for="la-eval-safety">Safety threshold <span class="val" id="la-eval-safety-v">80%</span></label><input id="la-eval-safety" type="range" min="50" max="95" step="5" value="80" /></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">RELEASE GATE</div><div class="v mono la-small" id="la-eval-gate">—</div></div><div class="metric"><div class="l">EST. COST</div><div class="v mono" id="la-eval-cost">—</div></div></div><p class="note">Automated metrics catch regressions; human review is still required for nuanced quality and high-impact safety decisions.</p></aside></div></div>

<style>
  .la-grid{grid-template-columns:minmax(0,1fr) 340px}.la-workbench{padding:26px;border-radius:var(--r-lg);min-width:0}.la-kicker{font:12px var(--mono);text-transform:uppercase;color:var(--ink-mute);margin:0 0 14px}.la-small{font-size:14px!important}.la-wrap{flex-wrap:wrap;gap:10px}.la-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.la-steps button{border:1px solid var(--stroke);border-radius:11px;background:var(--surface);color:var(--ink-soft);padding:12px;text-align:left}.la-steps button.active{border-color:var(--violet);color:var(--violet)}.la-steps small{display:block;font:10px var(--mono);color:var(--ink-mute);margin-bottom:4px}.la-detail{border:1px solid var(--stroke);border-radius:13px;padding:20px;margin-top:18px}.la-detail h3{font-size:20px;margin-bottom:8px}.la-detail p{color:var(--ink-soft);line-height:1.6;margin:0}.la-loss{height:90px;display:flex;align-items:flex-end;gap:3px;border-bottom:1px solid var(--stroke)}.la-loss i{flex:1;background:var(--rose);min-height:3px;border-radius:3px 3px 0 0}.la-capacity{height:40px;border:1px solid var(--stroke);border-radius:10px;background:var(--surface);position:relative;overflow:hidden;margin:24px 0}.la-capacity>div{height:100%;background:var(--violet)}.la-capacity span{position:absolute;inset:0;display:grid;place-items:center;font:12px var(--mono);color:var(--ink)}.la-metrics-3{grid-template-columns:repeat(3,1fr)}.la-equation{margin-top:22px}.la-role{border:1px solid var(--stroke);border-radius:12px;padding:14px;margin-bottom:12px}.la-role span,.la-response span,.la-code span,.la-tool-result span{display:block;font:10px var(--mono);color:var(--ink-mute);margin-bottom:7px}.la-role textarea{width:100%;min-height:72px;border:0;background:transparent;color:var(--ink);resize:vertical;font:14px var(--sans);outline:none}.la-role.system{border-left:3px solid var(--violet)}.la-role.user{border-left:3px solid var(--cyan)}.la-response,.la-tool-result{border:1px solid var(--stroke);border-radius:12px;padding:16px}.la-response p,.la-tool-result p{margin:0;color:var(--ink-soft);line-height:1.55}.la-label{display:block;font-size:12px;color:var(--ink-mute);margin-bottom:7px}.la-code{background:#101018;border-radius:12px;padding:16px;margin:18px 0;color:#D9E0FF}.la-code pre{margin:0;white-space:pre-wrap;font:12px/1.6 var(--mono)}.la-trace{display:grid;gap:8px;padding:0;list-style:none}.la-trace li{border:1px solid var(--stroke);border-radius:10px;padding:12px;display:grid;grid-template-columns:92px 1fr;gap:10px;font-size:13px}.la-trace strong{font:11px var(--mono);color:var(--violet)}.la-memory-list{display:grid;gap:8px}.la-memory-card{border:1px solid var(--stroke);border-radius:10px;padding:12px;display:flex;justify-content:space-between;gap:12px;color:var(--ink-soft);font-size:13px}.la-memory-card.dropped{opacity:.55;text-decoration:line-through}.la-memory-card span{font:10px var(--mono);color:var(--ink-mute)}.la-memory-add{display:grid;grid-template-columns:1fr auto;gap:8px;margin-top:14px}.la-param-row{display:grid;grid-template-columns:1fr auto;gap:8px;margin-bottom:24px}.la-param-row span{color:var(--ink-soft)}.la-param-row strong{font:12px var(--mono)}.la-param-track{grid-column:1/-1;height:18px;border-radius:6px;background:var(--surface);overflow:hidden}.la-param-track i{display:block;height:100%}.la-param-track .base{width:100%;background:var(--ink-mute)}.la-param-track .adapter{background:var(--emerald);min-width:3px}.la-scorecards{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.la-score{border:1px solid var(--stroke);border-radius:11px;padding:16px}.la-score span{font:10px var(--mono);color:var(--ink-mute)}.la-score strong{display:block;font:24px var(--mono);margin-top:8px}.la-failures{margin-top:24px}.la-failures h4{font-size:13px;margin-bottom:12px}.la-failure{display:grid;grid-template-columns:100px 1fr 42px;gap:8px;align-items:center;margin:9px 0;font:11px var(--mono);color:var(--ink-mute)}.la-failure div{height:8px;border-radius:4px;background:var(--surface);overflow:hidden}.la-failure i{display:block;height:100%;background:var(--rose)}
  .la-role label{display:block;font:10px var(--mono);color:var(--ink-mute);margin-bottom:7px}
  @media(max-width:900px){.la-grid{grid-template-columns:1fr}}@media(max-width:650px){.la-workbench{padding:18px}.la-steps{grid-template-columns:repeat(2,1fr)}.la-metrics-3,.la-scorecards{grid-template-columns:1fr}.la-trace li{grid-template-columns:1fr}.la-memory-add{grid-template-columns:1fr}}
</style>

<script>
  const by=(name:string)=>document.getElementById(name)!;const field=(name:string)=>by(name) as HTMLInputElement;const put=(name:string,value:string)=>{by(name).textContent=value};function segment(name:string,render:()=>void){const root=by(name);root.querySelectorAll('button').forEach(button=>button.setAttribute('aria-pressed',String(button.classList.contains('active'))));root.addEventListener('click',event=>{const button=(event.target as Element).closest('button');if(!button)return;root.querySelectorAll('button').forEach(item=>{const active=item===button;item.classList.toggle('active',active);item.setAttribute('aria-pressed',String(active))});render()})}const selected=(name:string)=>(by(name).querySelector('button.active') as HTMLButtonElement).dataset.v!;
  const stages=[['01','Data','Collect, deduplicate, filter and shard a high-quality corpus. Dataset quality strongly shapes the final model.'],['02','Tokenizer','Train a subword vocabulary that balances compact common words with coverage of unusual text.'],['03','Architecture','Choose depth, width, attention heads, normalization and position encoding for the parameter budget.'],['04','Pretrain','Optimize next-token prediction across the corpus until validation loss stops improving.'],['05','SFT','Teach instruction following with curated prompt-and-response demonstrations.'],['06','Align','Use preferences and safety data with DPO or RLHF to shape model behaviour.'],['07','Quantize','Compress weights for lower memory use and faster inference with an acceptable quality tradeoff.'],['08','Deploy','Serve with batching and KV caching, then monitor latency, cost, quality and safety.']];let stageIndex=0,trainStep=0,lossHistory:number[]=[];const stepsRoot=by('la-build-steps');stepsRoot.replaceChildren(...stages.map((stage,index)=>{const button=document.createElement('button'),small=document.createElement('small');button.type='button';small.textContent=stage[0];button.append(small,document.createTextNode(stage[1]));button.classList.toggle('active',index===0);button.setAttribute('aria-pressed',String(index===0));button.addEventListener('click',()=>{stageIndex=index;renderBuild()});return button}));function renderBuild(){stepsRoot.querySelectorAll('button').forEach((button,index)=>{const active=index===stageIndex;button.classList.toggle('active',active);button.setAttribute('aria-pressed',String(active))});const stage=stages[stageIndex],detail=by('la-build-detail');detail.replaceChildren();const heading=document.createElement('h3'),body=document.createElement('p');heading.textContent=stage[1];body.textContent=stage[2];detail.append(heading,body);put('la-train-steps-v',field('la-train-steps').value)}function renderLoss(){const root=by('la-loss'),max=10.4,min=1.8;root.replaceChildren(...lossHistory.slice(-50).map(value=>{const bar=document.createElement('i');bar.style.height=`${Math.max(3,(value-min)/(max-min)*100)}%`;return bar}))}field('la-train-steps').addEventListener('input',renderBuild);by('la-train-run').addEventListener('click',()=>{const count=Number(field('la-train-steps').value);for(let i=0;i<count;i++){trainStep++;lossHistory.push(1.9+8.5*Math.exp(-trainStep/60)+(trainStep%4)*.018)}const loss=lossHistory.at(-1)||10.4;put('la-train-step',String(trainStep));put('la-train-loss',loss.toFixed(2));put('la-train-tokens',`${(trainStep*4.2).toFixed(0)}B`);put('la-train-ppl',Math.exp(Math.min(loss,7)).toFixed(0));renderLoss()});
  function renderLocal(){const size=Number(selected('la-model-size')),bytes=Number(selected('la-precision')),capacity=Number(selected('la-hardware')),workload=selected('la-workload');let vram=size*bytes*1.15+.6,tps=1400/(size*bytes);if(workload==='qlora'){vram=size*.78+1.5;tps=0}else if(workload==='full'){vram=size*16.2+2;tps=0}const disk=size*bytes,fits=vram<=capacity,pct=Math.min(100,vram/capacity*100),bar=by('la-capacity-use');bar.style.width=`${pct}%`;bar.style.background=fits?'var(--violet)':'var(--rose)';put('la-capacity-label',`${vram.toFixed(1)} GB / ${capacity} GB`);put('la-vram',`${vram.toFixed(1)} GB`);put('la-tps',tps?`${Math.round(tps)}/s`:'—');put('la-disk',`${disk.toFixed(1)} GB`);by('la-fit-pill').innerHTML=`<span class="dot ${fits?'emerald':'rose'}"></span>${fits?(pct>85?'tight fit':'fits comfortably'):"won't fit"}`}
  ['la-model-size','la-precision','la-hardware','la-workload'].forEach(name=>segment(name,renderLocal));
  function renderPrompt(){const system=(by('la-system-prompt') as HTMLTextAreaElement).value,user=(by('la-user-prompt') as HTMLTextAreaElement).value,style=selected('la-prompt-style'),temperature=Number(field('la-prompt-temp').value),tokens=Math.ceil((system.length+user.length)/4),base='An activation function bends the network’s otherwise linear calculations, like adding joints to a rigid arm so it can reach curved paths.';put('la-prompt-output',style==='json'?JSON.stringify({answer:base,analogy:'joints in an arm'}):style==='step'?`1. Layers combine inputs. 2. Without activation, stacked layers stay linear. 3. Non-linearity lets the network learn curved boundaries.`:base);put('la-prompt-temp-v',temperature.toFixed(1));put('la-prompt-tokens',String(tokens));put('la-prompt-variance',temperature<.5?'low':temperature<1?'medium':'high')}['la-system-prompt','la-user-prompt'].forEach(name=>by(name).addEventListener('input',renderPrompt));segment('la-prompt-style',renderPrompt);field('la-prompt-temp').addEventListener('input',renderPrompt);
  function toolCall(){const kind=selected('la-tool-kind'),request=field('la-tools-request').value,location=request.match(/in ([A-Za-z ]+?)(?: tomorrow|\?|$)/i)?.[1]?.trim()||'Tokyo',call=kind==='weather'?{name:'get_weather',arguments:{location,day:request.toLowerCase().includes('tomorrow')?'tomorrow':'today'}}:kind==='search'?{name:'web_search',arguments:{query:request}}:{name:'calculator',arguments:{expression:request.match(/[\d+*/(). -]+/)?.[0]?.trim()||'20 * 9/5 + 32'}};by('la-tools-call').textContent=JSON.stringify(call,null,2);put('la-tools-valid','yes')}segment('la-tool-kind',toolCall);field('la-tools-request').addEventListener('input',toolCall);by('la-tool-run').addEventListener('click',()=>{const kind=selected('la-tool-kind');put('la-tools-result',kind==='weather'?'Tokyo: 18°C, light rain.':kind==='search'?'3 relevant results returned.':'Result: 68');put('la-tools-latency',kind==='search'?'420 ms':'86 ms')});
  const trace=[['THOUGHT','I need weather data first.'],['ACTION','get_weather(location="Tokyo")'],['OBSERVATION','18°C, light rain.'],['THOUGHT','Now convert 20°C with the calculator.'],['ACTION','calculator("20 * 9/5 + 32")'],['OBSERVATION','68'],['ANSWER','Tokyo is 18°C with light rain; 20°C equals 68°F.']];let traceStep=0;function renderTrace(){const root=by('la-agent-trace');root.replaceChildren(...trace.slice(0,traceStep).map(item=>{const row=document.createElement('li'),tag=document.createElement('strong'),body=document.createElement('span');tag.textContent=item[0];body.textContent=item[1];row.append(tag,body);return row}));put('la-agent-state',traceStep===trace.length?'complete':traceStep?'running':'ready');put('la-agent-iteration',`${traceStep} / ${trace.length}`);put('la-agent-calls',String(trace.slice(0,traceStep).filter(item=>item[0]==='ACTION').length));put('la-agent-next',traceStep===trace.length?'Trace complete':'Run next agent step');(by('la-agent-next') as HTMLButtonElement).disabled=traceStep===trace.length}by('la-agent-next').addEventListener('click',()=>{traceStep=Math.min(trace.length,traceStep+1);renderTrace()});by('la-agent-reset').addEventListener('click',()=>{traceStep=0;renderTrace()});
  let memories=['User prefers Celsius','Project is an Astro learning atlas','Last topic was transformer attention','User asked for concise explanations'];function renderMemory(){const kind=selected('la-memory-kind'),budget=Number(field('la-memory-budget').value),costs=memories.map(item=>Math.ceil(item.length/4)),keep=kind==='summary'?memories.map(()=>true):kind==='vector'?memories.map(item=>/Astro|transformer/i.test(item)):memories.map(()=>true);if(kind==='window'){let used=0;for(let i=memories.length-1;i>=0;i--){if(used+costs[i]<=budget)used+=costs[i];else keep[i]=false}}const root=by('la-memory-list');root.replaceChildren(...memories.map((memory,index)=>{const card=document.createElement('div'),cost=document.createElement('span');card.className=`la-memory-card${keep[index]?'':' dropped'}`;card.append(document.createTextNode(memory));cost.textContent=`${costs[index]} tok`;card.append(cost);return card}));put('la-memory-budget-v',String(budget));put('la-memory-retained',String(keep.filter(Boolean).length));put('la-memory-dropped',String(keep.filter(value=>!value).length));put('la-memory-note',kind==='window'?'A sliding window keeps the newest messages and drops older context first.':kind==='summary'?'Summaries compress all earlier turns, trading detail for a smaller footprint.':'Vector memory retrieves only facts semantically relevant to the current task.')}segment('la-memory-kind',renderMemory);field('la-memory-budget').addEventListener('input',renderMemory);by('la-memory-add').addEventListener('click',()=>{const value=field('la-memory-input').value.trim();if(!value){put('la-memory-error','Enter a memory before adding it.');field('la-memory-input').setAttribute('aria-invalid','true');return}memories.push(value);field('la-memory-input').value='';field('la-memory-input').removeAttribute('aria-invalid');put('la-memory-error','Memory added.');renderMemory()});
  function renderTune(){const size=Number(selected('la-tune-size')),rank=Number(field('la-tune-rank').value),layers=Math.floor(size*4),params=2*4096*rank*layers*8,pct=params/(size*1e9)*100,mb=params*2/1e6;put('la-tune-base-label',`${size}B parameters`);put('la-tune-adapter-label',`${pct.toFixed(2)}% trainable`);put('la-tune-rank-v',String(rank));put('la-tune-percent',`${pct.toFixed(2)}%`);put('la-tune-mb',`${mb.toFixed(0)} MB`);(by('la-tune-adapter-bar') as HTMLElement).style.width=`${Math.max(1,Math.min(100,pct*9))}%`}segment('la-tune-size',renderTune);field('la-tune-rank').addEventListener('input',renderTune);
  const evalData={base:{quality:61,safety:68,grounded:54,fail:[22,18,14]},sft:{quality:79,safety:77,grounded:68,fail:[13,10,9]},aligned:{quality:82,safety:91,grounded:75,fail:[8,4,7]}};function renderEval(){const model=selected('la-eval-model'),data=evalData[model as keyof typeof evalData],cases=Number(field('la-eval-cases').value),threshold=Number(field('la-eval-safety').value),scores=[['QUALITY',data.quality],['SAFETY',data.safety],['GROUNDED',data.grounded]],root=by('la-scorecards');root.replaceChildren(...scores.map(([label,value])=>{const card=document.createElement('div'),name=document.createElement('span'),score=document.createElement('strong');card.className='la-score';name.textContent=String(label);score.textContent=`${value}%`;card.append(name,score);return card}));const failures=[['Hallucination',data.fail[0]],['Unsafe',data.fail[1]],['Format',data.fail[2]]],failureRoot=by('la-failure-bars');failureRoot.replaceChildren(...failures.map(([label,value])=>{const row=document.createElement('div'),name=document.createElement('span'),track=document.createElement('div'),fill=document.createElement('i'),count=document.createElement('span');row.className='la-failure';name.textContent=String(label);fill.style.width=`${Number(value)*3}%`;track.append(fill);count.textContent=`${value}%`;row.append(name,track,count);return row}));put('la-eval-cases-v',String(cases));put('la-eval-safety-v',`${threshold}%`);put('la-eval-gate',data.safety>=threshold&&data.quality>=75?'PASS':'BLOCK');put('la-eval-cost',`$${(cases*.012).toFixed(2)}`)}segment('la-eval-model',renderEval);field('la-eval-cases').addEventListener('input',renderEval);field('la-eval-safety').addEventListener('input',renderEval);
  renderBuild();renderLocal();renderPrompt();toolCall();renderTrace();renderMemory();renderTune();renderEval();
