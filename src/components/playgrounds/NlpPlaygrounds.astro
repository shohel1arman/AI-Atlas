<div id="panel-tok">
  <div class="pg nlp-grid">
    <section class="glass nlp-workbench" aria-labelledby="nlp-tok-heading">
      <h4 id="nlp-tok-heading" class="nlp-kicker">Type anything</h4>
      <label class="sr-only" for="nlp-tok-input">Text to tokenize</label>
      <input class="text-input" id="nlp-tok-input" value="Transformers turned attention into intelligence." spellcheck="false" />
      <h4 class="nlp-kicker nlp-space-top">Tokens → IDs</h4>
      <div class="tok-row" id="nlp-tok-output" aria-live="polite"></div>
    </section>
    <aside class="pg-panel">
      <div class="metrics" aria-live="polite"><div class="metric"><div class="l">TOKENS</div><div class="v mono" id="nlp-tok-count">—</div></div><div class="metric"><div class="l">CHARS</div><div class="v mono" id="nlp-char-count">—</div></div></div>
      <div class="ctrl"><h4>What happened</h4><p class="note">A model reads <b>token IDs</b>, not letters. Common pieces stay whole while uncommon words split into reusable subwords.</p></div>
      <div class="ctrl"><h4>Rule of thumb</h4><p class="note">English averages roughly four characters per token, so context windows and API usage are counted in tokens.</p></div>
    </aside>
  </div>
</div>

<div id="panel-tfidf" style="display:none">
  <div class="pg nlp-grid">
    <section class="glass nlp-workbench" aria-labelledby="nlp-tfidf-heading">
      <div class="row between center nlp-wrap"><h4 id="nlp-tfidf-heading" class="nlp-kicker">Term weights in this document</h4><div class="seg" id="nlp-doc-seg"></div></div>
      <p class="note mono nlp-document" id="nlp-doc-text"></p><div id="nlp-tfidf-bars" aria-live="polite"></div>
    </section>
    <aside class="pg-panel"><div class="ctrl"><h4>TF · IDF</h4><p class="note"><b>Term frequency</b> rewards local repetition. <b>Inverse document frequency</b> suppresses words found in every document.</p></div><div class="metrics"><div class="metric"><div class="l">TOP TERM</div><div class="v mono nlp-metric-small" id="nlp-tfidf-top">—</div></div><div class="metric"><div class="l">SCORE</div><div class="v mono" id="nlp-tfidf-score">—</div></div></div></aside>
  </div>
</div>

<div id="panel-samp" style="display:none">
  <div class="pg nlp-grid">
    <section class="glass nlp-workbench" aria-labelledby="nlp-samp-heading"><h4 id="nlp-samp-heading">The scientist opened the <span class="mono nlp-accent">___</span></h4><p class="note nlp-document">Next-token probabilities after temperature scaling:</p><div id="nlp-samp-bars"></div><div class="glass glass-hi nlp-result"><span class="mono">sampled →</span><strong class="mono nlp-accent" id="nlp-samp-pick" aria-live="polite">—</strong></div></section>
    <aside class="pg-panel"><div class="ctrl"><h4>Temperature</h4><div class="field"><label for="nlp-temp">T <span class="val" id="nlp-temp-value">0.8</span></label><input type="range" id="nlp-temp" min="0.1" max="2" step="0.1" value="0.8" /></div><p class="note" id="nlp-temp-note"></p></div><button class="btn btn-primary" id="nlp-sample" type="button">Sample a token</button><div class="ctrl"><h4>The dial</h4><p class="note">Low temperature is predictable; high temperature gives unlikely tokens more probability.</p></div></aside>
  </div>
</div>

<div id="panel-ngram" style="display:none">
  <div class="pg nlp-grid">
    <section class="glass nlp-workbench" aria-labelledby="nlp-ngram-heading"><h4 id="nlp-ngram-heading" class="nlp-kicker">Count-based next-word model</h4><label for="nlp-ngram-prompt" class="nlp-label">Prompt</label><input class="text-input" id="nlp-ngram-prompt" value="the model" spellcheck="false" /><div class="nlp-flow" id="nlp-ngram-context" aria-live="polite"></div><div id="nlp-ngram-bars"></div></section>
    <aside class="pg-panel"><div class="ctrl"><h4>Context length</h4><div class="seg" id="nlp-ngram-size"><button data-v="1">1-gram</button><button data-v="2" class="active">2-gram</button><button data-v="3">3-gram</button></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">MATCHES</div><div class="v mono" id="nlp-ngram-matches">—</div></div><div class="metric"><div class="l">VOCAB</div><div class="v mono" id="nlp-ngram-vocab">—</div></div></div><p class="note">Longer context is more specific, but sparse counts mean it may have seen no matching phrase.</p></aside>
  </div>
</div>

<div id="panel-embed" style="display:none">
  <div class="pg nlp-grid">
    <section class="glass nlp-workbench" aria-labelledby="nlp-embed-heading"><div class="row between center nlp-wrap"><h4 id="nlp-embed-heading" class="nlp-kicker">Semantic neighbourhood</h4><span class="pill"><span class="dot violet"></span>cosine similarity</span></div><div class="nlp-map" id="nlp-embed-map" role="img" aria-label="Two-dimensional map of related word embeddings"></div></section>
    <aside class="pg-panel"><div class="ctrl"><h4>Anchor word</h4><div class="seg" id="nlp-embed-anchor"><button class="active" data-v="king">king</button><button data-v="apple">apple</button><button data-v="code">code</button></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">NEAREST</div><div class="v mono nlp-metric-small" id="nlp-embed-nearest">—</div></div><div class="metric"><div class="l">SIMILARITY</div><div class="v mono" id="nlp-embed-score">—</div></div></div><p class="note">Embeddings place words used in similar contexts near one another. Direction can encode relationships as well as similarity.</p></aside>
  </div>
</div>

<div id="panel-cls" style="display:none">
  <div class="pg nlp-grid">
    <section class="glass nlp-workbench" aria-labelledby="nlp-cls-heading"><h4 id="nlp-cls-heading" class="nlp-kicker">Sentiment classifier</h4><label for="nlp-cls-input" class="nlp-label">Review text</label><textarea class="text-input nlp-textarea" id="nlp-cls-input">The setup was confusing, but the final result is genuinely excellent.</textarea><h4 class="nlp-kicker nlp-space-top">Token contributions</h4><div id="nlp-cls-tokens" class="nlp-flow" aria-live="polite"></div></section>
    <aside class="pg-panel"><div class="metrics" aria-live="polite"><div class="metric"><div class="l">LABEL</div><div class="v mono nlp-metric-small" id="nlp-cls-label">—</div></div><div class="metric"><div class="l">CONFIDENCE</div><div class="v mono" id="nlp-cls-confidence">—</div></div></div><div class="ctrl"><h4>Decision threshold</h4><div class="field"><label for="nlp-cls-threshold">Positive at <span class="val" id="nlp-cls-threshold-v">50%</span></label><input type="range" id="nlp-cls-threshold" min="20" max="80" value="50" /></div></div><p class="note">The toy model sums word evidence, handles simple negation, and converts the score into a probability.</p></aside>
  </div>
</div>

<div id="panel-ner" style="display:none">
  <div class="pg nlp-grid">
    <section class="glass nlp-workbench" aria-labelledby="nlp-ner-heading"><h4 id="nlp-ner-heading" class="nlp-kicker">Find entities in context</h4><label for="nlp-ner-input" class="nlp-label">Sentence</label><textarea class="text-input nlp-textarea" id="nlp-ner-input">Maya joined OpenAI in San Francisco on Monday.</textarea><div class="nlp-entity-output" id="nlp-ner-output" aria-live="polite"></div></section>
    <aside class="pg-panel"><div class="ctrl"><h4>Entity scheme</h4><div class="seg" id="nlp-ner-mode"><button class="active" data-v="general">General</button><button data-v="medical">Medical</button></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">ENTITIES</div><div class="v mono" id="nlp-ner-count">—</div></div><div class="metric"><div class="l">TYPES</div><div class="v mono" id="nlp-ner-types">—</div></div></div><div class="nlp-legend"><span><i class="person"></i>person</span><span><i class="org"></i>org</span><span><i class="place"></i>place</span><span><i class="time"></i>time</span></div></aside>
  </div>
</div>

<div id="panel-seq2seq" style="display:none">
  <div class="pg nlp-grid">
    <section class="glass nlp-workbench" aria-labelledby="nlp-seq-heading"><h4 id="nlp-seq-heading" class="nlp-kicker">Encode → decode</h4><div class="nlp-translation"><div><span>INPUT</span><strong>the model learns quickly</strong></div><div class="nlp-arrow" aria-hidden="true">→</div><div><span>OUTPUT</span><strong id="nlp-seq-output" aria-live="polite">—</strong></div></div><div class="nlp-beams" id="nlp-seq-beams"></div></section>
    <aside class="pg-panel"><div class="ctrl"><h4>Target language</h4><div class="seg" id="nlp-seq-language"><button class="active" data-v="fr">French</button><button data-v="es">Spanish</button><button data-v="de">German</button></div></div><div class="ctrl"><div class="field"><label for="nlp-seq-width">Beam width <span class="val" id="nlp-seq-width-v">3</span></label><input type="range" id="nlp-seq-width" min="1" max="5" value="3" /></div></div><button class="btn btn-primary" id="nlp-seq-decode" type="button">Decode next step</button><div class="metrics" aria-live="polite"><div class="metric"><div class="l">STEP</div><div class="v mono" id="nlp-seq-step">0 / 4</div></div><div class="metric"><div class="l">TOP SCORE</div><div class="v mono" id="nlp-seq-score">—</div></div></div></aside>
  </div>
</div>

<style>
  .nlp-grid{grid-template-columns:minmax(0,1fr) 320px}.nlp-workbench{padding:26px;border-radius:var(--r-lg);min-width:0}.nlp-workbench .pbar i{transition:none}.nlp-kicker{font-size:12px;font-family:var(--mono);text-transform:uppercase;color:var(--ink-mute);margin:0 0 12px}.nlp-space-top{margin-top:22px}.nlp-wrap{flex-wrap:wrap;gap:10px}.nlp-document{margin:18px 0 20px;color:var(--ink-soft);font-size:13px;line-height:1.7}.nlp-result{margin-top:20px;padding:16px 18px;border-radius:14px;display:flex;align-items:center;gap:12px}.nlp-accent{color:var(--violet)}.nlp-label{display:block;font-size:12px;color:var(--ink-mute);margin-bottom:7px}.nlp-textarea{min-height:92px;resize:vertical;line-height:1.55}.nlp-flow{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0}.nlp-chip{border:1px solid var(--stroke);background:var(--surface);color:var(--ink-soft);border-radius:8px;padding:7px 9px;font:12px var(--mono)}.nlp-chip.pos{border-color:#22C55E;color:#166534;background:#DCFCE7}.nlp-chip.neg{border-color:#FB7185;color:#9F1239;background:#FFE4E6}.nlp-metric-small{font-size:14px!important}.nlp-map{position:relative;min-height:330px;border:1px solid var(--stroke);border-radius:14px;background:var(--surface);overflow:hidden}.nlp-word{position:absolute;transform:translate(-50%,-50%);border:1px solid var(--stroke);background:var(--surface);color:var(--ink-soft);border-radius:999px;padding:6px 10px;font:12px var(--mono)}.nlp-word.anchor{border-color:var(--violet);background:var(--violet);color:white}.nlp-word.near{border-color:var(--violet);color:var(--violet)}.nlp-entity-output{margin-top:20px;padding:20px;border:1px solid var(--stroke);border-radius:14px;font-size:18px;line-height:2.2}.nlp-entity{display:inline-block;border-radius:5px;padding:0 4px;margin:0 2px}.nlp-entity small{font:9px var(--mono);margin-left:4px}.nlp-entity.person{background:#DBEAFE;color:#1E40AF}.nlp-entity.org{background:#EDE9FE;color:#5B21B6}.nlp-entity.place{background:#D1FAE5;color:#065F46}.nlp-entity.time{background:#FEF3C7;color:#92400E}.nlp-legend{display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:12px;color:var(--ink-mute)}.nlp-legend i{display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:6px}.nlp-legend .person{background:#60A5FA}.nlp-legend .org{background:#A78BFA}.nlp-legend .place{background:#34D399}.nlp-legend .time{background:#FBBF24}.nlp-translation{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:18px;margin:22px 0}.nlp-translation>div:not(.nlp-arrow){border:1px solid var(--stroke);border-radius:14px;padding:18px;min-height:94px}.nlp-translation span{display:block;font:10px var(--mono);color:var(--ink-mute);margin-bottom:10px}.nlp-translation strong{font-size:16px;color:var(--ink)}.nlp-arrow{color:var(--violet);font-size:24px}.nlp-beams{display:grid;gap:8px}.nlp-beam{display:grid;grid-template-columns:1fr 58px;gap:12px;align-items:center;font:12px var(--mono);color:var(--ink-soft)}.nlp-beam i{display:block;height:6px;border-radius:999px;background:var(--violet)}
  @media(max-width:850px){.nlp-grid{grid-template-columns:1fr}.nlp-map{min-height:280px}}@media(max-width:560px){.nlp-workbench{padding:18px}.nlp-translation{grid-template-columns:1fr}.nlp-arrow{transform:rotate(90deg);text-align:center}}
</style>

<script>
  const id=(name:string)=>document.getElementById(name)!; const input=(name:string)=>id(name) as HTMLInputElement; const set=(name:string,text:string)=>{id(name).textContent=text};
  function segmented(name:string,render:()=>void){const root=id(name);root.querySelectorAll('button').forEach(button=>button.setAttribute('aria-pressed',String(button.classList.contains('active'))));root.addEventListener('click',event=>{const button=(event.target as Element).closest('button');if(!button)return;root.querySelectorAll('button').forEach(item=>{const active=item===button;item.classList.toggle('active',active);item.setAttribute('aria-pressed',String(active))});render()})}
  const selected=(name:string)=>(id(name).querySelector('button.active') as HTMLButtonElement).dataset.v!;
  const hash=(value:string)=>{let h=2166136261;for(const char of value){h^=char.charCodeAt(0);h=Math.imul(h,16777619)}return(h>>>0)%50000};
  const common=new Set(['the','a','an','to','of','in','is','it','and','into','turned','open','opened','model','models','word','attention','data']);
  function tokenize(text:string){const words=text.toLowerCase().match(/[a-z']+|[0-9]+|[^\sa-z0-9]/gi)||[];return words.flatMap(word=>{if(word.length<=4||common.has(word)||/[^a-z]/i.test(word))return[word];const parts=[];for(let i=0;i<word.length;i+=4)parts.push((i?'##':'')+word.slice(i,i+4));return parts})}
  function renderTokens(){const text=input('nlp-tok-input').value,tokens=tokenize(text),out=id('nlp-tok-output');out.replaceChildren(...tokens.map(token=>{const chip=document.createElement('span'),word=document.createElement('b'),small=document.createElement('small');chip.className='tok id';word.textContent=token;small.textContent=String(hash(token));chip.append(word,small);return chip}));set('nlp-tok-count',String(tokens.length));set('nlp-char-count',String(text.length))}
  input('nlp-tok-input').addEventListener('input',renderTokens);

  const docs=[{name:'Space',text:'the rocket reached orbit as the rocket engine burned bright'},{name:'Cooking',text:'the chef seared the garlic then the chef plated the dish'},{name:'Finance',text:'the market rallied as investors bought the market dip'},{name:'ML',text:'the model learned the pattern as the model reduced its loss'}],stop=new Set(['the','a','an','as','then','its','it','of','to','and','in']);let docIndex=0;
  const docSeg=id('nlp-doc-seg');docs.forEach((doc,index)=>{const button=document.createElement('button');button.textContent=doc.name;button.dataset.v=String(index);button.classList.toggle('active',index===0);docSeg.append(button)});
  function renderTfidf(){const doc=docs[docIndex],words=doc.text.split(/\s+/),counts=new Map<string,number>();words.forEach(word=>counts.set(word,(counts.get(word)||0)+1));const scores=[...counts].filter(([term])=>!stop.has(term)).map(([term,count])=>{const df=docs.filter(item=>item.text.split(/\s+/).includes(term)).length;return{term,score:count/words.length*(Math.log(docs.length/df)+1)}}).sort((a,b)=>b.score-a.score),max=scores[0]?.score||1;set('nlp-doc-text',`“${doc.text}”`);renderBars('nlp-tfidf-bars',scores.map(item=>({label:item.term,value:item.score/max,text:item.score.toFixed(2)})));set('nlp-tfidf-top',scores[0]?.term||'—');set('nlp-tfidf-score',scores[0]?.score.toFixed(2)||'—')}
  segmented('nlp-doc-seg',()=>{docIndex=Number(selected('nlp-doc-seg'));renderTfidf()});

  function renderBars(rootId:string,rows:{label:string,value:number,text:string}[]){const root=id(rootId);root.replaceChildren(...rows.map(row=>{const line=document.createElement('div');line.className='prob-row';const label=document.createElement('span');label.className='pt';label.textContent=row.label;const track=document.createElement('div');track.className='pbar';const fill=document.createElement('i');fill.style.width=`${Math.max(2,row.value*100).toFixed(0)}%`;track.append(fill);const value=document.createElement('span');value.className='pv';value.textContent=row.text;line.append(label,track,value);return line}))}
  const candidates=[['door',3.2],['book',2.6],['window',2],['laptop',1.5],['portal',.6],['umbrella',-.4]] as [string,number][];let temperature=.8;
  function softmax(logits:number[],temp:number){const scaled=logits.map(value=>value/temp),max=Math.max(...scaled),exp=scaled.map(value=>Math.exp(value-max)),sum=exp.reduce((a,b)=>a+b,0);return exp.map(value=>value/sum)}
  function renderSampling(){const probabilities=softmax(candidates.map(item=>item[1]),temperature);renderBars('nlp-samp-bars',candidates.map((item,index)=>({label:item[0],value:probabilities[index],text:`${Math.round(probabilities[index]*100)}%`})));set('nlp-temp-value',temperature.toFixed(1));set('nlp-temp-note',temperature<=.4?'Near-greedy: the top token dominates.':temperature>=1.4?'Very flat: unlikely tokens now have a real chance.':'Balanced: mostly sensible with occasional surprise.')}
  input('nlp-temp').addEventListener('input',()=>{temperature=Number(input('nlp-temp').value);renderSampling()});id('nlp-sample').addEventListener('click',()=>{const probabilities=softmax(candidates.map(item=>item[1]),temperature);let random=Math.random(),pick=candidates[0][0];for(let i=0;i<candidates.length;i++){random-=probabilities[i];if(random<=0){pick=candidates[i][0];break}}set('nlp-samp-pick',`“${pick}”`)});

  const corpus=['the model learns from data','the model predicts the next token','a language model learns patterns','the small model runs quickly','data helps the model improve','the model learns useful features','a model predicts from context'];
  function renderNgram(){const n=Number(selected('nlp-ngram-size')),prompt=input('nlp-ngram-prompt').value.toLowerCase().trim().split(/\s+/).filter(Boolean),context=n===1?[]:prompt.slice(-(n-1)),counts=new Map<string,number>();let matches=0;for(const sentence of corpus){const words=sentence.split(' ');for(let i=0;i<words.length;i++){const before=words.slice(Math.max(0,i-context.length),i);if(!context.length||before.join(' ')===context.join(' ')){counts.set(words[i],(counts.get(words[i])||0)+1);matches++}}}const rows=[...counts].sort((a,b)=>b[1]-a[1]).slice(0,6),total=rows.reduce((sum,row)=>sum+row[1],0)||1;id('nlp-ngram-context').replaceChildren(...context.map(word=>{const chip=document.createElement('span');chip.className='nlp-chip';chip.textContent=word;return chip}));renderBars('nlp-ngram-bars',rows.map(([word,count])=>({label:word,value:count/total,text:`${Math.round(count/total*100)}%`})));set('nlp-ngram-matches',String(matches));set('nlp-ngram-vocab',String(counts.size))}
  segmented('nlp-ngram-size',renderNgram);input('nlp-ngram-prompt').addEventListener('input',renderNgram);

  const spaces={king:[['king',50,45],['queen',62,38],['prince',42,56],['royal',58,58],['apple',18,78],['code',80,78]],apple:[['apple',35,42],['fruit',48,38],['pear',29,54],['food',48,58],['king',78,24],['code',76,76]],code:[['code',48,42],['python',61,38],['program',43,56],['software',61,58],['king',18,22],['apple',22,78]]} as Record<string,[string,number,number][]>;
  function renderEmbed(){const anchor=selected('nlp-embed-anchor'),words=spaces[anchor],root=id('nlp-embed-map');root.replaceChildren(...words.map(([word,x,y],index)=>{const chip=document.createElement('span');chip.className=`nlp-word${index===0?' anchor':index<4?' near':''}`;chip.style.left=`${x}%`;chip.style.top=`${y}%`;chip.textContent=word;return chip}));set('nlp-embed-nearest',words[1][0]);const dx=words[1][1]-words[0][1],dy=words[1][2]-words[0][2];set('nlp-embed-score',(1-Math.hypot(dx,dy)/100).toFixed(2))}
  segmented('nlp-embed-anchor',renderEmbed);

  const sentiment:Record<string,number>={excellent:2.2,great:1.8,love:2,helpful:1.4,clear:1.1,good:1.2,confusing:-1.4,bad:-1.8,hate:-2,slow:-1.1,broken:-2.2,poor:-1.6};
  function renderClassifier(){const words=input('nlp-cls-input').value.toLowerCase().match(/[a-z']+/g)||[],contrib: {word:string;value:number}[]=[];let score=0,negate=false;for(const word of words){if(['not','never','hardly'].includes(word)){negate=true;continue}let value=sentiment[word]||0;if(negate&&value){value*=-.8;negate=false}if(value){contrib.push({word,value});score+=value}}const probability=1/(1+Math.exp(-score/2)),threshold=Number(input('nlp-cls-threshold').value)/100;id('nlp-cls-tokens').replaceChildren(...(contrib.length?contrib.map(item=>{const chip=document.createElement('span');chip.className=`nlp-chip ${item.value>0?'pos':'neg'}`;chip.textContent=`${item.word} ${item.value>0?'+':''}${item.value.toFixed(1)}`;return chip}):[Object.assign(document.createElement('span'),{className:'nlp-chip',textContent:'No known sentiment terms'})]));set('nlp-cls-label',probability>=threshold?'POSITIVE':'NEGATIVE');set('nlp-cls-confidence',`${Math.round(Math.max(probability,1-probability)*100)}%`);set('nlp-cls-threshold-v',`${Math.round(threshold*100)}%`)}
  input('nlp-cls-input').addEventListener('input',renderClassifier);input('nlp-cls-threshold').addEventListener('input',renderClassifier);

  const entities={general:{Maya:'person',OpenAI:'org','San Francisco':'place',Monday:'time',London:'place',Google:'org',Tuesday:'time'},medical:{aspirin:'org',diabetes:'org','New York':'place',Friday:'time'}} as Record<string,Record<string,string>>;
  function renderNer(){const text=(id('nlp-ner-input') as HTMLTextAreaElement).value,scheme=entities[selected('nlp-ner-mode')],matches=Object.entries(scheme).filter(([term])=>text.toLowerCase().includes(term.toLowerCase())).sort((a,b)=>text.toLowerCase().indexOf(a[0].toLowerCase())-text.toLowerCase().indexOf(b[0].toLowerCase())),root=id('nlp-ner-output');root.replaceChildren();let cursor=0;for(const[term,type]of matches){const start=text.toLowerCase().indexOf(term.toLowerCase(),cursor);if(start<0)continue;root.append(document.createTextNode(text.slice(cursor,start)));const mark=document.createElement('mark'),label=document.createElement('small');mark.className=`nlp-entity ${type}`;mark.textContent=text.slice(start,start+term.length);label.textContent=type.toUpperCase();mark.append(label);root.append(mark);cursor=start+term.length}root.append(document.createTextNode(text.slice(cursor)));set('nlp-ner-count',String(matches.length));set('nlp-ner-types',String(new Set(matches.map(item=>item[1])).size))}
  segmented('nlp-ner-mode',renderNer);id('nlp-ner-input').addEventListener('input',renderNer);

  const translations={fr:['le','modèle','apprend','rapidement'],es:['el','modelo','aprende','rápidamente'],de:['das','Modell','lernt','schnell']} as Record<string,string[]>;let decodeStep=0;
  function renderSeq(){const language=selected('nlp-seq-language'),words=translations[language],width=Number(input('nlp-seq-width').value);set('nlp-seq-width-v',String(width));set('nlp-seq-output',decodeStep?words.slice(0,decodeStep).join(' ')+' …':'—');set('nlp-seq-step',`${decodeStep} / ${words.length}`);const beams=Array.from({length:width},(_,index)=>({label:(decodeStep?words.slice(0,decodeStep).join(' '):'<start>')+(index?` · option ${index+1}`:''),score:Math.max(.12,.92-index*.14-decodeStep*.025)}));const root=id('nlp-seq-beams');root.replaceChildren(...beams.map(beam=>{const row=document.createElement('div');row.className='nlp-beam';const label=document.createElement('span');label.textContent=beam.label;const meter=document.createElement('i');meter.style.width=`${beam.score*100}%`;row.append(label,meter);return row}));set('nlp-seq-score',beams[0].score.toFixed(2))}
  segmented('nlp-seq-language',()=>{decodeStep=0;renderSeq()});input('nlp-seq-width').addEventListener('input',renderSeq);id('nlp-seq-decode').addEventListener('click',()=>{decodeStep=Math.min(translations[selected('nlp-seq-language')].length,decodeStep+1);renderSeq()});

  renderTokens();renderTfidf();renderSampling();renderNgram();renderEmbed();renderClassifier();renderNer();renderSeq();
</script>
