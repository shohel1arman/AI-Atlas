<div class="ops-labs">
  <div id="panel-mlops"><div class="ops-pipeline" id="ops-lifecycle" aria-label="Model operations lifecycle"></div><div class="pg ops-grid"><section class="pg-stage ops-stage" aria-labelledby="ops-drift-heading"><h4 id="ops-drift-heading" class="sr-only">Training and live traffic distributions</h4><div class="stage-bar"><span class="pill">training vs. live traffic</span><div class="spacer"></div><span class="pill" id="ops-drift-state" role="status"><span class="dot emerald"></span>healthy</span></div><canvas id="ops-drift-canvas" role="img" aria-label="Training distribution compared with drifting live traffic"></canvas></section><aside class="pg-panel"><div class="ctrl"><div class="field"><label for="ops-drift-day">Days since deployment <span class="val" id="ops-drift-day-v">0</span></label><input id="ops-drift-day" type="range" min="0" max="60" value="0" /></div><p class="note">As incoming data changes, prediction quality can decay without an obvious service failure.</p></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">PSI DRIFT</div><div class="v mono" id="ops-drift-psi">0.00</div></div><div class="metric"><div class="l">ACCURACY</div><div class="v mono" id="ops-drift-accuracy">94%</div></div></div><div class="ctrl ops-alert" id="ops-drift-alert" hidden><strong>Drift alert</strong><p class="note">PSI crossed 0.20. Review impact and retrain with recent representative data.</p><button class="btn btn-primary btn-sm" id="ops-drift-retrain">↻ Retrain & redeploy</button></div></aside></div></div>

  <div id="panel-experiments" style="display:none"><div class="pg ops-grid"><section class="glass ops-workbench" aria-labelledby="ops-exp-heading"><h4 id="ops-exp-heading" class="ops-kicker">Compare reproducible experiment runs</h4><table class="ops-table"><thead><tr><th>Run</th><th>Model</th><th>LR</th><th>F1</th><th>Status</th></tr></thead><tbody id="ops-exp-table"></tbody></table></section><aside class="pg-panel"><div class="ctrl"><h4>Model family</h4><div class="seg" id="ops-exp-model"><button class="active" data-v="linear">Linear</button><button data-v="forest">Forest</button><button data-v="boost">Boosting</button></div></div><div class="ctrl"><div class="field"><label for="ops-exp-lr">Learning rate <span class="val" id="ops-exp-lr-v">0.05</span></label><input id="ops-exp-lr" type="range" min="1" max="20" value="5" /></div></div><button class="btn btn-primary btn-sm" id="ops-exp-run">Log experiment</button><div class="metrics"><div class="metric"><div class="l">BEST F1</div><div class="v mono" id="ops-exp-best">—</div></div><div class="metric"><div class="l">RUNS</div><div class="v mono" id="ops-exp-count">—</div></div></div><p class="note" id="ops-exp-note">Metrics alone are not enough—record parameters, code, environment, data version, and artifacts.</p></aside></div></div>

  <div id="panel-registry" style="display:none"><div class="pg ops-grid"><section class="glass ops-workbench" aria-labelledby="ops-reg-heading"><h4 id="ops-reg-heading" class="ops-kicker">Promote a version through the registry</h4><div class="ops-registry" id="ops-registry-list" aria-live="polite"></div></section><aside class="pg-panel"><div class="ctrl"><h4>Candidate version</h4><div class="seg" id="ops-reg-version"><button class="active" data-v="v12">v12</button><button data-v="v13">v13</button><button data-v="v14">v14</button></div></div><div class="ctrl"><div class="field"><label for="ops-reg-threshold">Minimum F1 <span class="val" id="ops-reg-threshold-v">0.86</span></label><input id="ops-reg-threshold" type="range" min="80" max="94" value="86" /></div></div><button class="btn btn-primary btn-sm" id="ops-reg-promote">Promote candidate</button><div class="metrics"><div class="metric"><div class="l">STAGE</div><div class="v ops-small" id="ops-reg-stage">candidate</div></div><div class="metric"><div class="l">GATE</div><div class="v ops-small" id="ops-reg-gate">waiting</div></div></div><p class="note" id="ops-reg-note">A registry versions model artifacts and records approval history.</p></aside></div></div>

  <div id="panel-deploy" style="display:none"><div class="pg ops-grid"><section class="glass ops-workbench" aria-labelledby="ops-deploy-heading"><h4 id="ops-deploy-heading" class="ops-kicker">Control production traffic</h4><div class="ops-traffic"><div><span>STABLE v12</span><strong id="ops-deploy-stable">90%</strong></div><div><span>CANDIDATE v13</span><strong id="ops-deploy-candidate">10%</strong></div></div><div class="ops-traffic-bar"><i id="ops-deploy-fill"></i></div></section><aside class="pg-panel"><div class="ctrl"><h4>Rollout strategy</h4><div class="seg" id="ops-deploy-strategy"><button class="active" data-v="canary">Canary</button><button data-v="bluegreen">Blue/green</button><button data-v="shadow">Shadow</button></div></div><div class="ctrl"><div class="field"><label for="ops-deploy-traffic">Candidate traffic <span class="val" id="ops-deploy-traffic-v">10%</span></label><input id="ops-deploy-traffic" type="range" min="0" max="100" step="5" value="10" /></div></div><div class="metrics"><div class="metric"><div class="l">ERROR RATE</div><div class="v mono" id="ops-deploy-error">—</div></div><div class="metric"><div class="l">DECISION</div><div class="v ops-small" id="ops-deploy-decision">—</div></div></div><p class="note" id="ops-deploy-note"></p></aside></div></div>

  <div id="panel-observe" style="display:none"><div class="pg ops-grid"><section class="glass ops-workbench" aria-labelledby="ops-observe-heading"><h4 id="ops-observe-heading" class="ops-kicker">Watch service and model health together</h4><div class="ops-signals" id="ops-observe-signals" aria-live="polite"></div></section><aside class="pg-panel"><div class="ctrl"><h4>Incident</h4><div class="seg" id="ops-observe-incident"><button class="active" data-v="none">None</button><button data-v="latency">Latency</button><button data-v="quality">Quality</button></div></div><div class="ctrl"><div class="field"><label for="ops-observe-load">Traffic load <span class="val" id="ops-observe-load-v">40%</span></label><input id="ops-observe-load" type="range" min="10" max="100" value="40" /></div></div><div class="metrics"><div class="metric"><div class="l">P95 LATENCY</div><div class="v mono" id="ops-observe-latency">—</div></div><div class="metric"><div class="l">ALERT</div><div class="v ops-small" id="ops-observe-alert">—</div></div></div><p class="note" id="ops-observe-note"></p></aside></div></div>

  <div id="panel-cicd" style="display:none"><div class="pg ops-grid"><section class="glass ops-workbench" aria-labelledby="ops-ci-heading"><h4 id="ops-ci-heading" class="ops-kicker">Gate a model delivery pipeline</h4><div class="ops-jobs" id="ops-ci-jobs" aria-live="polite"></div></section><aside class="pg-panel"><div class="ctrl"><h4>Injected failure</h4><div class="seg" id="ops-ci-failure"><button class="active" data-v="none">None</button><button data-v="tests">Tests</button><button data-v="security">Security</button></div></div><label class="ops-check"><input id="ops-ci-approval" type="checkbox" /> Production approval granted</label><button class="btn btn-primary btn-sm" id="ops-ci-run">Run pipeline</button><div class="metrics"><div class="metric"><div class="l">JOBS PASSED</div><div class="v mono" id="ops-ci-passed">—</div></div><div class="metric"><div class="l">RELEASE</div><div class="v ops-small" id="ops-ci-release">waiting</div></div></div><p class="note" id="ops-ci-note">Production deploys require both automated evidence and explicit approval.</p></aside></div></div>

  <div id="panel-retrain" style="display:none"><div class="pg ops-grid"><section class="glass ops-workbench" aria-labelledby="ops-retrain-heading"><h4 id="ops-retrain-heading" class="ops-kicker">Choose when automation should retrain</h4><div class="ops-trigger-card"><span id="ops-retrain-rule">PSI &gt; 0.20</span><strong id="ops-retrain-result">No trigger</strong><p class="note" id="ops-retrain-detail"></p></div></section><aside class="pg-panel"><div class="ctrl"><h4>Trigger policy</h4><div class="seg" id="ops-retrain-policy"><button class="active" data-v="drift">Drift</button><button data-v="schedule">Schedule</button><button data-v="performance">Performance</button></div></div><div class="ctrl"><div class="field"><label for="ops-retrain-signal">Current signal <span class="val" id="ops-retrain-signal-v">0.12</span></label><input id="ops-retrain-signal" type="range" min="0" max="40" value="12" /></div></div><button class="btn btn-primary btn-sm" id="ops-retrain-evaluate">Evaluate trigger</button><div class="metrics"><div class="metric"><div class="l">ACTION</div><div class="v ops-small" id="ops-retrain-action">waiting</div></div><div class="metric"><div class="l">GUARDRAIL</div><div class="v ops-small" id="ops-retrain-guardrail">required</div></div></div></aside></div></div>

  <div id="panel-govern" style="display:none"><div class="pg ops-grid"><section class="glass ops-workbench" aria-labelledby="ops-gov-heading"><h4 id="ops-gov-heading" class="ops-kicker">Trace a prediction back to evidence</h4><div class="ops-lineage" id="ops-lineage" aria-live="polite"></div></section><aside class="pg-panel"><fieldset class="ctrl ops-fieldset"><legend>Governance evidence</legend><label><input id="ops-gov-card" type="checkbox" checked /> Model card</label><label><input id="ops-gov-data" type="checkbox" checked /> Dataset lineage</label><label><input id="ops-gov-owner" type="checkbox" /> Named owner</label><label><input id="ops-gov-review" type="checkbox" /> Risk review</label></fieldset><div class="ctrl"><h4>Risk tier</h4><div class="seg" id="ops-gov-risk"><button class="active" data-v="low">Low</button><button data-v="medium">Medium</button><button data-v="high">High</button></div></div><div class="metrics"><div class="metric"><div class="l">EVIDENCE</div><div class="v mono" id="ops-gov-score">—</div></div><div class="metric"><div class="l">SHIP STATUS</div><div class="v ops-small" id="ops-gov-status">—</div></div></div><p class="note" id="ops-gov-note"></p></aside></div></div>
</div>

<style is:global>
  .ops-grid{grid-template-columns:minmax(0,1fr) 340px}.ops-stage{aspect-ratio:16/9;min-height:360px}.ops-pipeline{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:22px;border:1px solid var(--stroke);border-radius:var(--r-lg);background:var(--glass);margin-bottom:22px}.ops-life-step{display:flex;align-items:center;gap:8px}.ops-life-step>span{padding:9px 13px;border:1px solid var(--stroke);border-radius:10px;background:var(--glass-2);font-size:13px;font-weight:600}.ops-life-step i{font-style:normal;color:var(--ink-mute)}.ops-workbench{padding:26px;border-radius:var(--r-lg);min-height:360px;min-width:0}.ops-kicker{font:12px var(--mono);text-transform:uppercase;color:var(--ink-mute);margin:0 0 20px}.ops-small{font-size:14px!important}.ops-alert{border-color:#f5b942;background:#fffbeb}.ops-alert strong{color:#8a5800}.ops-alert .btn{margin-top:12px;width:100%;justify-content:center}.ops-table{width:100%;border-collapse:collapse}.ops-table th,.ops-table td{text-align:left;padding:12px;border-bottom:1px solid var(--stroke);font:12px var(--mono)}.ops-table th{color:var(--ink-mute)}.ops-table tr.best td{color:#067647}.ops-registry,.ops-signals,.ops-jobs,.ops-lineage{display:grid;gap:10px}.ops-version,.ops-signal,.ops-job,.ops-lineage-item{display:grid;grid-template-columns:1fr auto;gap:12px;padding:14px 16px;border:1px solid var(--stroke);border-radius:12px;background:var(--glass-2)}.ops-version span,.ops-signal span,.ops-job span,.ops-lineage-item span{font:11px var(--mono);color:var(--ink-mute)}.ops-version.production,.ops-signal.good,.ops-job.pass,.ops-lineage-item.present{border-color:#86d8bd}.ops-version.production span,.ops-signal.good span,.ops-job.pass span,.ops-lineage-item.present span{color:#067647}.ops-signal.bad,.ops-job.fail,.ops-lineage-item.missing{border-color:#fda29b}.ops-signal.bad span,.ops-job.fail span,.ops-lineage-item.missing span{color:#b42318}.ops-traffic{display:grid;grid-template-columns:1fr 1fr;gap:14px}.ops-traffic>div{padding:22px;border:1px solid var(--stroke);border-radius:13px;background:var(--glass-2)}.ops-traffic span{display:block;font:10px var(--mono);color:var(--ink-mute)}.ops-traffic strong{display:block;margin-top:8px;font-size:28px}.ops-traffic-bar{height:18px;border:1px solid var(--stroke);border-radius:999px;background:#dbeafe;overflow:hidden;margin-top:22px}.ops-traffic-bar i{display:block;height:100%;background:#059669;transform:scaleX(var(--traffic));transform-origin:left;transition:transform .18s}.ops-check{display:flex;align-items:center;gap:9px;color:var(--ink-soft);font-size:13px}.ops-trigger-card{padding:28px;border:1px solid var(--stroke);border-radius:14px;background:var(--glass-2)}.ops-trigger-card span{font:12px var(--mono);color:var(--ink-mute)}.ops-trigger-card strong{display:block;margin:18px 0 8px;font-size:30px}.ops-fieldset{border:0;margin:0;padding:0}.ops-fieldset legend{font-weight:600;margin-bottom:12px}.ops-fieldset label{display:flex;align-items:center;gap:9px;margin:11px 0;color:var(--ink-soft);font-size:13px}@media(max-width:900px){.ops-grid{grid-template-columns:1fr}}@media(max-width:560px){.ops-workbench{padding:18px}.ops-table{display:block;overflow-x:auto}}@media(prefers-reduced-motion:reduce){.ops-labs *{transition-duration:.01ms!important}}
</style>

<script>
  const get=(id:string)=>document.getElementById(id)!;const range=(id:string)=>get(id) as HTMLInputElement;const set=(id:string,value:string)=>{get(id).textContent=value};const chosen=(id:string)=>(get(id).querySelector('button.active') as HTMLButtonElement).dataset.v!;function segment(id:string,render:()=>void){const group=get(id);group.querySelectorAll('button').forEach(button=>button.setAttribute('aria-pressed',String(button.classList.contains('active'))));group.addEventListener('click',event=>{const button=(event.target as Element).closest('button');if(!button)return;group.querySelectorAll('button').forEach(item=>{const on=item===button;item.classList.toggle('active',on);item.setAttribute('aria-pressed',String(on))});render()})}const watch=(ids:string[],render:()=>void)=>ids.forEach(id=>range(id).addEventListener('input',render));
  const lifecycle=['Train','Register','Deploy','Monitor','Retrain'];get('ops-lifecycle').replaceChildren(...lifecycle.map((name,index)=>{const wrap=document.createElement('div'),step=document.createElement('span');wrap.className='ops-life-step';step.textContent=name;wrap.append(step);if(index<lifecycle.length-1){const arrow=document.createElement('i');arrow.textContent='→';wrap.append(arrow)}return wrap}));
  const driftCanvas=get('ops-drift-canvas') as HTMLCanvasElement,driftContext=driftCanvas.getContext('2d')!;function drawDrift(){const rect=driftCanvas.getBoundingClientRect();if(!rect.width||!rect.height)return;const dpr=Math.min(devicePixelRatio||1,2);driftCanvas.width=rect.width*dpr;driftCanvas.height=rect.height*dpr;driftContext.setTransform(dpr,0,0,dpr,0,0);driftContext.clearRect(0,0,rect.width,rect.height);const day=+range('ops-drift-day').value,W=rect.width,H=rect.height,ox=W*.08,oy=H-35,width=W*.84,gauss=(x:number,mu:number,s:number)=>Math.exp(-((x-mu)**2)/(2*s*s)),curve=(mu:number,s:number,color:string)=>{driftContext.beginPath();for(let i=0;i<=120;i++){const t=i/120,x=ox+t*width,y=oy-gauss(t*6-3,mu,s)*(H*.6);i?driftContext.lineTo(x,y):driftContext.moveTo(x,y)}driftContext.strokeStyle=color;driftContext.lineWidth=2.5;driftContext.stroke()};driftContext.strokeStyle='rgba(100,116,139,.35)';driftContext.beginPath();driftContext.moveTo(ox,oy);driftContext.lineTo(ox+width,oy);driftContext.stroke();curve(-.4,.85,'#4f46e5');curve(-.4+day/27,.85+day/75,'#f59e0b');const psi=day/60*.42,accuracy=Math.max(58,94-day*.6),drifting=psi>=.2;set('ops-drift-day-v',String(day));set('ops-drift-psi',psi.toFixed(2));set('ops-drift-accuracy',`${Math.round(accuracy)}%`);const dot=document.createElement('span');dot.className=`dot ${drifting?'rose':'emerald'}`;get('ops-drift-state').replaceChildren(dot,document.createTextNode(drifting?'drifting':psi>.1?'watch':'healthy'));get('ops-drift-alert').hidden=!drifting}range('ops-drift-day').addEventListener('input',drawDrift);get('ops-drift-retrain').addEventListener('click',()=>{range('ops-drift-day').value='0';drawDrift()});window.addEventListener('resize',drawDrift);drawDrift();
  type Run={id:number;model:string;lr:number;f1:number};let runs:Run[]=[{id:101,model:'Linear',lr:.05,f1:.82},{id:102,model:'Forest',lr:.05,f1:.87},{id:103,model:'Boosting',lr:.08,f1:.9}];function renderExperiments(){const best=Math.max(...runs.map(run=>run.f1));get('ops-exp-table').replaceChildren(...runs.slice(-5).map(run=>{const row=document.createElement('tr');if(run.f1===best)row.className='best';[String(run.id),run.model,run.lr.toFixed(2),run.f1.toFixed(2),run.f1===best?'best':'logged'].forEach(value=>{const td=document.createElement('td');td.textContent=value;row.append(td)});return row}));set('ops-exp-best',best.toFixed(2));set('ops-exp-count',String(runs.length));set('ops-exp-lr-v',(+range('ops-exp-lr').value/100).toFixed(2))}segment('ops-exp-model',renderExperiments);watch(['ops-exp-lr'],renderExperiments);get('ops-exp-run').addEventListener('click',()=>{const names:Record<string,string>={linear:'Linear',forest:'Forest',boost:'Boosting'},model=chosen('ops-exp-model'),lr=+range('ops-exp-lr').value/100,base:Record<string,number>={linear:.8,forest:.86,boost:.89};runs.push({id:100+runs.length+1,model:names[model],lr,f1:Math.min(.94,base[model]+lr*.2)});renderExperiments();set('ops-exp-note',`Run ${runs.at(-1)!.id} logged with parameters, metrics, and artifact references.`)});renderExperiments();
  const versions=[{id:'v12',f1:.87,stage:'production'},{id:'v13',f1:.91,stage:'candidate'},{id:'v14',f1:.84,stage:'candidate'}];function renderRegistry(){const current=chosen('ops-reg-version'),threshold=+range('ops-reg-threshold').value/100;set('ops-reg-threshold-v',threshold.toFixed(2));get('ops-registry-list').replaceChildren(...versions.map(version=>{const row=document.createElement('div'),state=document.createElement('span');row.className=`ops-version ${version.stage}`;state.textContent=`${version.stage} · F1 ${version.f1.toFixed(2)}`;row.append(document.createTextNode(version.id),state);return row}));const item=versions.find(version=>version.id===current)!;set('ops-reg-stage',item.stage);set('ops-reg-gate',item.f1>=threshold?'eligible':'below gate')}segment('ops-reg-version',renderRegistry);watch(['ops-reg-threshold'],renderRegistry);get('ops-reg-promote').addEventListener('click',()=>{const item=versions.find(version=>version.id===chosen('ops-reg-version'))!,threshold=+range('ops-reg-threshold').value/100;if(item.f1>=threshold){versions.forEach(version=>version.stage=version===item?'production':version.stage==='production'?'archived':version.stage);set('ops-reg-note',`${item.id} promoted; the previous production version remains available for rollback.`)}else set('ops-reg-note',`${item.id} did not meet the F1 gate and remains a candidate.`);renderRegistry()});renderRegistry();
  function renderDeploy(){const strategy=chosen('ops-deploy-strategy'),requested=+range('ops-deploy-traffic').value,traffic=strategy==='shadow'?0:strategy==='bluegreen'?(requested>=50?100:0):requested,error=.6+requested*.018+(strategy==='shadow'?.1:0),decision=error>1.7?'rollback':traffic===100?'complete':'continue';set('ops-deploy-traffic-v',`${requested}%`);set('ops-deploy-stable',`${100-traffic}%`);set('ops-deploy-candidate',`${traffic}%`);get('ops-deploy-fill').style.setProperty('--traffic',String(traffic/100));set('ops-deploy-error',`${error.toFixed(1)}%`);set('ops-deploy-decision',decision);set('ops-deploy-note',strategy==='shadow'?'Shadow traffic is copied to the candidate, but only stable responses reach users.':strategy==='bluegreen'?'Blue/green switches all traffic between two complete environments.':'A canary increases real user traffic gradually while guardrails are healthy.')}segment('ops-deploy-strategy',renderDeploy);watch(['ops-deploy-traffic'],renderDeploy);renderDeploy();
  function renderObserve(){const incident=chosen('ops-observe-incident'),load=+range('ops-observe-load').value,latency=Math.round(70+load*1.2+(incident==='latency'?260:0)),signals=[['Availability',incident==='none'?'99.98%':'99.91%',incident==='none'],['P95 latency',`${latency} ms`,incident!=='latency'],['Prediction F1',incident==='quality'?'0.72':'0.89',incident!=='quality'],['Input drift',incident==='quality'?'0.24':'0.06',incident!=='quality']];set('ops-observe-load-v',`${load}%`);get('ops-observe-signals').replaceChildren(...signals.map(([name,value,good])=>{const row=document.createElement('div'),state=document.createElement('span');row.className=`ops-signal ${good?'good':'bad'}`;state.textContent=String(value);row.append(document.createTextNode(String(name)),state);return row}));set('ops-observe-latency',`${latency} ms`);set('ops-observe-alert',incident==='none'?'none':incident);set('ops-observe-note',incident==='quality'?'Service metrics look normal, but model-quality signals show a semantic failure.':incident==='latency'?'Infrastructure latency is breaching the service objective; inspect saturation and dependencies.':'Service, data, and model signals are all within their operating targets.')}segment('ops-observe-incident',renderObserve);watch(['ops-observe-load'],renderObserve);renderObserve();
  const jobs=['Lint & unit tests','Data contract tests','Build model image','Security scan','Deploy staging','Deploy production'];function renderCi(ran=false){const failure=chosen('ops-ci-failure'),approved=range('ops-ci-approval').checked,failIndex=failure==='tests'?1:failure==='security'?3:-1;let passed=0;get('ops-ci-jobs').replaceChildren(...jobs.map((name,index)=>{const row=document.createElement('div'),state=document.createElement('span'),blocked=ran&&index===5&&!approved,bad=ran&&index===failIndex;row.className=`ops-job${ran?bad||blocked?' fail':' pass':''}`;state.textContent=!ran?'WAITING':bad?'FAILED':blocked?'NEEDS APPROVAL':'PASSED';if(ran&&!bad&&!blocked)passed++;row.append(document.createTextNode(name),state);return row}));set('ops-ci-passed',ran?`${passed}/6`:'—');set('ops-ci-release',!ran?'waiting':failIndex>=0?'blocked':approved?'released':'approval');set('ops-ci-note',!ran?'Production deploys require both automated evidence and explicit approval.':failIndex>=0?'An automated gate failed, so later delivery must stop.':approved?'Every gate passed and the production release is approved.':'Automated gates passed; production is waiting for an authorized reviewer.')}segment('ops-ci-failure',()=>renderCi(false));range('ops-ci-approval').addEventListener('change',()=>renderCi(false));get('ops-ci-run').addEventListener('click',()=>renderCi(true));renderCi();
  function renderRetrain(evaluated=false){const policy=chosen('ops-retrain-policy'),signal=+range('ops-retrain-signal').value/100,configs:Record<string,[string,number,string]>={drift:['PSI > 0.20',.2,'Validate recent labels and sampling before training.'],schedule:['Age > 0.30 cycle',.3,'A schedule is predictable but may retrain when nothing changed.'],performance:['Error > 0.15',.15,'Performance triggers require delayed ground-truth labels.']},triggered=signal>configs[policy][1];set('ops-retrain-signal-v',signal.toFixed(2));set('ops-retrain-rule',configs[policy][0]);set('ops-retrain-result',evaluated?(triggered?'Trigger met':'No trigger'):'Not evaluated');set('ops-retrain-detail',configs[policy][2]);set('ops-retrain-action',!evaluated?'waiting':triggered?'start job':'monitor');set('ops-retrain-guardrail',triggered?'validate':'required')}segment('ops-retrain-policy',()=>renderRetrain(false));watch(['ops-retrain-signal'],()=>renderRetrain(false));get('ops-retrain-evaluate').addEventListener('click',()=>renderRetrain(true));renderRetrain();
  const evidence=[['Model card','ops-gov-card'],['Dataset lineage','ops-gov-data'],['Named owner','ops-gov-owner'],['Risk review','ops-gov-review']];function renderGovern(){const risk=chosen('ops-gov-risk'),required=risk==='high'?4:risk==='medium'?3:2,present=evidence.filter(([,id])=>range(id).checked).length;get('ops-lineage').replaceChildren(...evidence.map(([name,id])=>{const on=range(id).checked,row=document.createElement('div'),state=document.createElement('span');row.className=`ops-lineage-item ${on?'present':'missing'}`;state.textContent=on?'PRESENT':'MISSING';row.append(document.createTextNode(name),state);return row}));set('ops-gov-score',`${present}/4`);set('ops-gov-status',present>=required?'ready':'blocked');set('ops-gov-note',`${risk[0].toUpperCase()+risk.slice(1)} risk requires at least ${required} evidence items before release.`)}segment('ops-gov-risk',renderGovern);evidence.forEach(([,id])=>range(id).addEventListener('change',renderGovern));renderGovern();
  const redraw:Record<string,()=>void>={mlops:drawDrift,experiments:renderExperiments,registry:renderRegistry,deploy:renderDeploy,observe:renderObserve,cicd:()=>renderCi(false),retrain:()=>renderRetrain(false),govern:renderGovern};document.addEventListener('mlops:tab',event=>requestAnimationFrame(()=>redraw[(event as CustomEvent<string>).detail]?.()));
</script>
