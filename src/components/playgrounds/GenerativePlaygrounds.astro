<div id="panel-generative"><div class="glass ga-prompt"><label for="ga-diff-prompt">Prompt</label><input class="text-input" id="ga-diff-prompt" value="a glowing nebula over a calm ocean, cinematic" /></div><div class="pg ga-grid"><section class="pg-stage ga-square"><div class="stage-bar"><span class="pill" id="ga-diff-status">step 0 / 24 · pure noise</span></div><canvas id="ga-diff-canvas" role="img" aria-label="Diffusion image resolving from noise into structure"></canvas></section><aside class="pg-panel"><div class="ctrl"><h4>Denoising timeline</h4><div class="field"><label for="ga-diff-step">Step <span class="val" id="ga-diff-step-v">0 / 24</span></label><input id="ga-diff-step" type="range" min="0" max="24" value="0" /></div><div class="row ga-actions"><button class="btn btn-primary btn-sm" id="ga-diff-run" type="button">Generate</button><button class="btn btn-ghost btn-sm" id="ga-diff-reseed" type="button">Reseed</button></div></div><div class="ctrl"><div class="field"><label for="ga-diff-cfg">Guidance scale <span class="val" id="ga-diff-cfg-v">7.5</span></label><input id="ga-diff-cfg" type="range" min="1" max="15" step="0.5" value="7.5" /></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">NOISE σ</div><div class="v mono" id="ga-diff-sigma">1.00</div></div><div class="metric"><div class="l">STRUCTURE</div><div class="v mono" id="ga-diff-structure">0%</div></div></div></aside></div></div>

<div id="panel-schedule" style="display:none"><div class="pg ga-grid"><section class="glass ga-workbench" aria-labelledby="ga-schedule-heading"><h4 id="ga-schedule-heading" class="ga-kicker">Signal and noise over time</h4><canvas class="ga-chart" id="ga-schedule-canvas" role="img" aria-label="Noise schedule curve across diffusion timesteps"></canvas></section><aside class="pg-panel"><div class="ctrl"><h4>Schedule</h4><div class="seg" id="ga-schedule-kind"><button class="active" data-v="linear">Linear</button><button data-v="cosine">Cosine</button><button data-v="karras">Karras</button></div></div><div class="ctrl"><div class="field"><label for="ga-schedule-step">Inspect timestep <span class="val" id="ga-schedule-step-v">50</span></label><input id="ga-schedule-step" type="range" min="0" max="100" value="50" /></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">SIGNAL</div><div class="v mono" id="ga-schedule-signal">—</div></div><div class="metric"><div class="l">NOISE</div><div class="v mono" id="ga-schedule-noise">—</div></div></div><p class="note" id="ga-schedule-note">Linear schedules remove noise at a constant rate but may spend steps inefficiently.</p></aside></div></div>

<div id="panel-latent" style="display:none"><div class="pg ga-grid"><section class="glass ga-workbench" aria-labelledby="ga-latent-heading"><h4 id="ga-latent-heading" class="ga-kicker">Interpolate through latent space</h4><div class="ga-latent-stage" id="ga-latent-stage" role="img" aria-label="Generated concept changing across latent coordinates"><div class="ga-shape" id="ga-latent-shape"></div><strong id="ga-latent-caption">calm ocean · photographic</strong></div></section><aside class="pg-panel"><div class="ctrl"><div class="field"><label for="ga-latent-concept">Concept <span class="val" id="ga-latent-concept-v">ocean</span></label><input id="ga-latent-concept" type="range" min="0" max="100" value="0" /></div><div class="field"><label for="ga-latent-style">Style <span class="val" id="ga-latent-style-v">photo</span></label><input id="ga-latent-style" type="range" min="0" max="100" value="0" /></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">LATENT X</div><div class="v mono" id="ga-latent-x">0.00</div></div><div class="metric"><div class="l">LATENT Y</div><div class="v mono" id="ga-latent-y">0.00</div></div></div><p class="note">Nearby coordinates produce related outputs, so interpolation changes concepts and styles smoothly instead of switching labels abruptly.</p></aside></div></div>

<div id="panel-guidance" style="display:none"><div class="pg ga-grid"><section class="glass ga-workbench" aria-labelledby="ga-guidance-heading"><h4 id="ga-guidance-heading" class="ga-kicker">Classifier-free guidance</h4><div class="ga-guidance-row"><div><span>UNCONDITIONAL</span><strong>diverse composition</strong></div><div class="ga-mix"><i id="ga-guidance-marker"></i></div><div><span>PROMPT-CONDITIONED</span><strong>literal composition</strong></div></div><div class="ga-guidance-output" id="ga-guidance-output" aria-live="polite">Balanced prompt alignment with useful variation.</div></section><aside class="pg-panel"><div class="ctrl"><div class="field"><label for="ga-guidance-scale">CFG scale <span class="val" id="ga-guidance-scale-v">7.5</span></label><input id="ga-guidance-scale" type="range" min="1" max="18" step="0.5" value="7.5" /></div><div class="field"><label for="ga-guidance-negative">Negative prompt strength <span class="val" id="ga-guidance-negative-v">30%</span></label><input id="ga-guidance-negative" type="range" min="0" max="100" value="30" /></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">ALIGNMENT</div><div class="v mono" id="ga-guidance-align">—</div></div><div class="metric"><div class="l">DIVERSITY</div><div class="v mono" id="ga-guidance-diversity">—</div></div></div></aside></div></div>

<div id="panel-prompt" style="display:none"><div class="pg ga-grid"><section class="glass ga-workbench" aria-labelledby="ga-prompt-heading"><h4 id="ga-prompt-heading" class="ga-kicker">Build a generation prompt</h4><label class="ga-label" for="ga-prompt-subject">Subject</label><input class="text-input" id="ga-prompt-subject" value="a red fox in a snowy forest" /><div class="ga-prompt-chips" id="ga-prompt-chips" aria-label="Select prompt modifiers"></div><div class="ga-prompt-result"><span>COMPOSED PROMPT</span><p id="ga-prompt-result" aria-live="polite"></p></div></section><aside class="pg-panel"><div class="ctrl"><h4>Model family</h4><div class="seg" id="ga-prompt-model"><button class="active" data-v="image">Image</button><button data-v="video">Video</button><button data-v="audio">Audio</button></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">PROMPT TOKENS</div><div class="v mono" id="ga-prompt-tokens">—</div></div><div class="metric"><div class="l">SPECIFICITY</div><div class="v mono" id="ga-prompt-specificity">—</div></div></div><p class="note">Describe the subject first, then composition, medium, lighting and constraints. Exact syntax varies by model.</p></aside></div></div>

<div id="panel-control" style="display:none"><div class="pg ga-grid"><section class="glass ga-workbench" aria-labelledby="ga-control-heading"><h4 id="ga-control-heading" class="ga-kicker">Condition the generation</h4><canvas class="ga-chart" id="ga-control-canvas" role="img" aria-label="Generated composition responding to a structural control signal"></canvas></section><aside class="pg-panel"><div class="ctrl"><h4>Control input</h4><div class="seg" id="ga-control-kind"><button class="active" data-v="edge">Edges</button><button data-v="depth">Depth</button><button data-v="mask">Inpaint mask</button></div></div><div class="ctrl"><div class="field"><label for="ga-control-strength">Control strength <span class="val" id="ga-control-strength-v">65%</span></label><input id="ga-control-strength" type="range" min="0" max="100" value="65" /></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">STRUCTURE</div><div class="v mono" id="ga-control-structure">—</div></div><div class="metric"><div class="l">FREEDOM</div><div class="v mono" id="ga-control-freedom">—</div></div></div><p class="note" id="ga-control-note">Edge guidance preserves outlines while the model invents texture and appearance.</p></aside></div></div>

<div id="panel-audio" style="display:none"><div class="pg ga-grid"><section class="glass ga-workbench" aria-labelledby="ga-audio-heading"><h4 id="ga-audio-heading" class="ga-kicker">Prompt-to-audio waveform</h4><label class="ga-label" for="ga-audio-prompt">Audio prompt</label><input class="text-input" id="ga-audio-prompt" value="gentle piano with distant rain" /><canvas class="ga-chart" id="ga-audio-canvas" role="img" aria-label="Generated audio waveform"></canvas></section><aside class="pg-panel"><div class="ctrl"><h4>Mood</h4><div class="seg" id="ga-audio-mood"><button class="active" data-v="calm">Calm</button><button data-v="bright">Bright</button><button data-v="dark">Dark</button></div></div><div class="ctrl"><div class="field"><label for="ga-audio-length">Duration <span class="val" id="ga-audio-length-v">10 sec</span></label><input id="ga-audio-length" type="range" min="5" max="30" step="5" value="10" /></div></div><button class="btn btn-primary" id="ga-audio-generate" type="button">Generate waveform</button><div class="metrics" aria-live="polite"><div class="metric"><div class="l">SAMPLE RATE</div><div class="v mono ga-small">44.1k</div></div><div class="metric"><div class="l">DURATION</div><div class="v mono" id="ga-audio-duration">10s</div></div></div></aside></div></div>

<div id="panel-video" style="display:none"><div class="pg ga-grid"><section class="glass ga-workbench" aria-labelledby="ga-video-heading"><h4 id="ga-video-heading" class="ga-kicker">Temporal consistency across frames</h4><div class="ga-storyboard" id="ga-storyboard" role="img" aria-label="Generated video storyboard frames"></div></section><aside class="pg-panel"><div class="ctrl"><div class="field"><label for="ga-video-motion">Motion amount <span class="val" id="ga-video-motion-v">40%</span></label><input id="ga-video-motion" type="range" min="0" max="100" value="40" /></div><div class="field"><label for="ga-video-consistency">Frame consistency <span class="val" id="ga-video-consistency-v">80%</span></label><input id="ga-video-consistency" type="range" min="20" max="100" value="80" /></div></div><div class="metrics" aria-live="polite"><div class="metric"><div class="l">MOTION</div><div class="v mono" id="ga-video-motion-m">—</div></div><div class="metric"><div class="l">FLICKER RISK</div><div class="v mono ga-small" id="ga-video-flicker">—</div></div></div><p class="note">Video models must generate plausible motion while keeping identity, lighting and geometry coherent from frame to frame.</p></aside></div></div>

<style>
  .ga-grid{grid-template-columns:minmax(0,1fr) 320px}.ga-prompt{padding:18px;border-radius:var(--r);margin-bottom:20px}.ga-prompt label,.ga-label{display:block;color:var(--ink-mute);font-size:12px;margin-bottom:8px}.ga-square{aspect-ratio:1;min-height:0}.ga-workbench{padding:26px;border-radius:var(--r-lg);min-width:0}.ga-kicker{font:12px var(--mono);text-transform:uppercase;color:var(--ink-mute);margin:0 0 14px}.ga-actions{gap:8px;margin-top:12px}.ga-actions .btn{flex:1;justify-content:center}.ga-chart{width:100%;height:320px;display:block;border:1px solid var(--stroke);border-radius:13px;background:var(--surface)}.ga-small{font-size:14px!important}.ga-latent-stage{min-height:330px;border:1px solid var(--stroke);border-radius:14px;display:grid;place-items:center;align-content:center;gap:20px;background:var(--surface)}.ga-shape{width:130px;height:130px;border-radius:var(--shape-radius);background:var(--shape-color);transform:rotate(var(--shape-rotate)) scale(var(--shape-scale))}.ga-latent-stage strong{font-size:16px}.ga-guidance-row{display:grid;grid-template-columns:1fr 120px 1fr;gap:16px;align-items:center;min-height:220px}.ga-guidance-row>div:not(.ga-mix){border:1px solid var(--stroke);border-radius:12px;padding:18px;text-align:center}.ga-guidance-row span,.ga-prompt-result span{display:block;font:10px var(--mono);color:var(--ink-mute);margin-bottom:8px}.ga-guidance-row strong{font-size:14px}.ga-mix{height:8px;background:var(--surface);border-radius:999px;position:relative}.ga-mix i{position:absolute;top:50%;left:var(--marker);width:18px;height:18px;border-radius:50%;background:var(--rose);transform:translate(-50%,-50%)}.ga-guidance-output,.ga-prompt-result{border:1px solid var(--stroke);border-radius:12px;padding:16px;color:var(--ink-soft)}.ga-prompt-chips{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0}.ga-prompt-chips button{border:1px solid var(--stroke);background:var(--surface);color:var(--ink-soft);border-radius:999px;padding:7px 10px;font-size:12px}.ga-prompt-chips button.active{background:var(--rose);border-color:var(--rose);color:white}.ga-prompt-result p{margin:0}.ga-storyboard{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.ga-frame{aspect-ratio:16/11;border:1px solid var(--stroke);border-radius:10px;background:var(--surface);position:relative;overflow:hidden}.ga-frame i{position:absolute;width:42%;height:42%;border-radius:50%;background:var(--rose);left:var(--x);top:var(--y);transform:translate(-50%,-50%) scale(var(--scale));opacity:var(--opacity)}.ga-frame span{position:absolute;left:7px;bottom:6px;font:9px var(--mono);color:var(--ink-mute)}
  @media(max-width:850px){.ga-grid{grid-template-columns:1fr}}@media(max-width:650px){.ga-workbench{padding:18px}.ga-guidance-row{grid-template-columns:1fr}.ga-mix{height:70px;width:8px;margin:auto}.ga-storyboard{grid-template-columns:repeat(2,1fr)}}
</style>

<script>
  const node=(name:string)=>document.getElementById(name)!;const input=(name:string)=>node(name) as HTMLInputElement;const output=(name:string,value:string)=>{node(name).textContent=value};function segment(name:string,render:()=>void){const root=node(name);root.querySelectorAll('button').forEach(button=>button.setAttribute('aria-pressed',String(button.classList.contains('active'))));root.addEventListener('click',event=>{const button=(event.target as Element).closest('button');if(!button)return;root.querySelectorAll('button').forEach(item=>{const active=item===button;item.classList.toggle('active',active);item.setAttribute('aria-pressed',String(active))});render()})}const picked=(name:string)=>(node(name).querySelector('button.active') as HTMLButtonElement).dataset.v!;function fit(canvas:HTMLCanvasElement){const rect=canvas.getBoundingClientRect();if(!rect.width||!rect.height)return null;const dpr=Math.min(devicePixelRatio||1,2);canvas.width=Math.round(rect.width*dpr);canvas.height=Math.round(rect.height*dpr);const context=canvas.getContext('2d')!;context.setTransform(dpr,0,0,dpr,0,0);context.clearRect(0,0,rect.width,rect.height);return{context,width:rect.width,height:rect.height}}function hash(x:number,y:number,seed:number){const value=Math.sin(x*12.9898+y*78.233+seed*.137)*43758.5453;return value-Math.floor(value)}
  let diffSeed=421,diffRunning=false,diffRaf=0,diffLast=0,diffVisible=true;function drawDiff(){const canvas=node('ga-diff-canvas') as HTMLCanvasElement,view=fit(canvas);if(!view)return;const{context,width,height}=view,step=Number(input('ga-diff-step').value),progress=step/24,cells=Math.round(10+progress*38),cellW=width/cells,cellH=height/cells,cfg=Number(input('ga-diff-cfg').value);for(let x=0;x<cells;x++)for(let y=0;y<cells;y++){const nx=x/cells,ny=y/cells,noise=hash(x,y,diffSeed)*210,mix=Math.pow(progress,1.35),ocean=ny>.6,glow=Math.max(0,1-Math.hypot(nx-.52,ny-.32)*2.2),red=ocean?18:45+glow*160,green=ocean?55:35+glow*70,blue=ocean?115:95+glow*120,guidance=Math.min(1,cfg/12);context.fillStyle=`rgb(${Math.round(red*mix*guidance+noise*(1-mix))},${Math.round(green*mix+noise*(1-mix))},${Math.round(blue*mix+noise*(1-mix))})`;context.fillRect(x*cellW,y*cellH,cellW+1,cellH+1)}output('ga-diff-step-v',`${step} / 24`);output('ga-diff-status',`step ${step} / 24 · ${step===0?'pure noise':step===24?'final image':'denoising'}`);output('ga-diff-cfg-v',cfg.toFixed(1));output('ga-diff-sigma',(1-progress).toFixed(2));output('ga-diff-structure',`${Math.round(progress*100)}%`)}function stopDiff(){diffRunning=false;if(diffRaf)cancelAnimationFrame(diffRaf);diffRaf=0;output('ga-diff-run','Generate')}function diffLoop(time:number){if(!diffRunning||!diffVisible||document.hidden)return stopDiff();if(time-diffLast>85){diffLast=time;const step=Number(input('ga-diff-step').value);if(step>=24)return stopDiff();input('ga-diff-step').value=String(step+1);drawDiff()}diffRaf=requestAnimationFrame(diffLoop)}input('ga-diff-step').addEventListener('input',drawDiff);input('ga-diff-cfg').addEventListener('input',drawDiff);input('ga-diff-prompt').addEventListener('input',()=>{diffSeed=input('ga-diff-prompt').value.length*37;drawDiff()});node('ga-diff-reseed').addEventListener('click',()=>{diffSeed=Math.random()*10000;drawDiff()});node('ga-diff-run').addEventListener('click',()=>{if(diffRunning){stopDiff();return}if(matchMedia('(prefers-reduced-motion: reduce)').matches){input('ga-diff-step').value='24';drawDiff();return}input('ga-diff-step').value='0';diffRunning=true;diffLast=0;output('ga-diff-run','Pause');diffRaf=requestAnimationFrame(diffLoop)});new IntersectionObserver(([entry])=>{diffVisible=entry.isIntersecting;if(!diffVisible)stopDiff()},{rootMargin:'80px'}).observe(node('ga-diff-canvas'));
  function drawSchedule(){const canvas=node('ga-schedule-canvas') as HTMLCanvasElement,view=fit(canvas);if(!view)return;const{context,width,height}=view,kind=picked('ga-schedule-kind'),step=Number(input('ga-schedule-step').value),progress=step/100,curve=(t:number)=>kind==='linear'?1-t:kind==='cosine'?Math.cos(t*Math.PI/2)**2:(1-t)**3,signal=curve(progress),pad=38;context.strokeStyle='rgba(148,163,184,.35)';context.beginPath();context.moveTo(pad,20);context.lineTo(pad,height-pad);context.lineTo(width-20,height-pad);context.stroke();context.strokeStyle='#FB7185';context.lineWidth=3;context.beginPath();for(let i=0;i<=100;i++){const x=pad+i/100*(width-pad-22),y=22+(1-curve(i/100))*(height-pad-24);i?context.lineTo(x,y):context.moveTo(x,y)}context.stroke();context.fillStyle='#FB7185';context.beginPath();context.arc(pad+progress*(width-pad-22),22+(1-signal)*(height-pad-24),6,0,Math.PI*2);context.fill();output('ga-schedule-step-v',String(step));output('ga-schedule-signal',signal.toFixed(2));output('ga-schedule-noise',(1-signal).toFixed(2));output('ga-schedule-note',kind==='linear'?'Linear schedules remove noise at a constant rate but may spend steps inefficiently.':kind==='cosine'?'Cosine schedules preserve useful signal longer before a smooth late decline.':'Karras-style schedules concentrate steps where denoising changes perceptual detail most.')}
  segment('ga-schedule-kind',drawSchedule);input('ga-schedule-step').addEventListener('input',drawSchedule);
  function renderLatent(){const concept=Number(input('ga-latent-concept').value),style=Number(input('ga-latent-style').value),shape=node('ga-latent-shape');shape.style.setProperty('--shape-radius',`${50-concept*.35}%`);shape.style.setProperty('--shape-color',concept<50?'#38BDF8':'#FB7185');shape.style.setProperty('--shape-rotate',`${style*.45}deg`);shape.style.setProperty('--shape-scale',String(.8+style/500));const conceptName=concept<35?'ocean':concept<70?'island':'mountain',styleName=style<35?'photographic':style<70?'illustrated':'abstract';output('ga-latent-concept-v',conceptName);output('ga-latent-style-v',styleName);output('ga-latent-caption',`${conceptName} · ${styleName}`);output('ga-latent-x',(concept/100).toFixed(2));output('ga-latent-y',(style/100).toFixed(2))}['ga-latent-concept','ga-latent-style'].forEach(name=>input(name).addEventListener('input',renderLatent));
  function renderGuidance(){const scale=Number(input('ga-guidance-scale').value),negative=Number(input('ga-guidance-negative').value),alignment=Math.min(98,40+scale*4+negative*.1),diversity=Math.max(12,98-scale*4-negative*.12);node('ga-guidance-marker').style.setProperty('--marker',`${Math.min(96,scale/18*100)}%`);output('ga-guidance-scale-v',scale.toFixed(1));output('ga-guidance-negative-v',`${negative}%`);output('ga-guidance-align',`${Math.round(alignment)}%`);output('ga-guidance-diversity',`${Math.round(diversity)}%`);output('ga-guidance-output',scale<4?'Loose interpretation with high variation.':scale>13?'Very literal output; oversaturation and artifacts are more likely.':'Balanced prompt alignment with useful variation.')}['ga-guidance-scale','ga-guidance-negative'].forEach(name=>input(name).addEventListener('input',renderGuidance));
  const modifiers=['wide composition','soft light','watercolour','high detail','no text','shallow depth'];const chipRoot=node('ga-prompt-chips');chipRoot.replaceChildren(...modifiers.map((modifier,index)=>{const button=document.createElement('button');button.type='button';button.textContent=modifier;button.classList.toggle('active',index<2);button.setAttribute('aria-pressed',String(index<2));button.addEventListener('click',()=>{button.classList.toggle('active');button.setAttribute('aria-pressed',String(button.classList.contains('active')));renderPrompt()});return button}));function renderPrompt(){const subject=input('ga-prompt-subject').value.trim(),active=[...chipRoot.querySelectorAll('button.active')].map(button=>button.textContent),model=picked('ga-prompt-model'),suffix=model==='video'?'smooth camera motion, temporal consistency':model==='audio'?'clear mix, natural dynamics':'balanced colour, coherent anatomy',prompt=[subject,...active,suffix].filter(Boolean).join(', ');output('ga-prompt-result',prompt);output('ga-prompt-tokens',String(Math.ceil(prompt.length/4)));output('ga-prompt-specificity',active.length<2?'low':active.length<4?'medium':'high')}segment('ga-prompt-model',renderPrompt);input('ga-prompt-subject').addEventListener('input',renderPrompt);
  function drawControl(){const canvas=node('ga-control-canvas') as HTMLCanvasElement,view=fit(canvas);if(!view)return;const{context,width,height}=view,kind=picked('ga-control-kind'),strength=Number(input('ga-control-strength').value),alpha=.2+strength/140;context.fillStyle='#101018';context.fillRect(0,0,width,height);context.strokeStyle=`rgba(251,113,133,${alpha})`;context.fillStyle=`rgba(251,113,133,${alpha*.65})`;context.lineWidth=2+strength/20;if(kind==='edge'){context.strokeRect(width*.22,height*.22,width*.56,height*.58);context.beginPath();context.moveTo(width*.22,height*.5);context.lineTo(width*.5,height*.22);context.lineTo(width*.78,height*.5);context.stroke()}else if(kind==='depth'){for(let i=0;i<7;i++){context.beginPath();context.ellipse(width/2,height*.62,i*28+18,i*13+8,0,0,Math.PI*2);context.stroke()}}else{context.fillRect(width*.35,height*.28,width*.3,height*.44);context.clearRect(width*.42,height*.38,width*.16,height*.22)}output('ga-control-strength-v',`${strength}%`);output('ga-control-structure',`${strength}%`);output('ga-control-freedom',`${100-strength}%`);output('ga-control-note',kind==='edge'?'Edge guidance preserves outlines while the model invents texture and appearance.':kind==='depth'?'Depth guidance preserves near/far geometry while allowing surface details to change.':'An inpaint mask restricts regeneration to the selected region while preserving its surroundings.')}
  segment('ga-control-kind',drawControl);input('ga-control-strength').addEventListener('input',drawControl);
  let audioSeed=2;function drawAudio(){const canvas=node('ga-audio-canvas') as HTMLCanvasElement,view=fit(canvas);if(!view)return;const{context,width,height}=view,mood=picked('ga-audio-mood'),length=Number(input('ga-audio-length').value),freq=mood==='calm'?2:mood==='bright'?6:3,amp=mood==='dark'?.72:.5;context.strokeStyle='#FB7185';context.lineWidth=2;context.beginPath();for(let x=0;x<width;x++){const t=x/width*Math.PI*2*freq,y=height/2+Math.sin(t+audioSeed)*height*.25*amp+Math.sin(t*2.7)*height*.08;x?context.lineTo(x,y):context.moveTo(x,y)}context.stroke();output('ga-audio-length-v',`${length} sec`);output('ga-audio-duration',`${length}s`)}segment('ga-audio-mood',drawAudio);input('ga-audio-length').addEventListener('input',drawAudio);node('ga-audio-generate').addEventListener('click',()=>{audioSeed=Math.random()*8;drawAudio()});
  function renderVideo(){const motion=Number(input('ga-video-motion').value),consistency=Number(input('ga-video-consistency').value),root=node('ga-storyboard');root.replaceChildren(...Array.from({length:8},(_,index)=>{const frame=document.createElement('div'),subject=document.createElement('i'),label=document.createElement('span'),drift=(100-consistency)/100;frame.className='ga-frame';subject.style.setProperty('--x',`${28+index*motion/12+Math.sin(index)*drift*18}%`);subject.style.setProperty('--y',`${52+Math.cos(index)*drift*14}%`);subject.style.setProperty('--scale',String(1+index*motion/1000));subject.style.setProperty('--opacity',String(.55+consistency/220));label.textContent=`f${index+1}`;frame.append(subject,label);return frame}));output('ga-video-motion-v',`${motion}%`);output('ga-video-consistency-v',`${consistency}%`);output('ga-video-motion-m',motion<30?'low':motion<70?'medium':'high');output('ga-video-flicker',consistency>80?'low':consistency>50?'medium':'high')}['ga-video-motion','ga-video-consistency'].forEach(name=>input(name).addEventListener('input',renderVideo));
  const redraw:Record<string,()=>void>={generative:drawDiff,schedule:drawSchedule,latent:renderLatent,guidance:renderGuidance,prompt:renderPrompt,control:drawControl,audio:drawAudio,video:renderVideo};document.addEventListener('generative:tab',event=>{const id=(event as CustomEvent<string>).detail;if(id!=='generative')stopDiff();requestAnimationFrame(()=>redraw[id]?.())});window.addEventListener('resize',()=>{const active=(document.querySelector('#tabs .tab.active') as HTMLElement)?.dataset.tab;if(active)redraw[active]?.()});
  drawDiff();drawSchedule();renderLatent();renderGuidance();renderPrompt();drawControl();drawAudio();renderVideo();
</script>
