---
import '../styles/atlas.css';

interface Props {
  title: string;
  pageId?: string;
}

const { title, pageId } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body data-page={pageId || undefined}>
    <slot />
    <slot name="scripts" />
  </body>
</html>
